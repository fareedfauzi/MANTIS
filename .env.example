# Copy to .env for local use. Do not commit real credentials.

# Telegram toolkit
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_STRING_SESSION=

# Optional breach / CTI providers
DATABREACH_WATCH_API_KEY=
LEAK_LOOKUP_API_KEY=
RANSOMWARE_LIVE_API_KEY=

# Optional deployment controls
MANTIS_ALLOWED_ORIGINS=http://127.0.0.1:9999,http://localhost:9999
MANTIS_ALLOW_ALL_CORS=false

# Hermes / agent bridge
MANTIS_AGENT_TOKEN=
MANTIS_AGENT_PERMISSIONS=read_only
MANTIS_AGENT_RATE_WINDOW_SECONDS=60
MANTIS_AGENT_RATE_MAX_CALLS=60
MANTIS_AGENT_AUDIT_PATH=backend/data/agent_audit.jsonl
# Local testing only. Do not enable for shared systems.
MANTIS_AGENT_DEV_ALLOW_NO_TOKEN=false
# Passive internet response, DNS, WHOIS, and certificate search.
NETLAS_API_KEY=
ZOOMEYE_API_KEY=
SILENT_PUSH_API_KEY=
DRIFTNET_API_TOKEN=
VALIDIN_API_KEY=
ETUGEN_API_KEY=
GREYNOISE_API_KEY=

# Local saved infrastructure-hunt scheduler.
MANTIS_INFRA_MONITOR_ENABLED=true
MANTIS_INFRA_MONITOR_INTERVAL_S=900
