---
import { Boxes, ExternalLink, ScanSearch, Sparkles } from '@lucide/astro';

type Status = 'Native' | 'Partial' | 'Not core';
type Project = {
  name: string;
  url: string;
  focus: string;
  ioc: Status;
  knowledge: Status;
  monitoring: Status;
  malware: Status;
  social: Status;
  reporting: Status;
};

const projects: Project[] = [
  { name: 'MANTIS', url: 'https://github.com/fareedfauzi/MANTIS', focus: 'Unified analyst workbench', ioc: 'Native', knowledge: 'Native', monitoring: 'Native', malware: 'Native', social: 'Native', reporting: 'Native' },
  { name: 'IntelOwl', url: 'https://github.com/intelowlproject/IntelOwl', focus: 'IOC and file enrichment', ioc: 'Native', knowledge: 'Partial', monitoring: 'Partial', malware: 'Native', social: 'Not core', reporting: 'Partial' },
  { name: 'OpenCTI', url: 'https://github.com/OpenCTI-Platform/opencti', focus: 'STIX knowledge graph', ioc: 'Partial', knowledge: 'Native', monitoring: 'Partial', malware: 'Not core', social: 'Partial', reporting: 'Partial' },
  { name: 'MISP', url: 'https://github.com/MISP/MISP', focus: 'Intelligence sharing', ioc: 'Native', knowledge: 'Native', monitoring: 'Native', malware: 'Partial', social: 'Partial', reporting: 'Partial' },
  { name: 'YETI', url: 'https://github.com/yeti-platform/yeti', focus: 'CTI and DFIR enrichment', ioc: 'Native', knowledge: 'Native', monitoring: 'Partial', malware: 'Partial', social: 'Not core', reporting: 'Not core' },
  { name: 'SpiderFoot', url: 'https://github.com/smicallef/spiderfoot', focus: 'OSINT and attack-surface mapping', ioc: 'Native', knowledge: 'Partial', monitoring: 'Partial', malware: 'Not core', social: 'Partial', reporting: 'Not core' },
  { name: 'OpenOSINT', url: 'https://github.com/OpenOSINT/OpenOSINT', focus: 'AI-assisted passive OSINT', ioc: 'Native', knowledge: 'Partial', monitoring: 'Not core', malware: 'Not core', social: 'Partial', reporting: 'Native' },
  { name: 'Watcher', url: 'https://github.com/thalesgroup-cert/Watcher', focus: 'AI-powered CTI monitoring', ioc: 'Partial', knowledge: 'Partial', monitoring: 'Native', malware: 'Not core', social: 'Not core', reporting: 'Native' },
];

const differentiators = [
  { icon: Boxes, title: 'One investigation surface', text: 'MANTIS combines IOC enrichment, threat knowledge, daily intelligence, ransomware, vulnerability, X, and Telegram monitoring in one local workspace.' },
  { icon: ScanSearch, title: 'Built-in analyst workbenches', text: 'YARA authoring and testing, sample similarity, and IDA or Ghidra-backed binary analysis are first-class workflows rather than external handoffs.' },
  { icon: Sparkles, title: 'Evidence-aware reporting', text: 'MANTIS AI works over collected evidence and supports daily briefs, investigation reports, and Binary Lab output in Markdown, HTML, PDF, and portable workspace bundles.' },
];
---

<section class="section comparison-section" id="comparison">
  <div class="container">
    <span class="section-label">Open-source landscape</span>
    <h2 class="section-title">How MANTIS Compares.</h2>
    <p class="section-copy">Each project solves a valuable part of the threat-intelligence workflow. MANTIS is differentiated by bringing collection, investigation, malware workbenches, and evidence-aware reporting together in a single analyst-focused environment.</p>

    <div class="legend" aria-label="Comparison legend">
      <span><i class="native"></i> Native capability</span>
      <span><i class="partial"></i> Partial, plugin, or narrower workflow</span>
      <span><i class="not-core"></i> Not a primary focus</span>
    </div>

    <div class="table-frame" tabindex="0" aria-label="Scrollable comparison of MANTIS and related open-source tools">
      <table>
        <thead>
          <tr>
            <th scope="col">Project</th>
            <th scope="col">Primary focus</th>
            <th scope="col">IOC &amp; OSINT enrichment</th>
            <th scope="col">CTI knowledge</th>
            <th scope="col">Continuous monitoring</th>
            <th scope="col">YARA &amp; malware analysis</th>
            <th scope="col">Social / Telegram</th>
            <th scope="col">AI &amp; reporting</th>
          </tr>
        </thead>
        <tbody>
          {projects.map((project, index) => (
            <tr class:list={{ featured: index === 0 }}>
              <th scope="row">
                <a href={project.url} target="_blank" rel="noreferrer">
                  {project.name}<ExternalLink size={13} aria-hidden="true" />
                </a>
                {index === 0 && <span class="current-label">This project</span>}
              </th>
              <td class="focus-cell">{project.focus}</td>
              {[project.ioc, project.knowledge, project.monitoring, project.malware, project.social, project.reporting].map((status) => (
                <td><span class:list={['status', status.toLowerCase().replace(' ', '-')] }>{status}</span></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="method-note">Comparison reflects capabilities documented by each project as of November 2026. “Partial” includes connector-based, plugin-based, or more narrowly scoped support; it is not a quality judgment.</p>

    <div class="difference-grid">
      {differentiators.map(({ icon: Icon, title, text }) => (
        <article>
          <span><Icon size={19} stroke-width={1.7} /></span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .comparison-section { background: #0c0c0c; }
  .legend { display: flex; flex-wrap: wrap; gap: .75rem 1.4rem; margin-top: 2rem; color: #858585; font: .68rem/1.5 var(--font-mono); }
  .legend span { display: inline-flex; align-items: center; gap: .45rem; }
  .legend i { width: 7px; height: 7px; border-radius: 50%; }
  .legend .native { background: var(--yellow); box-shadow: 0 0 0 3px rgba(255,229,0,.08); }
  .legend .partial { background: #888; }
  .legend .not-core { background: #343434; }
  .table-frame { margin-top: 1.2rem; overflow-x: auto; border: 1px solid var(--border); border-radius: 1rem; background: #101010; scrollbar-width: thin; }
  table { width: 100%; min-width: 1050px; border-collapse: collapse; font-size: .76rem; }
  th, td { padding: 1rem .85rem; text-align: left; border-right: 1px solid #242424; border-bottom: 1px solid #242424; vertical-align: middle; }
  th:last-child, td:last-child { border-right: 0; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  thead th { color: #8e8e8e; background: #141414; font: 600 .62rem/1.45 var(--font-mono); letter-spacing: .045em; text-transform: uppercase; }
  thead th:first-child, tbody th { position: sticky; left: 0; z-index: 2; }
  thead th:first-child { z-index: 3; }
  tbody th { min-width: 145px; background: #101010; }
  tbody th a { display: inline-flex; align-items: center; gap: .35rem; color: #e8e8e8; font-size: .82rem; }
  tbody th a:hover { color: var(--yellow); }
  .featured th, .featured td { background: rgba(255,229,0,.045); }
  .featured th { background: #1a190c; }
  .featured th a { color: var(--yellow); font-family: var(--font-brand); font-size: .68rem; }
  .current-label { display: block; width: max-content; margin-top: .4rem; padding: .24rem .38rem; color: #0a0a0a; background: var(--yellow); border-radius: .25rem; font: 700 .51rem/1 var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
  .focus-cell { min-width: 165px; color: #9a9a9a; line-height: 1.45; }
  .status { display: inline-flex; align-items: center; gap: .35rem; white-space: nowrap; font: 600 .61rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
  .status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #343434; }
  .status.native { color: #f3e76a; }
  .status.native::before { background: var(--yellow); box-shadow: 0 0 0 3px rgba(255,229,0,.07); }
  .status.partial { color: #a8a8a8; }
  .status.partial::before { background: #888; }
  .status.not-core { color: #575757; }
  .method-note { margin: .85rem 0 0; color: #666; font: .64rem/1.6 var(--font-mono); }
  .difference-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin-top: 3rem; }
  .difference-grid article { padding: 1.4rem; background: linear-gradient(180deg, #171714, #111); border: 1px solid #302f20; border-radius: .85rem; }
  .difference-grid article > span { display: grid; place-items: center; width: 40px; height: 40px; color: var(--yellow); background: rgba(255,229,0,.06); border: 1px solid rgba(255,229,0,.15); border-radius: .55rem; }
  .difference-grid h3 { margin: 2rem 0 .65rem; font-size: 1rem; }
  .difference-grid p { margin: 0; color: #888; font-size: .82rem; line-height: 1.7; }
  @media (max-width: 780px) { .difference-grid { grid-template-columns: 1fr; } }
</style>
