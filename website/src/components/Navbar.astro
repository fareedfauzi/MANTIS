---
import { GitBranch, Menu, X } from '@lucide/astro';
const github = 'https://github.com/fareedfauzi/MANTIS';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="nav-shell" data-nav>
  <div class="container nav-inner">
    <a class="brand" href="#top" aria-label="MANTIS home">
      <img class="brand-mark" src={`${base}logos/mantis-site-36.png`} srcset={`${base}logos/mantis-site-72.png 2x, ${base}logos/mantis-site-108.png 3x`} width="36" height="36" alt="" aria-hidden="true" />
      <span>MANTIS</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#features">Features</a>
      <a href="#comparison">Comparison</a>
      <a href="#workflow">Workflow</a>
      <a href="#screenshots">Screenshots</a>
      <a href="#quick-start">Documentation</a>
      <a class="github-link" href={github} target="_blank" rel="noreferrer"><GitBranch size={16} /> GitHub</a>
    </nav>
    <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav" data-menu-button>
      <Menu class="menu-open" size={22} />
      <X class="menu-close" size={22} />
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" data-mobile-nav>
    <a href="#features">Features</a>
    <a href="#comparison">Comparison</a>
    <a href="#workflow">Workflow</a>
    <a href="#screenshots">Screenshots</a>
    <a href="#quick-start">Documentation</a>
    <a href={github} target="_blank" rel="noreferrer">GitHub <GitBranch size={16} /></a>
  </nav>
</header>

<script>
  const nav = document.querySelector('[data-nav]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  const closeMenu = () => {
    button?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
  };
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>

<style>
  .nav-shell { position: sticky; top: 0; z-index: 50; height: 68px; border-bottom: 1px solid rgba(255,255,255,.07); background: rgba(9,9,9,.82); backdrop-filter: blur(18px); }
  .nav-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; font: 400 .83rem/1 var(--font-brand); letter-spacing: .02em; }
  .brand-mark { width: 36px; height: 36px; flex: none; }
  .desktop-nav { display: flex; align-items: center; gap: 1.75rem; color: #bcbcbc; font-size: .82rem; }
  .desktop-nav a { transition: color .2s ease; }
  .desktop-nav a:hover { color: #fff; }
  .github-link { display: inline-flex; align-items: center; gap: .5rem; padding: .62rem .78rem; color: #f5f5f5; background: #171717; border: 1px solid #303030; border-radius: .55rem; }
  .menu-button { display: none; width: 42px; height: 42px; align-items: center; justify-content: center; color: #fff; background: #151515; border: 1px solid #303030; border-radius: .55rem; }
  .menu-close { display: none; }
  .mobile-nav { display: none; }
  @media (max-width: 820px) {
    .desktop-nav { display: none; }
    .menu-button { display: inline-flex; }
    .is-open .menu-open { display: none; }
    .is-open .menu-close { display: block; }
    .is-open .mobile-nav { display: flex; }
    .mobile-nav { position: absolute; top: 67px; left: 0; right: 0; flex-direction: column; padding: 1rem 1.25rem 1.25rem; background: #0d0d0d; border-bottom: 1px solid var(--border); box-shadow: 0 20px 35px rgba(0,0,0,.35); }
    .mobile-nav a { display: flex; align-items: center; justify-content: space-between; min-height: 47px; padding: 0 .5rem; color: #d1d1d1; border-bottom: 1px solid #1d1d1d; }
  }
</style>
