---
import { ArrowDown, ArrowUpRight, GitBranch } from '@lucide/astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<section class="hero" id="top">
  <div class="grid-overlay"></div>
  <div class="hero-spot" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="eyebrow"><span class="eyebrow-dot"></span> Open-source threat intelligence workbench</div>
    <h1>From Indicators to <span class="gradient-text">Intelligence.</span></h1>
    <p>MANTIS brings threat knowledge, continuous intelligence monitoring, YARA workflows, malware analysis, and evidence-aware AI into a single workspace built for security researchers.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="https://github.com/fareedfauzi/MANTIS" target="_blank" rel="noreferrer"><GitBranch size={17} /> Explore on GitHub <ArrowUpRight size={15} /></a>
      <a class="btn btn-secondary" href="#features">Explore Features <ArrowDown size={15} /></a>
    </div>
    <div class="product-frame">
      <div class="frame-bar">
        <div class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>IOC Intelligence Search</span>
        <span class="status"><i></i> Local workspace</span>
      </div>
      <img src={`${base}images/ioc-search.png`} width="1920" height="945" alt="MANTIS IOC Intelligence Search interface with indicator types and intelligence source selectors" fetchpriority="high" />
    </div>
    <div class="hero-meta" aria-label="MANTIS product summary">
      <span><strong>Open source</strong> MIT licensed</span>
      <span><strong>Local host</strong> Your environment</span>
      <span><strong>Analyst tools</strong> Focused workbenches</span>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(5.2rem, 10vw, 9rem) 0 4rem; text-align: center; }
  .hero-spot { position: absolute; width: 700px; height: 500px; left: 50%; top: -220px; transform: translateX(-50%); background: radial-gradient(ellipse, rgba(255,229,0,.11), transparent 66%); filter: blur(10px); }
  .hero-inner { position: relative; }
  .eyebrow { display: inline-flex; align-items: center; gap: .6rem; padding: .52rem .75rem; color: #d6d6d6; background: rgba(22,22,22,.8); border: 1px solid #2b2b2b; border-radius: 999px; font: 600 .66rem/1 var(--font-mono); letter-spacing: .11em; text-transform: uppercase; }
  .eyebrow-dot { width: 6px; height: 6px; background: var(--yellow); border-radius: 50%; box-shadow: 0 0 0 4px rgba(255,229,0,.09); }
  h1 { max-width: 900px; margin: 1.8rem auto 0; font-size: clamp(3.4rem, 8.3vw, 7.1rem); line-height: .92; letter-spacing: -.07em; font-weight: 640; }
  .hero p { max-width: 730px; margin: 1.8rem auto 0; color: #aaa; font-size: clamp(1.02rem, 1.7vw, 1.25rem); line-height: 1.65; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }
  .product-frame { position: relative; margin: clamp(4.5rem, 8vw, 7rem) auto 0; overflow: hidden; background: #0c1018; border: 1px solid #333; border-radius: 1rem; box-shadow: 0 40px 100px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.025) inset; text-align: left; }
  .product-frame::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; box-shadow: inset 0 0 80px rgba(0,0,0,.16); }
  .frame-bar { height: 43px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 .85rem; color: #858585; background: #101010; border-bottom: 1px solid #2d2d2d; font: 500 .64rem/1 var(--font-mono); }
  .frame-dots { display: flex; gap: .35rem; }
  .frame-dots i { width: 7px; height: 7px; border-radius: 50%; background: #343434; }
  .status { justify-self: end; display: flex; align-items: center; gap: .4rem; }
  .status i { width: 6px; height: 6px; background: #6fbf73; border-radius: 50%; }
  .hero-meta { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.4rem 2.3rem; margin-top: 1.5rem; color: #666; font: .68rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: .05em; }
  .hero-meta strong { color: #a8a8a8; font-weight: 500; }
  @media (max-width: 640px) {
    .hero { padding-top: 4.5rem; }
    .eyebrow { font-size: .56rem; letter-spacing: .08em; }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .hero-actions .btn { width: 100%; }
    .frame-bar { grid-template-columns: 1fr auto; }
    .frame-bar > span:first-of-type { display: none; }
    .hero-meta { display: grid; grid-template-columns: 1fr; gap: .65rem; text-align: left; padding-left: .4rem; }
  }
</style>
