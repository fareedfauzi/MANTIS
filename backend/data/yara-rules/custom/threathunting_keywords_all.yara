        $string16_psexec_greyware_tool_keyword = /\.exe\s\-s\s\-i\spwsh/ nocase ascii wide
        // Description: PsExec is a legitimate Microsoft tool for remote administration. However. attackers can misuse it to execute malicious commands or software on other network machines. install persistent threats. and evade some security systems. 
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string17_psexec_greyware_tool_keyword = /\\PsExec\.exe/ nocase ascii wide
        // Description: PsExec is a legitimate Microsoft tool for remote administration. However. attackers can misuse it to execute malicious commands or software on other network machines. install persistent threats. and evade some security systems. 
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string18_psexec_greyware_tool_keyword = /\\SOFTWARE\\Sysinternals\\PsExec\\EulaAccepted/ nocase ascii wide
        // Description: PsExec is a legitimate Microsoft tool for remote administration. However. attackers can misuse it to execute malicious commands or software on other network machines. install persistent threats. and evade some security systems. 
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string19_psexec_greyware_tool_keyword = /\\Windows\\Prefetch\\PSEXEC/ nocase ascii wide
        // Description: .key file created and deleted on the target system
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string20_psexec_greyware_tool_keyword = /\\Windows\\PSEXEC\-.{0,1000}\.key/ nocase ascii wide
        // Description: .key file created and deleted on the target system
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string21_psexec_greyware_tool_keyword = /PSEXEC\-.{0,1000}\.key/ nocase ascii wide
        // Description: PsExec is a legitimate Microsoft tool for remote administration. However. attackers can misuse it to execute malicious commands or software on other network machines. install persistent threats. and evade some security systems. 
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string22_psexec_greyware_tool_keyword = /PsExec\.exe\s\/accepteula/ nocase ascii wide
        // Description: Adversaries may place the PsExec executable in the temp directory and execute it from there as part of their offensive activities. By doing so. they can leverage PsExec to execute commands or launch processes on remote systems. enabling Lateral Movement. privilege escalation. or the execution of malicious payloads.
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string23_psexec_greyware_tool_keyword = /PsExec\[1\]\.exe/ nocase ascii wide
        // Description: Adversaries may place the PsExec executable in the temp directory and execute it from there as part of their offensive activities. By doing so. they can leverage PsExec to execute commands or launch processes on remote systems. enabling Lateral Movement. privilege escalation. or the execution of malicious payloads.
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string24_psexec_greyware_tool_keyword = /PsExec64\.exe/ nocase ascii wide
        // Description: PsExec is a legitimate Microsoft tool for remote administration. However. attackers can misuse it to execute malicious commands or software on other network machines. install persistent threats. and evade some security systems. 
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string25_psexec_greyware_tool_keyword = "PSEXECSVC" nocase ascii wide
        // Description: prefetch - .key file created and deleted on the target system
        // Reference: https://learn.microsoft.com/fr-fr/sysinternals/downloads/psexec
        $string26_psexec_greyware_tool_keyword = /PSEXECSVC\.EXE\-.{0,1000}\.pf/ nocase ascii wide

    condition:
        any of them
}


rule rule_pslist_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'pslist' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "pslist"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: Microsoft sysinternal comandline tool to list running process abused by threat actors
        // Reference: https://learn.microsoft.com/pt-br/sysinternals/downloads/pslist
        $string1_pslist_greyware_tool_keyword = /\/pslist\.exe/ nocase ascii wide
        // Description: Microsoft sysinternal comandline tool to list running process abused by threat actors
        // Reference: https://learn.microsoft.com/pt-br/sysinternals/downloads/pslist
        $string2_pslist_greyware_tool_keyword = /\/pslist64\.exe/ nocase ascii wide
        // Description: Microsoft sysinternal comandline tool to list running process abused by threat actors
        // Reference: https://learn.microsoft.com/pt-br/sysinternals/downloads/pslist
        $string3_pslist_greyware_tool_keyword = /\\pslist\.exe/ nocase ascii wide
        // Description: Microsoft sysinternal comandline tool to list running process abused by threat actors
        // Reference: https://learn.microsoft.com/pt-br/sysinternals/downloads/pslist
        $string4_pslist_greyware_tool_keyword = /\\pslist64\.exe/ nocase ascii wide
        // Description: Microsoft sysinternal comandline tool to list running process abused by threat actors
        // Reference: https://learn.microsoft.com/pt-br/sysinternals/downloads/pslist
        $string5_pslist_greyware_tool_keyword = ">Sysinternals PsList<" nocase ascii wide
        // Description: Microsoft sysinternal comandline tool to list running process abused by threat actors
        // Reference: https://learn.microsoft.com/pt-br/sysinternals/downloads/pslist
        $string6_pslist_greyware_tool_keyword = "d3247f03dcd7b9335344ebba76a0b92370f32f1cb0e480c734da52db2bd8df60" nocase ascii wide

    condition:
        any of them
}


rule rule_psloggedon_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'psloggedon' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "psloggedon"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: PsLoggedOn is an applet that displays both the locally logged on users and users logged on via resources for either the local computer. or a remote one
        // Reference: https://learn.microsoft.com/en-us/sysinternals/downloads/psloggedon
        $string1_psloggedon_greyware_tool_keyword = /PsLoggedon\.exe/ nocase ascii wide
        // Description: PsLoggedOn is an applet that displays both the locally logged on users and users logged on via resources for either the local computer. or a remote one
        // Reference: https://learn.microsoft.com/en-us/sysinternals/downloads/psloggedon
        $string2_psloggedon_greyware_tool_keyword = /PsLoggedon64\.exe/ nocase ascii wide

    condition:
        any of them
}


