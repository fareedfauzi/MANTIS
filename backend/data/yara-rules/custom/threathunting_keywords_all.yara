        // Reference: https://github.com/BernKing/ChromeStealer
        $string2_ChromeStealer_offensive_tool_keyword = /\\ChromeStealer\.cpp/ nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string3_ChromeStealer_offensive_tool_keyword = /\\ChromeStealer\.sln/ nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string4_ChromeStealer_offensive_tool_keyword = /\\ChromeStealer\-main/ nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string5_ChromeStealer_offensive_tool_keyword = "1aebc75f4a66ba1711c288235dad6ac01c59e8801e8a1c2151cbb7dfd4c2c098" nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string6_ChromeStealer_offensive_tool_keyword = "64d2173109cdc67df6e9e15a275b4ed0b5488397c290b996ffd3ed445f361b79" nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string7_ChromeStealer_offensive_tool_keyword = "BernKing/ChromeStealer" nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string8_ChromeStealer_offensive_tool_keyword = "c7c8b6fb-4e59-494e-aeeb-40cf342a7e88" nocase ascii wide
        // Description: extract and decrypt stored passwords from Google Chrome
        // Reference: https://github.com/BernKing/ChromeStealer
        $string9_ChromeStealer_offensive_tool_keyword = /ChromeStealer\.exe/ nocase ascii wide

    condition:
        any of them
}


rule rule_chunk_Proxy_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'chunk-Proxy' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "chunk-Proxy"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string1_chunk_Proxy_offensive_tool_keyword = /\/Chunk\-Proxy\.git/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string2_chunk_Proxy_offensive_tool_keyword = /\/ChunkProxyHandler\.class/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string3_chunk_Proxy_offensive_tool_keyword = /\/MiTM\.java/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string4_chunk_Proxy_offensive_tool_keyword = /\\MiTM\.java/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string5_chunk_Proxy_offensive_tool_keyword = "149c0f553685f985a2eb714d9dcc54541423e57b4aecea5f2bdb747dfb9cc06d" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string6_chunk_Proxy_offensive_tool_keyword = "3a3d9e54afc72d136525dc4e70bb97d5ec2f7c1d3fe2e3afe1d9a430f68b78af" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string7_chunk_Proxy_offensive_tool_keyword = "84fc3746ff1c1b3bd069bc4f64bf5416b9151d980088cd902799d7997f5b3882" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string8_chunk_Proxy_offensive_tool_keyword = "ae094ee177fac926d832755352a3d0fff4804e513cefc430d5987936ff493b92" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string9_chunk_Proxy_offensive_tool_keyword = "b75be6d2ff15abf81ac056295c5a397177de01718d05bba61e5abc025d9977f9" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string10_chunk_Proxy_offensive_tool_keyword = "BeichenDream/Chunk-Proxy" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string11_chunk_Proxy_offensive_tool_keyword = "cc83886b15c006d0b3650f3327bf0264df635e6d11a3dd46680c8314bc6bd4f5" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string12_chunk_Proxy_offensive_tool_keyword = /chunk\-Proxy\.jar/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string13_chunk_Proxy_offensive_tool_keyword = "f273248a26cf21cef5c0f1288f90b5aef915b477c81eb62949ab4e519b4b604b" nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string14_chunk_Proxy_offensive_tool_keyword = /http\:\/\/localhost\:42969\/easy\.aspx/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string15_chunk_Proxy_offensive_tool_keyword = /java\s\-jar\schunk\-Proxy\.jar\sjava\s1088\shttp\:\/\/10\.10\.10\.1\:8080\/proxy\.jsp/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string16_chunk_Proxy_offensive_tool_keyword = /java\-socks\-proxy\-server\.jar/ nocase ascii wide
        // Description: A backdoor installed on a web server that allows for the execution of commands and facilitates persistent access.
        // Reference: https://github.com/BeichenDream/Chunk-Proxy
        $string17_chunk_Proxy_offensive_tool_keyword = /socket\s\=\snew\sSystem\.Net\.Sockets\.Socket\(System\.Net\.Sockets\.AddressFamily\.InterNetwork\,\sSystem\.Net\.Sockets\.SocketType\.Stream\,\sSystem\.Net\.Sockets\.ProtocolType\.Tcp\)/ nocase ascii wide

    condition:
        any of them
}


rule rule_CIMplant_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'CIMplant' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "CIMplant"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string1_CIMplant_offensive_tool_keyword = " -c active_users -u " nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string2_CIMplant_offensive_tool_keyword = " -c command_exec --execute tasklist" nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string3_CIMplant_offensive_tool_keyword = " -c command_exec --execute whoami" nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string4_CIMplant_offensive_tool_keyword = " -c edr_query " nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string5_CIMplant_offensive_tool_keyword = /\s\-c\slogon_events\s.{0,1000}\s\-u\s/ nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string6_CIMplant_offensive_tool_keyword = /\s\-c\sls\s\-\-directory\s.{0,1000}\s\-u\s.{0,1000}\s\-p\s/ nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string7_CIMplant_offensive_tool_keyword = " -c process_kill --process " nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string8_CIMplant_offensive_tool_keyword = " -c service_mod --execute create -s " nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string9_CIMplant_offensive_tool_keyword = /\s\-c\supload\s\-\-fileto\s.{0,1000}\s\-\-file\s/ nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
        // Reference: https://github.com/RedSiege/CIMplant
        $string10_CIMplant_offensive_tool_keyword = /\s\-c\svacant_system\s.{0,1000}\s\-u\s/ nocase ascii wide
        // Description: C# port of WMImplant which uses either CIM or WMI to query remote systems
