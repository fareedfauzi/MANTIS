rule rule_targetedKerberoast_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'targetedKerberoast' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "targetedKerberoast"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Kerberoast with ACL abuse capabilities
        // Reference: https://github.com/ShutdownRepo/targetedKerberoast
        $string1_targetedKerberoast_offensive_tool_keyword = "/targetedKerberoast" nocase ascii wide
        // Description: Kerberoast with ACL abuse capabilities
        // Reference: https://github.com/ShutdownRepo/targetedKerberoast
        $string2_targetedKerberoast_offensive_tool_keyword = /kerberoastables\.txt/ nocase ascii wide
        // Description: Kerberoast with ACL abuse capabilities
        // Reference: https://github.com/ShutdownRepo/targetedKerberoast
        $string3_targetedKerberoast_offensive_tool_keyword = /targetedKerberoast\.git/ nocase ascii wide
        // Description: Kerberoast with ACL abuse capabilities
        // Reference: https://github.com/ShutdownRepo/targetedKerberoast
        $string4_targetedKerberoast_offensive_tool_keyword = /targetedKerberoast\.py/ nocase ascii wide
        // Description: Kerberoast with ACL abuse capabilities
        // Reference: https://github.com/ShutdownRepo/targetedKerberoast
        $string5_targetedKerberoast_offensive_tool_keyword = "targetedKerberoast-main" nocase ascii wide

    condition:
        any of them
}


rule rule_TartarusGate_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'TartarusGate' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "TartarusGate"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: TartarusGate Bypassing EDRs
        // Reference: https://github.com/trickster0/TartarusGate
        $string1_TartarusGate_offensive_tool_keyword = /\/TartarusGate\.git/ nocase ascii wide
        // Description: TartarusGate Bypassing EDRs
        // Reference: https://github.com/trickster0/TartarusGate
        $string2_TartarusGate_offensive_tool_keyword = "DC6187CB-D5DF-4973-84A2-F92AAE90CDA9" nocase ascii wide
        // Description: TartarusGate Bypassing EDRs
        // Reference: https://github.com/trickster0/TartarusGate
        $string3_TartarusGate_offensive_tool_keyword = "TartarusGate-master" nocase ascii wide
        // Description: TartarusGate Bypassing EDRs
        // Reference: https://github.com/trickster0/TartarusGate
        $string4_TartarusGate_offensive_tool_keyword = "trickster0/TartarusGate" nocase ascii wide

    condition:
        any of them
}


rule rule_Tchopper_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Tchopper' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Tchopper"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string1_Tchopper_offensive_tool_keyword = /\stmp_payload\.txt/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string2_Tchopper_offensive_tool_keyword = "#1 - Smuggling binary via Service DisplayName" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string3_Tchopper_offensive_tool_keyword = "#2 - Smuggling binary via WMI" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string4_Tchopper_offensive_tool_keyword = /\/TChopper\.git/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string5_Tchopper_offensive_tool_keyword = /\[\+\]\stask\shas\sbeen\screated\ssuccessfully\s\s\.\.\!/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string6_Tchopper_offensive_tool_keyword = /\[\-\>\]\ssending\spayload\.\.as\schuncks/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string7_Tchopper_offensive_tool_keyword = /\\Public\\chop\.enc/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string8_Tchopper_offensive_tool_keyword = /\\TChopper\\chopper\./ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string9_Tchopper_offensive_tool_keyword = /\\Tchopper\-main\.zip/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string10_Tchopper_offensive_tool_keyword = /\\tmp_payload\.txt/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string11_Tchopper_offensive_tool_keyword = "chop target username password domain filename chd wmi" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string12_Tchopper_offensive_tool_keyword = /chopper\.exe\s\-m/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string13_Tchopper_offensive_tool_keyword = /chopper\.exe\s\-s/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string14_Tchopper_offensive_tool_keyword = /chopper\.exe\s\-w/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string15_Tchopper_offensive_tool_keyword = /cmd\.exe\s\/c\spowershell\s\-command\s\\"Get\-Service\s.{0,1000}chopper/ nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string16_Tchopper_offensive_tool_keyword = "Data Name=\"ServiceName\">chopper</Data>" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string17_Tchopper_offensive_tool_keyword = "Data Name=\"ServiceName\">final_seg</Data>" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string18_Tchopper_offensive_tool_keyword = "Data Name=\"ServiceName\">let me in</Data>" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string19_Tchopper_offensive_tool_keyword = "lawrenceamer/Tchopper" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string20_Tchopper_offensive_tool_keyword = "'svc_smuggling'" nocase ascii wide
        // Description: conduct Lateral Movement attack by leveraging unfiltered services display name to smuggle binaries as chunks into the target machine
        // Reference: https://github.com/lawrenceamer/Tchopper
        $string21_Tchopper_offensive_tool_keyword = "Technique #1 - Chop Chop - Create/delete" nocase ascii wide

    condition:
        any of them
}


rule rule_tcpreplay_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'tcpreplay' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "tcpreplay"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Tcpreplay is a suite of free Open Source utilities for editing and replaying previously captured network traffic. Originally designed to replay malicious traffic patterns to Intrusion Detection/Prevention Systems. it has seen many evolutions including capabilities to replay to web servers.
        // Reference: https://tcpreplay.appneta.com/
        $string1_tcpreplay_offensive_tool_keyword = "tcpreplay" nocase ascii wide

    condition:
        any of them
}


rule rule_TeamFiltration_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'TeamFiltration' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "TeamFiltration"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string1_TeamFiltration_offensive_tool_keyword = /\s\-\-config\s.{0,1000}\.json\s\-\-debug\s\-\-exfil\s\-\-onedrive/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string2_TeamFiltration_offensive_tool_keyword = /\s\-\-config\s.{0,1000}\.json\s\-\-enum\s\-\-validate\-msol\s\-\-usernames\s/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string3_TeamFiltration_offensive_tool_keyword = /\s\-\-config\s.{0,1000}\.json\s\-\-enum\s\-\-validate\-teams/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string4_TeamFiltration_offensive_tool_keyword = /\s\-\-config\s.{0,1000}\.json\s\-\-exfil\s\-\-aad/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string5_TeamFiltration_offensive_tool_keyword = " --debug --exfil --onedrive" nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string6_TeamFiltration_offensive_tool_keyword = " --enum --validate-msol " nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string7_TeamFiltration_offensive_tool_keyword = " --enum --validate-teams" nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string8_TeamFiltration_offensive_tool_keyword = /\s\-\-exfil\s\-\-cookie\-dump\s\s.{0,1000}\s\-\-all/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string9_TeamFiltration_offensive_tool_keyword = " --exfil --cookie-dump " nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string10_TeamFiltration_offensive_tool_keyword = " --exfil --teams --owa --owa-limit" nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string11_TeamFiltration_offensive_tool_keyword = " --exfil --teams --owa" nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string12_TeamFiltration_offensive_tool_keyword = /\s\-\-exfil\s\-\-tokens\s.{0,1000}\s\-\-onedrive\s\-\-owa/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string13_TeamFiltration_offensive_tool_keyword = /\s\-\-exfil\s\-\-tokens\s.{0,1000}\s\-\-onedrive/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string14_TeamFiltration_offensive_tool_keyword = /\sloginAAD\.ps1/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string15_TeamFiltration_offensive_tool_keyword = /\s\-\-outpath\s.{0,1000}\s\-\-config\s.{0,1000}\.json\s\-\-backdoor/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string16_TeamFiltration_offensive_tool_keyword = /\s\-\-outpath\s.{0,1000}\.json\s\-\-backdoor/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string17_TeamFiltration_offensive_tool_keyword = /\s\-\-shuffle\-users.{0,1000}\s\-\-spray/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string18_TeamFiltration_offensive_tool_keyword = /\s\-\-spray\s.{0,1000}\-\-shuffle\-users/ nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string19_TeamFiltration_offensive_tool_keyword = " --spray --passwords " nocase ascii wide
        // Description: TeamFiltration is a cross-platform framework for enumerating, spraying, exfiltrating, and backdooring O365 AAD accounts
        // Reference: https://github.com/Flangvik/TeamFiltration
        $string20_TeamFiltration_offensive_tool_keyword = " --spray --push-locked --months-only --exclude " nocase ascii wide
