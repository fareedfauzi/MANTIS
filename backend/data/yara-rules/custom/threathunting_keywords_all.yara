rule rule_PPLSystem_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PPLSystem' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PPLSystem"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string1_PPLSystem_offensive_tool_keyword = /\.exe\s\-\-dll\s.{0,1000}\s\-\-dump\s.{0,1000}\s\-\-pid\s/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string2_PPLSystem_offensive_tool_keyword = /\/pplsystem\.exe/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string3_PPLSystem_offensive_tool_keyword = /\/PPLSystem\.git/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string4_PPLSystem_offensive_tool_keyword = /\[\+\]\sRemote\sCOM\ssecret\s\:\s/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string5_PPLSystem_offensive_tool_keyword = /\\pplsystem\.exe/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string6_PPLSystem_offensive_tool_keyword = /\\PPLSystem\-main/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string7_PPLSystem_offensive_tool_keyword = "531870bd9f59ac799dfa6573472db1966cd3a9f8ece84d2f2e409e4384770b4a" nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string8_PPLSystem_offensive_tool_keyword = /Live\sDump\sCapture\sDump\sData\sAPI\sended\.\sNT\sStatus\:\sSTATUS_SUCCESS\./ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string9_PPLSystem_offensive_tool_keyword = /pplsystem\.exe\s/ nocase ascii wide
        // Description: creates a livedump of the machine through NtDebugSystemControl to extract the COM secret and context, to then inject inside this process.
        // Reference: https://github.com/Slowerzs/PPLSystem
        $string10_PPLSystem_offensive_tool_keyword = "Slowerzs/PPLSystem" nocase ascii wide

    condition:
        any of them
}


rule rule_precompiled_binaries_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'precompiled-binaries' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "precompiled-binaries"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string1_precompiled_binaries_offensive_tool_keyword = " --Action NewSecurityFiltering --GPOName " nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string2_precompiled_binaries_offensive_tool_keyword = " --Action RemoveSecurityFiltering --GPOName " nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string3_precompiled_binaries_offensive_tool_keyword = /\sasktgt\s\/user\:\{0\}\s\/certificate\:\{1\}\s\/password\:\\"\{2\}\\"\s/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string4_precompiled_binaries_offensive_tool_keyword = " Found a PwDatabase! " nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string5_precompiled_binaries_offensive_tool_keyword = /\sInveigh\.ps1/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string6_precompiled_binaries_offensive_tool_keyword = " is a C# tool for taking over Active Directory user and computer accounts by manipulating their " nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string7_precompiled_binaries_offensive_tool_keyword = /\sLAPSToolkit\.ps1/ nocase ascii wide
