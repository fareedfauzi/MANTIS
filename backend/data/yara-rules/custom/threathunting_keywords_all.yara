rule rule_Drupwn_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Drupwn' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
