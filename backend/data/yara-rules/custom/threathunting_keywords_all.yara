rule rule_adcsync_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'adcsync' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "adcsync"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string1_adcsync_offensive_tool_keyword = /\sadcsync\.py/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string2_adcsync_offensive_tool_keyword = /\/adcsync\.git/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string3_adcsync_offensive_tool_keyword = /\/adcsync\.py/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string4_adcsync_offensive_tool_keyword = /\\adcsync\.py/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string5_adcsync_offensive_tool_keyword = /adcsync\.py\s\-/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string6_adcsync_offensive_tool_keyword = /Certipy\snot\sfound\.\sPlease\sinstall\sCertipy\sbefore\srunning\sADCSync/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string7_adcsync_offensive_tool_keyword = /certipy\sreq\s\-u\s.{0,1000}\s\-p\s.{0,1000}\s\-target\-ip\s.{0,1000}\s\-dc\-ip\s.{0,1000}\s\-ca\s/ nocase ascii wide
        // Description: Use ESC1 to perform a makeshift DCSync and dump hashes
        // Reference: https://github.com/JPG0mez/ADCSync
        $string8_adcsync_offensive_tool_keyword = "JPG0mez/ADCSync" nocase ascii wide

    condition:
        any of them
}


rule rule_adeleg_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'adeleg' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "adeleg"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string1_adeleg_offensive_tool_keyword = /\/ADeleg\.exe/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string2_adeleg_offensive_tool_keyword = /\/adeleg\.git/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string3_adeleg_offensive_tool_keyword = /\/adeleg\.pdb/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string4_adeleg_offensive_tool_keyword = /\\ADeleg\.exe/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string5_adeleg_offensive_tool_keyword = /\\adeleg\.pdb/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string6_adeleg_offensive_tool_keyword = /\\adeleg\\adeleg\\/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string7_adeleg_offensive_tool_keyword = /\\adeleg\\winldap\\/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string8_adeleg_offensive_tool_keyword = /\\adeleg\-main/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string9_adeleg_offensive_tool_keyword = /ADeleg\.exe\s\-/ nocase ascii wide
        // Description: an Active Directory delegation management tool. It allows you to make a detailed inventory of delegations set up so far in a forest
        // Reference: https://github.com/mtth-bfft/adeleg
        $string10_adeleg_offensive_tool_keyword = "mtth-bfft/adeleg" nocase ascii wide

    condition:
        any of them
}


rule rule_Adeleginator_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Adeleginator' taken from the ThreatHunting-Keywords github project"
