        // Reference: https://github.com/x-cod3r/Remote-administration-tools-archive
        $string835_Malware_RAT_collection_offensive_tool_keyword = /Vsaver\-Rat\sv\.0\.1\.exe/ nocase ascii wide
        // Description: from Malware RAT samples
        // Reference: https://github.com/x-cod3r/Remote-administration-tools-archive
        $string836_Malware_RAT_collection_offensive_tool_keyword = /Webremote\sTorCT\sClient\.exe/ nocase ascii wide
        // Description: from Malware RAT samples
        // Reference: https://github.com/x-cod3r/Remote-administration-tools-archive
        $string837_Malware_RAT_collection_offensive_tool_keyword = /www\.bad\-rat\.de\.vu/ nocase ascii wide
        // Description: from Malware RAT samples
