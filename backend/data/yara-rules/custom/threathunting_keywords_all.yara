        // Reference: https://github.com/DNSCrypt/dnscrypt-proxy
        $string44_dnscrypt_offensive_tool_keyword = /dnscrypt\-proxy\-win64\-.{0,1000}\.zip/ nocase ascii wide
        // Description: A flexible DNS proxy with support for modern encrypted DNS protocols such as DNSCrypt v2 - DNS-over-HTTPS - Anonymized DNSCrypt and ODoH (Oblivious DoH).
        // Reference: https://github.com/DNSCrypt/dnscrypt-proxy
        $string45_dnscrypt_offensive_tool_keyword = "dnsproxy start scripts" nocase ascii wide
        // Description: A flexible DNS proxy with support for modern encrypted DNS protocols such as DNSCrypt v2 - DNS-over-HTTPS - Anonymized DNSCrypt and ODoH (Oblivious DoH).
        // Reference: https://github.com/DNSCrypt/dnscrypt-proxy
        $string46_dnscrypt_offensive_tool_keyword = /https\:\/\/127\.0\.0\.1\/dns\-query/ nocase ascii wide
        // Description: A flexible DNS proxy with support for modern encrypted DNS protocols such as DNSCrypt v2 - DNS-over-HTTPS - Anonymized DNSCrypt and ODoH (Oblivious DoH).
        // Reference: https://github.com/DNSCrypt/dnscrypt-proxy
        $string47_dnscrypt_offensive_tool_keyword = "Thank you for using DNSCrypt-Proxy!" nocase ascii wide
        // Description: A flexible DNS proxy with support for modern encrypted DNS protocols such as DNSCrypt v2 - DNS-over-HTTPS - Anonymized DNSCrypt and ODoH (Oblivious DoH).
        // Reference: https://github.com/DNSCrypt/dnscrypt-proxy
        $string48_dnscrypt_offensive_tool_keyword = "ubuntu:dnscrypt-msi" nocase ascii wide

    condition:
        any of them
}


rule rule_dnsdumpster_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnsdumpster' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnsdumpster"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: dns recon & research - find & lookup dns records
        // Reference: https://dnsdumpster.com/
        $string1_dnsdumpster_offensive_tool_keyword = /https\:\/\/dnsdumpster\.com\// nocase ascii wide

    condition:
        any of them
}


rule rule_dnsenum_offensive_tool_keyword
{
    meta:
