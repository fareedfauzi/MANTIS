rule rule_Nightmangle_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Nightmangle' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Nightmangle"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string1_Nightmangle_offensive_tool_keyword = /\/imperun\s.{0,1000}\s.{0,1000}cmd\.exe\s\/c\swhoami/ nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string2_Nightmangle_offensive_tool_keyword = /\/Nightmangle\.git/ nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string3_Nightmangle_offensive_tool_keyword = /\[\+\]\sBof\sreplay\:/ nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string4_Nightmangle_offensive_tool_keyword = /\[\+\]\sSeImpersonatePrivilege\senabled/ nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string5_Nightmangle_offensive_tool_keyword = "1N73LL1G3NC3x/Nightmangle" nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string6_Nightmangle_offensive_tool_keyword = "BeaconInjectProcess" nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string7_Nightmangle_offensive_tool_keyword = "BeaconInjectTemporaryProcess" nocase ascii wide
        // Description: ightmangle is post-exploitation Telegram Command and Control (C2/C&C) Agent
        // Reference: https://github.com/1N73LL1G3NC3x/Nightmangle
        $string8_Nightmangle_offensive_tool_keyword = "Nightmangle-master" nocase ascii wide

    condition:
        any of them
}


rule rule_nikto_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'nikto' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "nikto"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string1_nikto_offensive_tool_keyword = " install nikto"
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string2_nikto_offensive_tool_keyword = /\snikto\.pl\s/
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string3_nikto_offensive_tool_keyword = /\/nikto\.git/
        // Description: Nikto web scanner tool
        // Reference: https://github.com/sullo/nikto
        $string4_nikto_offensive_tool_keyword = /\/nikto\.pl/
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string5_nikto_offensive_tool_keyword = /\/nikto\.pl/
        // Description: Nikto web scanner tool
        // Reference: https://github.com/sullo/nikto
        $string6_nikto_offensive_tool_keyword = "/sullo/nikto"
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string7_nikto_offensive_tool_keyword = "nikto -C all "
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string8_nikto_offensive_tool_keyword = "nikto/program"
        // Description: Nikto web scanner tool
        // Reference: https://github.com/sullo/nikto
        $string9_nikto_offensive_tool_keyword = /perl\snikto\.pl\s\-h/
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string10_nikto_offensive_tool_keyword = /program\/replay\.pl/
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string11_nikto_offensive_tool_keyword = "sullo/nikto"
        // Description: Nikto web server scanner
        // Reference: https://github.com/sullo/nikto
        $string12_nikto_offensive_tool_keyword = "nikto -"

    condition:
        any of them
}


rule rule_NimBlackout_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'NimBlackout' taken from the ThreatHunting-Keywords github project"
