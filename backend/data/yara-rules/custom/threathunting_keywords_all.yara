rule rule_obfy_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'obfy' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "obfy"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A tiny C++ obfuscation framework
        // Reference: https://github.com/fritzone/obfy
        $string1_obfy_offensive_tool_keyword = "/fritzone/obfy" nocase ascii wide
        // Description: A tiny C++ obfuscation framework
        // Reference: https://github.com/fritzone/obfy
        $string2_obfy_offensive_tool_keyword = /\\obfy\-1\.0\.zip/ nocase ascii wide

    condition:
        any of them
}


rule rule_octopus_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'octopus' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "octopus"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string1_octopus_offensive_tool_keyword = " deploy_cobalt_beacon" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string2_octopus_offensive_tool_keyword = /\soctopus\.py/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string3_octopus_offensive_tool_keyword = /\.\/.{0,1000}octopus\.py/
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string4_octopus_offensive_tool_keyword = /\/agent\.ps1\.oct/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string5_octopus_offensive_tool_keyword = /\/octopus\.asm/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string6_octopus_offensive_tool_keyword = /\/Octopus\.git/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string7_octopus_offensive_tool_keyword = /\/octopusx64\.asm/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string8_octopus_offensive_tool_keyword = /\/weblistener\.py/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string9_octopus_offensive_tool_keyword = /ASBBypass\.ps1/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string10_octopus_offensive_tool_keyword = "generate_hta operation1" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string11_octopus_offensive_tool_keyword = "generate_powershell operation1" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string12_octopus_offensive_tool_keyword = "generate_spoofed_args_exe" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string13_octopus_offensive_tool_keyword = /generate_unmanaged_exe\soperation1\s.{0,1000}\.exe/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string14_octopus_offensive_tool_keyword = "generate_x64_shellcode" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string15_octopus_offensive_tool_keyword = "generate_x86_shellcode" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string16_octopus_offensive_tool_keyword = /ILBypass\.ps1/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string17_octopus_offensive_tool_keyword = /listen_http\s0\.0\.0\.0\s8080\s.{0,1000}\.php\soperation1/ nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string18_octopus_offensive_tool_keyword = "mhaskar/Octopus" nocase ascii wide
        // Description: Octopus is an open source. pre-operation C2 server based on python which can control an Octopus powershell agent through HTTP/S.
        // Reference: https://github.com/mhaskar/Octopus
        $string19_octopus_offensive_tool_keyword = /octopus\.py\s/ nocase ascii wide

    condition:
        any of them
}


rule rule_Offensive_Netsh_Helper_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Offensive-Netsh-Helper' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Offensive-Netsh-Helper"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string1_Offensive_Netsh_Helper_offensive_tool_keyword = /\/Offensive\-Netsh\-Helper\.git/ nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string2_Offensive_Netsh_Helper_offensive_tool_keyword = /\\netshlep\.cpp/ nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string3_Offensive_Netsh_Helper_offensive_tool_keyword = /\\Offensive\-Netsh\-Helper\\/ nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string4_Offensive_Netsh_Helper_offensive_tool_keyword = /\\Offensive\-Netsh\-Helper\-master/ nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string5_Offensive_Netsh_Helper_offensive_tool_keyword = "486d59732d2c346aa2cbaffff0d290b0e5fc0a967e0878240fd29df65525dfc8" nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string6_Offensive_Netsh_Helper_offensive_tool_keyword = "cwB0AGEAcgB0ACAAYwBhAGwAYwA=" nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string7_Offensive_Netsh_Helper_offensive_tool_keyword = /netsh\sadd\shelper\snetshBad\.DLL/ nocase ascii wide
        // Description: Maintain Windows Persistence with an evil Netshell Helper DLL
        // Reference: https://github.com/rtcrowley/Offensive-Netsh-Helper
        $string8_Offensive_Netsh_Helper_offensive_tool_keyword = "rtcrowley/Offensive-Netsh-Helper" nocase ascii wide

    condition:
        any of them
}


rule rule_Offensive_Payloads_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Offensive-Payloads' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Offensive-Payloads"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string1_Offensive_Payloads_offensive_tool_keyword = "Cross-Site-Scripting-XSS-Payloads" nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string2_Offensive_Payloads_offensive_tool_keyword = /Directory\-Traversal\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string3_Offensive_Payloads_offensive_tool_keyword = /File\-Extensions\-Wordlist\.txt/ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string4_Offensive_Payloads_offensive_tool_keyword = /Html\-Injection\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string5_Offensive_Payloads_offensive_tool_keyword = /Html\-Injection\-Read\-File\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string6_Offensive_Payloads_offensive_tool_keyword = /OS\-Command\-Injection\-Unix\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string7_Offensive_Payloads_offensive_tool_keyword = /OS\-Command\-Injection\-Windows\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string8_Offensive_Payloads_offensive_tool_keyword = /PHP\-Code\-injection\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string9_Offensive_Payloads_offensive_tool_keyword = /PHP\-Code\-Injections\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string10_Offensive_Payloads_offensive_tool_keyword = /Server\-Side\-Request\-Forgery\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string11_Offensive_Payloads_offensive_tool_keyword = /SQL\-Injection\-Auth\-Bypass\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string12_Offensive_Payloads_offensive_tool_keyword = /SQL\-Injection\-Payloads\./ nocase ascii wide
        // Description: List of payloads and wordlists that are specifically crafted to identify and exploit vulnerabilities in target web applications.
        // Reference: https://github.com/InfoSecWarrior/Offensive-Payloads/
        $string13_Offensive_Payloads_offensive_tool_keyword = /XML\-External\-Entity\-\(XXE\)\-Payloads/ nocase ascii wide

    condition:
