rule rule_SharpHose_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SharpHose' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SharpHose"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string1_SharpHose_offensive_tool_keyword = " --action SPRAY_USERS " nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string2_SharpHose_offensive_tool_keyword = /\sSharpHose\.exe/ nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string3_SharpHose_offensive_tool_keyword = " --spraypassword " nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string4_SharpHose_offensive_tool_keyword = /\/SharpHose\.exe/ nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string5_SharpHose_offensive_tool_keyword = /\\SharpHose\.exe/ nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string6_SharpHose_offensive_tool_keyword = /\\SharpHose\\Program\.cs/ nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string7_SharpHose_offensive_tool_keyword = "29d30b556932d0657f14a0b290ec79d23f88d8454ca27151c8348ab7e4be9657" nocase ascii wide
        // Description: Asynchronous Password Spraying Tool in C# for Windows Environments
        // Reference: https://github.com/ustayready/SharpHose
        $string8_SharpHose_offensive_tool_keyword = "51C6E016-1428-441D-82E9-BB0EB599BBC8" nocase ascii wide

    condition:
        any of them
}


rule rule_sharphound_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'sharphound' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "sharphound"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string1_sharphound_offensive_tool_keyword = /\s\-c\sall\s\-d\s.{0,1000}\s\-\-domaincontroller\s/ nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string2_sharphound_offensive_tool_keyword = " --collectallproperties" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string3_sharphound_offensive_tool_keyword = /\s\-\-CollectionMethod\sAll\s.{0,1000}ldap/ nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string4_sharphound_offensive_tool_keyword = /\s\-\-CollectionMethod\sAll\s.{0,1000}\-\-ZipFileName\s.{0,1000}\.zip/ nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string5_sharphound_offensive_tool_keyword = " --collectionmethods ACL" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string6_sharphound_offensive_tool_keyword = " --collectionmethods ComputerOnly" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string7_sharphound_offensive_tool_keyword = " --collectionmethods Container" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string8_sharphound_offensive_tool_keyword = " --collectionmethods DCOM" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string9_sharphound_offensive_tool_keyword = " --collectionmethods DCOnly" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string10_sharphound_offensive_tool_keyword = " --collectionmethods GPOLocalGroup" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string11_sharphound_offensive_tool_keyword = " --collectionmethods Group" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string12_sharphound_offensive_tool_keyword = " --collectionmethods LocalGroup" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string13_sharphound_offensive_tool_keyword = " --collectionmethods LoggedOn" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string14_sharphound_offensive_tool_keyword = " --collectionmethods ObjectProps" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string15_sharphound_offensive_tool_keyword = " --collectionmethods PSRemote" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string16_sharphound_offensive_tool_keyword = " --collectionmethods RDP" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string17_sharphound_offensive_tool_keyword = " --collectionmethods Session" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string18_sharphound_offensive_tool_keyword = " --collectionmethods Trusts" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string19_sharphound_offensive_tool_keyword = " --doLocalAdminSessionEnum" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string20_sharphound_offensive_tool_keyword = " --excludedcs" nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string21_sharphound_offensive_tool_keyword = /\s\-\-ldapusername\s\s.{0,1000}\s\-\-ldappassword\s/ nocase ascii wide
        // Description: C# Data Collector for BloodHound
        // Reference: https://github.com/BloodHoundAD/SharpHound
        $string22_sharphound_offensive_tool_keyword = " --localadminsessionenum " nocase ascii wide
