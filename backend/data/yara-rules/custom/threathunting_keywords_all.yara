}


rule rule_malware_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'malware' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "malware"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Destructive Malware targeting organizations
        // Reference: https://www.microsoft.com/security/blog/2022/01/15/destructive-malware-targeting-ukrainian-organizations/
        $string1_malware_offensive_tool_keyword = /\s\>\s\\\\127\.0\.0\.1\\ADMIN\$\\__.{0,1000}\s2\>\&1/ nocase ascii wide
        // Description: Destructive Malware targeting organizations
        // Reference: https://www.microsoft.com/security/blog/2022/01/15/destructive-malware-targeting-ukrainian-organizations/
        $string2_malware_offensive_tool_keyword = /cmd\.exe\s\/Q\s\/c\sstart\s.{0,1000}stage1\.exe\s1/ nocase ascii wide
        // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
        // Reference: N/A
        $string3_malware_offensive_tool_keyword = /del\s.{0,1000}C\:\\Program\sFiles.{0,1000}\\TeamViewer\\TeamViewer.{0,1000}_Logfile\.log/ nocase ascii wide
        // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
        // Reference: N/A
        $string4_malware_offensive_tool_keyword = /del\s.{0,1000}C\:\\Users\\.{0,1000}\\AppData\\Roaming\\AnyDesk\\connection_trace\.txt/ nocase ascii wide
        // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
        // Reference: N/A
        $string5_malware_offensive_tool_keyword = /Remove\-Item\s.{0,1000}C\:\\Program\sFiles.{0,1000}\\TeamViewer\\TeamViewer.{0,1000}_Logfile\.log/ nocase ascii wide
        // Description: observed usage of third-party tools. such as anydesk or teamviewer to access remote hosts. deletion of these logs file is suspicious and could be the actions of intruders hiding their traces
        // Reference: N/A
        $string6_malware_offensive_tool_keyword = /Remove\-Item\s.{0,1000}C\:\\Users\\.{0,1000}\\AppData\\Roaming\\AnyDesk\\connection_trace\.txt/ nocase ascii wide

    condition:
        any of them
}


rule rule_MANSPIDER_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'MANSPIDER' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "MANSPIDER"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string1_MANSPIDER_offensive_tool_keyword = " --dirnames bank financ payable payment reconcil remit voucher vendor eft swift " nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string2_MANSPIDER_offensive_tool_keyword = " -e bat com vbs ps1 psd1 psm1 pem key rsa pub reg txt cfg conf config " nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string3_MANSPIDER_offensive_tool_keyword = " -e pfx p12 pkcs12 pem key crt cer csr jks keystore key keys der " nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string4_MANSPIDER_offensive_tool_keyword = " -e ppk rsa pem ssh rsa" nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string5_MANSPIDER_offensive_tool_keyword = " -f passw -e xlsx csv " nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string6_MANSPIDER_offensive_tool_keyword = " -f passw user admin account network login logon cred " nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string7_MANSPIDER_offensive_tool_keyword = /\/\.manspider\/logs/
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string8_MANSPIDER_offensive_tool_keyword = /\/\.manspider\/loot/
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
        // Reference: https://github.com/blacklanternsecurity/MANSPIDER
        $string9_MANSPIDER_offensive_tool_keyword = /\/MANSPIDER\.git/ nocase ascii wide
        // Description: Spider entire networks for juicy files sitting on SMB shares. Search filenames or file content - regex supported!
