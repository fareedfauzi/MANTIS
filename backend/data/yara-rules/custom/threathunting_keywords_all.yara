        // Description: OWASP repo of rules - extracted strings for detection
        // Reference: https://github.com/coreruleset/coreruleset/
        $string30_OWASP_rules_offensive_tool_keyword = /Yourman\.sh\sMini\sShell/
        // Description: OWASP repo of rules - extracted strings for detection
