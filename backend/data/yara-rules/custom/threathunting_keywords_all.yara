        $string1_MpCmdRun_greyware_tool_keyword = /MpCmdRun\.exe\s\-DownloadFile\s\-url\shttp\:\/\/.{0,1000}\.exe\s\-path\s/ nocase ascii wide
        // Description: Defense evasion technique disable windows defender
        // Reference: N/A
