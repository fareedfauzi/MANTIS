rule rule_gsecdump_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'gsecdump' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "gsecdump"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string1_gsecdump_offensive_tool_keyword = " --dump_lsa" nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string2_gsecdump_offensive_tool_keyword = " --dump_usedhashes" nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string3_gsecdump_offensive_tool_keyword = " --dump_wireless" nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string4_gsecdump_offensive_tool_keyword = /\/gsecdump\-.{0,1000}\.exe/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string5_gsecdump_offensive_tool_keyword = /\/gsecdump\.exe/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string6_gsecdump_offensive_tool_keyword = /\\gsecdump\-.{0,1000}\.exe/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string7_gsecdump_offensive_tool_keyword = /\\gsecdump\.exe/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string8_gsecdump_offensive_tool_keyword = /\\pipe\\gsecdump_/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string9_gsecdump_offensive_tool_keyword = /\>\\gsecdump_/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string10_gsecdump_offensive_tool_keyword = "94cae63dcbabb71c5dd43f55fd09caeffdcd7628a02a112fb3cba36698ef72bc" nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string11_gsecdump_offensive_tool_keyword = /gsecdump\-v2b5\.exe/ nocase ascii wide
        // Description: credential dumper used to obtain password hashes and LSA secrets from Windows operating systems
        // Reference: https://web.archive.org/web/20150606043951if_/http://www.truesec.se/Upload/Sakerhet/Tools/gsecdump-v2b5.exe
        $string12_gsecdump_offensive_tool_keyword = /pipe\\\\gsecdump_/ nocase ascii wide

    condition:
        any of them
}


rule rule_gsocket_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'gsocket' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "gsocket"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string1_gsocket_offensive_tool_keyword = " GS_STTY_INIT_HACK" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string2_gsocket_offensive_tool_keyword = " gs-netcat " nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string3_gsocket_offensive_tool_keyword = /\sgsocket\-.{0,1000}\.tar\.gz/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string4_gsocket_offensive_tool_keyword = /\sgsocket\.io\/x/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string5_gsocket_offensive_tool_keyword = /\sgsocket_.{0,1000}_all\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string6_gsocket_offensive_tool_keyword = " GSOCKET_SOCKS_IP" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string7_gsocket_offensive_tool_keyword = " install gsocket" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string8_gsocket_offensive_tool_keyword = /\snc\s.{0,1000}\.gsocket/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string9_gsocket_offensive_tool_keyword = " nc gsocket 31337" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string10_gsocket_offensive_tool_keyword = " --remote gsocket" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string11_gsocket_offensive_tool_keyword = " --rm -it --name gsocket" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string12_gsocket_offensive_tool_keyword = /\sssh\s.{0,1000}\@gsocket/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string13_gsocket_offensive_tool_keyword = " start gs-sshd" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string14_gsocket_offensive_tool_keyword = " status gs-sshd" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string15_gsocket_offensive_tool_keyword = "/bin/gs-netcat"
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string16_gsocket_offensive_tool_keyword = "/bin/gs-netcat"
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string17_gsocket_offensive_tool_keyword = /\/etc\/gsocket\.conf/
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string18_gsocket_offensive_tool_keyword = "/etc/systemd/gsc"
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string19_gsocket_offensive_tool_keyword = "/gs-netcat "
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string20_gsocket_offensive_tool_keyword = /\/gsocket\-.{0,1000}\.tar\.gz/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Mostly abused by attackers 
        // Reference: https://github.com/hackerschoice/gsocket
        $string21_gsocket_offensive_tool_keyword = /\/gsocket\.1/
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string22_gsocket_offensive_tool_keyword = /\/gsocket\.git/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string23_gsocket_offensive_tool_keyword = "/gsocket/releases/latest" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string24_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}_all\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string25_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}_x86_64\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string26_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}aarch64\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string27_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}arm\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string28_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}armv6\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string29_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}armv7l\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string30_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}i686\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string31_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}mips32\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string32_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}mips64\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string33_gsocket_offensive_tool_keyword = /\/gsocket_.{0,1000}mipsel\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string34_gsocket_offensive_tool_keyword = /\/gsocket_dso\.so\./ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string35_gsocket_offensive_tool_keyword = /\/gsocket_latest_all\.deb/ nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string36_gsocket_offensive_tool_keyword = "/gsocket-build" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string37_gsocket_offensive_tool_keyword = "/gsocket-deb" nocase ascii wide
        // Description: The Global Socket Tookit allows two users behind NAT/Firewall to establish a TCP connection with each other. Securely.
        // Reference: https://github.com/hackerschoice/gsocket
        $string38_gsocket_offensive_tool_keyword = "/gsocket-pkg/" nocase ascii wide
