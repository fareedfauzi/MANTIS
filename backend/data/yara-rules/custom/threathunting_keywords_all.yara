        // Description: This project is a Python version of the well-known Snaffler project. Not a full implementation of that project - only focusing on SMB share/dir/file enumeration and download and parse.
        // Reference: https://github.com/skelsec/pysnaffler
        $string17_pysnaffler_offensive_tool_keyword = /pysnaffler\/_version\.py/ nocase ascii wide
        // Description: This project is a Python version of the well-known Snaffler project. Not a full implementation of that project - only focusing on SMB share/dir/file enumeration and download and parse.
        // Reference: https://github.com/skelsec/pysnaffler
        $string18_pysnaffler_offensive_tool_keyword = "pysnaffler-main" nocase ascii wide
        // Description: This project is a Python version of the well-known Snaffler project. Not a full implementation of that project - only focusing on SMB share/dir/file enumeration and download and parse.
        // Reference: https://github.com/skelsec/pysnaffler
        $string19_pysnaffler_offensive_tool_keyword = "skelsec/pysnaffler" nocase ascii wide

    condition:
