        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string10_SoftEtherVPN_greyware_tool_keyword = /\/softether\-vpnserver_.{0,1000}\.exe/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string11_SoftEtherVPN_greyware_tool_keyword = "/usr/ports/security/softether5"
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string12_SoftEtherVPN_greyware_tool_keyword = /\\AppData\\Local\\Temp\\VPN_.{0,1000}\\VPN_Lock\.dat/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string13_SoftEtherVPN_greyware_tool_keyword = /\\appdata\\local\\temp\\vpn_.{0,1000}\\vpnsetup\.exe/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string14_SoftEtherVPN_greyware_tool_keyword = /\\AppData\\Local\\Temp\\VPN_AECD\\/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string15_SoftEtherVPN_greyware_tool_keyword = /\\CurrentControlSet\\Services\\Neo_VPN/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string16_SoftEtherVPN_greyware_tool_keyword = /\\CurrentControlSet\\Services\\SEVPNCLIENTDEV/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string17_SoftEtherVPN_greyware_tool_keyword = /\\DriverDatabase\\DeviceIds\\NeoAdapter_VPN/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string18_SoftEtherVPN_greyware_tool_keyword = /\\Program\sFiles\s\(x86\)\\SoftEther\sVPN/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string19_SoftEtherVPN_greyware_tool_keyword = /\\Program\sFiles\\SoftEther\sVPN/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string20_SoftEtherVPN_greyware_tool_keyword = /\\Public\\Desktop\\SoftEther\sVPN\s/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string21_SoftEtherVPN_greyware_tool_keyword = /\\SoftEther\sVPN\s.{0,1000}\\client_log\\client_20.{0,1000}\.log/ nocase ascii wide
        // Description: Cross-platform multi-protocol VPN software abused by attackers
        // Reference: https://github.com/SoftEtherVPN/SoftEtherVPN
        $string22_SoftEtherVPN_greyware_tool_keyword = /\\SoftEther\sVPN\sClient\sDeveloper\sEdition\\/ nocase ascii wide
