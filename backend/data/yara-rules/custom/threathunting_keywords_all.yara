        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string7_ScriptSentry_offensive_tool_keyword = /\\ScriptSentry\.psm1/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string8_ScriptSentry_offensive_tool_keyword = /\\ScriptSentry\.txt/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string9_ScriptSentry_offensive_tool_keyword = "e1cd2b55-3b4f-41bd-a168-40db41e34349" nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string10_ScriptSentry_offensive_tool_keyword = /Find\-AdminLogonScripts\.ps1/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string11_ScriptSentry_offensive_tool_keyword = "Find-LogonScriptCredentials -LogonScripts" nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string12_ScriptSentry_offensive_tool_keyword = /Find\-LogonScriptCredentials\.ps1/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string13_ScriptSentry_offensive_tool_keyword = /Find\-UnsafeLogonScriptPermissions\.ps1/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string14_ScriptSentry_offensive_tool_keyword = "Find-UnsafeUNCPermissions -UNCScripts" nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string15_ScriptSentry_offensive_tool_keyword = /Find\-UnsafeUNCPermissions\.ps1/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string16_ScriptSentry_offensive_tool_keyword = /Get\-DomainAdmins\.ps1/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string17_ScriptSentry_offensive_tool_keyword = "Invoke-ScriptSentry" nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string18_ScriptSentry_offensive_tool_keyword = /ScriptSentry\-main\.zip/ nocase ascii wide
        // Description: ScriptSentry finds misconfigured and dangerous logon scripts.
        // Reference: https://github.com/techspence/ScriptSentry
        $string19_ScriptSentry_offensive_tool_keyword = "techspence/ScriptSentry" nocase ascii wide

    condition:
        any of them
}


rule rule_scshell_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'scshell' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "scshell"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: SCShell is a fileless Lateral Movement tool that relies on ChangeServiceConfigA to run commands. The beauty of this tool is that it does not perform authentication against SMB. Everything is performed over DCERPC.The utility can be used remotely WITHOUT registering a service or creating a service. It also doesn't have to drop any file on the remote system* (Depend on the technique used to execute)
        // Reference: https://github.com/Mr-Un1k0d3r/SCShell
        $string1_scshell_offensive_tool_keyword = "/scshell"
        // Description: network pentestration test (shell)
        // Reference: https://github.com/Mr-Un1k0d3r/SCShell
        $string2_scshell_offensive_tool_keyword = /payload\.csproj/ nocase ascii wide
        // Description: network pentestration test (shell)
        // Reference: https://github.com/Mr-Un1k0d3r/SCShell
        $string3_scshell_offensive_tool_keyword = /payload\.sct\s/ nocase ascii wide

    condition:
        any of them
}


rule rule_SearchOpenFileShares_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SearchOpenFileShares' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SearchOpenFileShares"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Searches open files shares for password files or database backups - Extend as you see fit
        // Reference: https://github.com/fashionproof/SearchOpenFileShares
        $string1_SearchOpenFileShares_offensive_tool_keyword = /\sSearchShares\.ps1/ nocase ascii wide
        // Description: Searches open files shares for password files or database backups - Extend as you see fit
        // Reference: https://github.com/fashionproof/SearchOpenFileShares
        $string2_SearchOpenFileShares_offensive_tool_keyword = /\/SearchShares\.ps1/ nocase ascii wide
        // Description: Searches open files shares for password files or database backups - Extend as you see fit
        // Reference: https://github.com/fashionproof/SearchOpenFileShares
        $string3_SearchOpenFileShares_offensive_tool_keyword = /\\SearchShares\.ps1/ nocase ascii wide
        // Description: Searches open files shares for password files or database backups - Extend as you see fit
        // Reference: https://github.com/fashionproof/SearchOpenFileShares
        $string4_SearchOpenFileShares_offensive_tool_keyword = /\\temp\\OpenFileShares\.txt/ nocase ascii wide
        // Description: Searches open files shares for password files or database backups - Extend as you see fit
        // Reference: https://github.com/fashionproof/SearchOpenFileShares
        $string5_SearchOpenFileShares_offensive_tool_keyword = "FF1F2BA2086D03356EB51ED2208F334EF9E71CA266BFB73AB3CD1F14B494503E" nocase ascii wide

    condition:
        any of them
}


rule rule_seatbelt_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'seatbelt' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "seatbelt"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string1_seatbelt_offensive_tool_keyword = " --Args AntiVirus --XorKey" nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string2_seatbelt_offensive_tool_keyword = " --args whoami" nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string3_seatbelt_offensive_tool_keyword = /\.exe\s\s\-group\=remote\s\-computername\=/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string4_seatbelt_offensive_tool_keyword = /\.exe\s\-group\=all\s/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string5_seatbelt_offensive_tool_keyword = /\.exe\s\-group\=all\s\-AuditPolicies/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string6_seatbelt_offensive_tool_keyword = /\.exe\s\-group\=all\s\-full/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string7_seatbelt_offensive_tool_keyword = /\.exe\s\-group\=remote\s/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string8_seatbelt_offensive_tool_keyword = /\.exe\s\-group\=system\s/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string9_seatbelt_offensive_tool_keyword = /\.exe\s\-group\=user\s/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string10_seatbelt_offensive_tool_keyword = /\.exe\sNonstandardProcesses/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string11_seatbelt_offensive_tool_keyword = /\.exe\sNTLMSettings/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string12_seatbelt_offensive_tool_keyword = /\.exe\s\-q\sInterestingProcesses/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string13_seatbelt_offensive_tool_keyword = /\.exe\s\-q\sPowerShell/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
        $string14_seatbelt_offensive_tool_keyword = /\.exe\s\-q\sWindowsDefender/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string15_seatbelt_offensive_tool_keyword = /\/Seatbelt\.exe/ nocase ascii wide
        // Description: Seatbelt is a comprehensive security scanning tool that can be used to perform a variety of checks. including but not limited to. user privileges. logged in users. network information. system information. and many others
        // Reference: https://github.com/GhostPack/Seatbelt
