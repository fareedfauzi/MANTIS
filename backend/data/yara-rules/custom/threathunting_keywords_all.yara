rule rule_PwDump7_signature_keyword
{
    meta:
        description = "Detection patterns for the tool 'PwDump7' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PwDump7"
        rule_category = "signature_keyword"

    strings:
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string1_PwDump7_signature_keyword = /HackTool\.PasswordStealer/ nocase ascii wide
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string2_PwDump7_signature_keyword = /HackTool\.Win32\.PWDump/ nocase ascii wide
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string3_PwDump7_signature_keyword = /HackTool\.Win32\.PWDump/ nocase ascii wide
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string4_PwDump7_signature_keyword = "HackTool:Win32/PWDump" nocase ascii wide
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string5_PwDump7_signature_keyword = /PWCrack\-Pwdump\./ nocase ascii wide
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string6_PwDump7_signature_keyword = /PWDump7\sRaw\sPassword\sExtractor\s\(PUA\)/ nocase ascii wide
        // Description: pwdump7 works with its own filesytem driver (from rkdetector.com technology) so users with administrative privileges are able to dump directly from disk both SYSTEM and SAM registry hives. Once dumped - the SYSKEY key will be retrieved from the SYSTEM hive and then used to decrypt both LanMan and NTLM hashes and dump them in pwdump like format.
        // Reference: https://www.openwall.com/passwords/windows-pwdump
        $string7_PwDump7_signature_keyword = "Win32/PWDump" nocase ascii wide

    condition:
        any of them
}


rule rule_PWDumpX_signature_keyword
{
    meta:
        description = "Detection patterns for the tool 'PWDumpX' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PWDumpX"
        rule_category = "signature_keyword"

    strings:
        // Description: PWDumpX tool allows a user with administrative privileges to retrieve the encrypted password hashes and LSA secrets from a Windows system. This tool can be used on the local system or on one or more remote systems.
        // Reference: https://packetstormsecurity.com/files/download/52580/PWDumpX.zip
        $string1_PWDumpX_signature_keyword = /HKTL_PWDUMP\./ nocase ascii wide
        // Description: PWDumpX tool allows a user with administrative privileges to retrieve the encrypted password hashes and LSA secrets from a Windows system. This tool can be used on the local system or on one or more remote systems.
        // Reference: https://packetstormsecurity.com/files/download/52580/PWDumpX.zip
        $string2_PWDumpX_signature_keyword = /PSWTool\.Win32\.PWDump/ nocase ascii wide
        // Description: PWDumpX tool allows a user with administrative privileges to retrieve the encrypted password hashes and LSA secrets from a Windows system. This tool can be used on the local system or on one or more remote systems.
        // Reference: https://packetstormsecurity.com/files/download/52580/PWDumpX.zip
        $string3_PWDumpX_signature_keyword = "PWCrack-PWDump" nocase ascii wide
        // Description: PWDumpX tool allows a user with administrative privileges to retrieve the encrypted password hashes and LSA secrets from a Windows system. This tool can be used on the local system or on one or more remote systems.
        // Reference: https://packetstormsecurity.com/files/download/52580/PWDumpX.zip
        $string4_PWDumpX_signature_keyword = /PWDumpX\s\(PUA\)/ nocase ascii wide

    condition:
        any of them
}


