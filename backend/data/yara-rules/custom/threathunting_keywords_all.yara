rule rule_nipe_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'nipe' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "nipe"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string1_nipe_offensive_tool_keyword = /\/etc\/init\.d\/tor\sstart/
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string2_nipe_offensive_tool_keyword = /\/etc\/init\.d\/tor\sstop/
        // Description: An engine to make Tor Network your default gateway.
        // Reference: https://github.com/htrgouvea/nipe
        $string3_nipe_offensive_tool_keyword = /\/nipe\.git/ nocase ascii wide
        // Description: An engine to make Tor Network your default gateway.
        // Reference: https://github.com/htrgouvea/nipe
        $string4_nipe_offensive_tool_keyword = /\/nipe\.pl/ nocase ascii wide
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string5_nipe_offensive_tool_keyword = "/var/run/tor/control"
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string6_nipe_offensive_tool_keyword = /\/var\/run\/tor\/tor\.pid/
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string7_nipe_offensive_tool_keyword = "htrgouvea/nipe" nocase ascii wide
        // Description: An engine to make Tor Network your default gateway.
        // Reference: https://github.com/htrgouvea/nipe
        $string8_nipe_offensive_tool_keyword = "htrgouvea/nipe" nocase ascii wide
        // Description: An engine to make Tor network your default gateway. Tor enables users to surf the internet. chat and send instant messages anonymously.  and is used by a wide variety of people for both licit and illicit purposes. Tor has. for example. been used by criminals enterprises. hacktivism groups. and law enforcement  agencies at cross purposes. sometimes simultaneously. Nipe is a script to make the Tor network your default gateway.This Perl script enables you to directly route all your traffic from your computer to the Tor network through which you can surf the internet anonymously without having to worry about being tracked or traced back.
        // Reference: https://github.com/htrgouvea/nipe
        $string9_nipe_offensive_tool_keyword = /nipe\.pl\s/ nocase ascii wide
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string10_nipe_offensive_tool_keyword = /perl\snipe\.pl\sinstall/ nocase ascii wide
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string11_nipe_offensive_tool_keyword = /perl\snipe\.pl\sstart/ nocase ascii wide
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string12_nipe_offensive_tool_keyword = "systemctl start tor" nocase ascii wide
        // Description: An engine to make Tor network your default gateway
        // Reference: https://github.com/GouveaHeitor/nipe
        $string13_nipe_offensive_tool_keyword = /tor\s\-f\s\.configs\/.{0,1000}\-torrc/ nocase ascii wide

    condition:
        any of them
}


rule rule_nircmd_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'nircmd' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "nircmd"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Nirsoft tool - NirCmd is a small command-line utility that allows you to do some useful tasks without displaying any user interface
        // Reference: https://www.nirsoft.net/utils/nircmd.html
        $string1_nircmd_offensive_tool_keyword = /\.exe\selevatecmd\srunassystem\s/ nocase ascii wide
        // Description: Nirsoft tool - NirCmd is a small command-line utility that allows you to do some useful tasks without displaying any user interface
        // Reference: https://www.nirsoft.net/utils/nircmd.html
        $string2_nircmd_offensive_tool_keyword = /\.exe\sexec\shide\s/ nocase ascii wide
        // Description: Nirsoft tool - NirCmd is a small command-line utility that allows you to do some useful tasks without displaying any user interface
        // Reference: https://www.nirsoft.net/utils/nircmd.html
        $string3_nircmd_offensive_tool_keyword = /nircmdc\.exe\ssavescreenshot/ nocase ascii wide

    condition:
        any of them
}


rule rule_nirsoft_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'nirsoft' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
