        $string28_thc_hydra_offensive_tool_keyword = "vanhauser-thc/thc-hydra"
        // Description: Parallelized login cracker which supports numerous protocols to attack.
        // Reference: https://github.com/vanhauser-thc/thc-hydra
        $string29_thc_hydra_offensive_tool_keyword = "hydra -"

    condition:
        any of them
}


rule rule_the_backdoor_factory_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'the-backdoor-factory' taken from the ThreatHunting-Keywords github project"
