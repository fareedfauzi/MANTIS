}


rule rule_DOME_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'DOME' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
