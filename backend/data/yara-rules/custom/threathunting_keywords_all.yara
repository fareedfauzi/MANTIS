        // Description: Ask a TGS on behalf of another user without password
        // Reference: https://github.com/foxlox/GIUDA
        $string6_GIUDA_offensive_tool_keyword = /guida\.exe\s\-/ nocase ascii wide

    condition:
        any of them
}


