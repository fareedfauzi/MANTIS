rule rule_pinggy_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'pinggy' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "pinggy"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: Create HTTP/TCP or TLS tunnels to your Mac/PC. Even if it is sitting behind firewalls and NATs.
        // Reference: https://pinggy.io/
        $string1_pinggy_greyware_tool_keyword = /\sa\.pinggy\.io/ nocase ascii wide
        // Description: Create HTTP/TCP or TLS tunnels to your Mac/PC. Even if it is sitting behind firewalls and NATs.
        // Reference: https://pinggy.io/
        $string2_pinggy_greyware_tool_keyword = /\.a\.pinggy\.online/ nocase ascii wide
        // Description: Create HTTP/TCP or TLS tunnels to your Mac/PC. Even if it is sitting behind firewalls and NATs.
        // Reference: https://pinggy.io/
        $string3_pinggy_greyware_tool_keyword = /\.free\.pinggy\.online/ nocase ascii wide
        // Description: Create HTTP/TCP or TLS tunnels to your Mac/PC. Even if it is sitting behind firewalls and NATs.
        // Reference: https://pinggy.io/
        $string4_pinggy_greyware_tool_keyword = /\/a\.pinggy\.io/ nocase ascii wide
        // Description: Create HTTP/TCP or TLS tunnels to your Mac/PC. Even if it is sitting behind firewalls and NATs.
        // Reference: https://pinggy.io/
        $string5_pinggy_greyware_tool_keyword = /\@a\.pinggy\.io/ nocase ascii wide

    condition:
        any of them
}


rule rule_pktmon_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'pktmon' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "pktmon"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: pktmon network diagnostics tool for Windows that can be used for packet capture - packet drop detection - packet filtering and counting.
        // Reference: https://learn.microsoft.com/en-us/windows-server/networking/technologies/pktmon/pktmon
        $string1_pktmon_greyware_tool_keyword = "pktmon start" nocase ascii wide

    condition:
        any of them
}


rule rule_plink_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'plink' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "plink"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: creates an SSH tunnel from the local machine to the remote machine allowing the user to connect to an RDP session on the remote machine through port 3389. This plink usage is often used by attackers
        // Reference: N/A
        $string1_plink_greyware_tool_keyword = /plink\s\-N\s\-L\s.{0,1000}\:localhost\:3389\s/ nocase ascii wide

    condition:
        any of them
}


