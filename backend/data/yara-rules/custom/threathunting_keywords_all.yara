        // Reference: https://github.com/dievus/lnkbomb
        $string9_lnkbomb_offensive_tool_keyword = /lnkbomb\-1\.0\.zip/ nocase ascii wide
        // Description: Malicious shortcut generator for collecting NTLM hashes from insecure file shares.
        // Reference: https://github.com/dievus/lnkbomb
        $string10_lnkbomb_offensive_tool_keyword = "Malicious Shortcut Generator" nocase ascii wide

    condition:
        any of them
}


rule rule_LNKUp_offensive_tool_keyword
