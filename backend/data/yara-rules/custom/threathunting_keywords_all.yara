rule rule_BruteSploit_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'BruteSploit' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "BruteSploit"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string1_BruteSploit_offensive_tool_keyword = " Brutesploit" nocase ascii wide
        // Description: Fast and easy create backdoor office exploitation using module metasploit packet . Microsoft Office . Open Office . Macro attack . Buffer Overflow
        // Reference: https://github.com/screetsec/Microsploit
        $string2_BruteSploit_offensive_tool_keyword = /\sMicrosploit\.sh/ nocase ascii wide
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string3_BruteSploit_offensive_tool_keyword = /\.\/Brutesploit/
        // Description: Fast and easy create backdoor office exploitation using module metasploit packet . Microsoft Office . Open Office . Macro attack . Buffer Overflow
        // Reference: https://github.com/screetsec/Microsploit
        $string4_BruteSploit_offensive_tool_keyword = /\.\/Microsploit/
        // Description: Ghost In The Shell - This tool will setting up your backdoor/rootkits when backdoor already setup it will be hidden your spesisifc process.unlimited your session in metasploit and transparent. Even when it killed. it will re-run again. There always be a procces which while run another process.So we can assume that this procces is unstopable like a Ghost in The Shell
        // Reference: https://github.com/screetsec/Vegile
        $string5_BruteSploit_offensive_tool_keyword = /\.\/Vegile/
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string6_BruteSploit_offensive_tool_keyword = "/BruteSploit" nocase ascii wide
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string7_BruteSploit_offensive_tool_keyword = /\/dirsearch\.py/ nocase ascii wide
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string8_BruteSploit_offensive_tool_keyword = /\/instabrute\.py/ nocase ascii wide
        // Description: Ghost In The Shell - This tool will setting up your backdoor/rootkits when backdoor already setup it will be hidden your spesisifc process.unlimited your session in metasploit and transparent. Even when it killed. it will re-run again. There always be a procces which while run another process.So we can assume that this procces is unstopable like a Ghost in The Shell
        // Reference: https://github.com/screetsec/Vegile
        $string9_BruteSploit_offensive_tool_keyword = /\/Vegile\.git/ nocase ascii wide
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string10_BruteSploit_offensive_tool_keyword = /Brutesploit\.git/ nocase ascii wide
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string11_BruteSploit_offensive_tool_keyword = "BruteSploit/wlist/" nocase ascii wide
        // Description: Fast and easy create backdoor office exploitation using module metasploit packet . Microsoft Office . Open Office . Macro attack . Buffer Overflow
        // Reference: https://github.com/screetsec/Microsploit
        $string12_BruteSploit_offensive_tool_keyword = /microsploit\.git/ nocase ascii wide
        // Description: BruteSploit is a collection of method for automated Generate. Bruteforce and Manipulation wordlist with interactive shell. That can be used during a penetration test to enumerate and maybe can be used in CTF for manipulation.combine.transform and permutation some words or file text
        // Reference: https://github.com/screetsec/BruteSploit
        $string13_BruteSploit_offensive_tool_keyword = /Password\-Default\/service\.txt/ nocase ascii wide
        // Description: Fast and easy create backdoor office exploitation using module metasploit packet . Microsoft Office . Open Office . Macro attack . Buffer Overflow
        // Reference: https://github.com/screetsec/Microsploit
        $string14_BruteSploit_offensive_tool_keyword = "screetsec/Microsploit" nocase ascii wide
        // Description: Ghost In The Shell - This tool will setting up your backdoor/rootkits when backdoor already setup it will be hidden your spesisifc process.unlimited your session in metasploit and transparent. Even when it killed. it will re-run again. There always be a procces which while run another process.So we can assume that this procces is unstopable like a Ghost in The Shell
        // Reference: https://github.com/screetsec/Vegile
        $string15_BruteSploit_offensive_tool_keyword = "Vegile -" nocase ascii wide

    condition:
        any of them
}


rule rule_brutespray_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'brutespray' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "brutespray"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: BruteSpray takes nmap GNMAP/XML output or newline seperated JSONS and automatically brute-forces services with default credentials using Medusa. BruteSpray can even find non-standard ports by using the -sV inside Nmap.
        // Reference: https://github.com/x90skysn3k/brutespray
        $string1_brutespray_offensive_tool_keyword = /\s\-f\snessus\.nessus\s/ nocase ascii wide
        // Description: BruteSpray takes nmap GNMAP/XML output or newline seperated JSONS and automatically brute-forces services with default credentials using Medusa. BruteSpray can even find non-standard ports by using the -sV inside Nmap.
        // Reference: https://github.com/x90skysn3k/brutespray
        $string2_brutespray_offensive_tool_keyword = /\/brutespray\.git/ nocase ascii wide
        // Description: BruteSpray takes nmap GNMAP/XML output or newline seperated JSONS and automatically brute-forces services with default credentials using Medusa. BruteSpray can even find non-standard ports by using the -sV inside Nmap.
        // Reference: https://github.com/x90skysn3k/brutespray
        $string3_brutespray_offensive_tool_keyword = "/brutespray/" nocase ascii wide
        // Description: BruteSpray takes nmap GNMAP/XML output or newline seperated JSONS and automatically brute-forces services with default credentials using Medusa. BruteSpray can even find non-standard ports by using the -sV inside Nmap.
        // Reference: https://github.com/x90skysn3k/brutespray
        $string4_brutespray_offensive_tool_keyword = "/brutespray_" nocase ascii wide
        // Description: BruteSpray takes nmap GNMAP/XML output or newline seperated JSONS and automatically brute-forces services with default credentials using Medusa. BruteSpray can even find non-standard ports by using the -sV inside Nmap.
        // Reference: https://github.com/x90skysn3k/brutespray
