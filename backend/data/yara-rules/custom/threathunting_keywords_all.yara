        // Reference: https://github.com/lefayjey/SharpSQLPwn
        $string2_SharpSQLPwn_offensive_tool_keyword = /\s\/cmdtech\:.{0,1000}\s\/cmd\:.{0,1000}\s\/query\:/ nocase ascii wide
