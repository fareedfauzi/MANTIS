rule rule_goPassGen_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'goPassGen' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "goPassGen"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Easily-guessable Password Generator for Password Spray Attack
        // Reference: https://github.com/bigb0sss/goPassGen
        $string1_goPassGen_offensive_tool_keyword = /\/goPassGen\.git/ nocase ascii wide
        // Description: Easily-guessable Password Generator for Password Spray Attack
        // Reference: https://github.com/bigb0sss/goPassGen
        $string2_goPassGen_offensive_tool_keyword = "bigb0sss/goPassGen" nocase ascii wide
        // Description: Easily-guessable Password Generator for Password Spray Attack
        // Reference: https://github.com/bigb0sss/goPassGen
        $string3_goPassGen_offensive_tool_keyword = "goPassGen-master" nocase ascii wide

    condition:
        any of them
}


rule rule_gophish_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'gophish' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "gophish"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string1_gophish_offensive_tool_keyword = " evilginx" nocase ascii wide
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string2_gophish_offensive_tool_keyword = "/evilginx" nocase ascii wide
        // Description: Open-Source Phishing Toolkit
        // Reference: https://github.com/gophish/gophish
        $string3_gophish_offensive_tool_keyword = /\/gophish\.db/ nocase ascii wide
        // Description: Open-Source Phishing Toolkit
        // Reference: https://github.com/gophish/gophish
        $string4_gophish_offensive_tool_keyword = "/gophish/" nocase ascii wide
        // Description: Gophish is an open-source phishing toolkit designed for businesses and penetration testers. It provides the ability to quickly and easily setup and execute phishing engagements and security awareness training.
        // Reference: https://github.com/gophish/gophish
        $string5_gophish_offensive_tool_keyword = "c121f7d62fa5ecd27c3aaae5737a3de8f2e4def0c182058b6dd824aa92351e9c" nocase ascii wide
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string6_gophish_offensive_tool_keyword = /evilfeed\.go/ nocase ascii wide
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string7_gophish_offensive_tool_keyword = "evilginx-linux"
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string8_gophish_offensive_tool_keyword = "evilgophish" nocase ascii wide
        // Description: Gophish is an open-source phishing toolkit designed for businesses and penetration testers. It provides the ability to quickly and easily setup and execute phishing engagements and security awareness training.
        // Reference: https://github.com/gophish/gophish
        $string9_gophish_offensive_tool_keyword = /gophish.{0,1000}phish\.go/ nocase ascii wide
        // Description: Open-Source Phishing Toolkit
        // Reference: https://github.com/gophish/gophish
        $string10_gophish_offensive_tool_keyword = /gophish\.go/ nocase ascii wide
        // Description: Gophish is an open-source phishing toolkit designed for businesses and penetration testers. It provides the ability to quickly and easily setup and execute phishing engagements and security awareness training.
        // Reference: https://github.com/gophish/gophish
        $string11_gophish_offensive_tool_keyword = "gophish/gophish" nocase ascii wide
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string12_gophish_offensive_tool_keyword = "localhost:1337" nocase ascii wide
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string13_gophish_offensive_tool_keyword = "lures create " nocase ascii wide
        // Description: Open-Source Phishing Toolkit
        // Reference: https://github.com/gophish/gophish
        $string14_gophish_offensive_tool_keyword = /phish_test\.go/ nocase ascii wide
        // Description: Combination of evilginx2 and GoPhish
        // Reference: https://github.com/fin3ss3g0d/evilgophish
        $string15_gophish_offensive_tool_keyword = "phishlets " nocase ascii wide
        // Description: Hiding GoPhish from the boys in blue
        // Reference: https://github.com/puzzlepeaches/sneaky_gophish/
        $string16_gophish_offensive_tool_keyword = "sneaky_gophish" nocase ascii wide
        // Description: Gophish is an open-source phishing toolkit designed for businesses and penetration testers. It provides the ability to quickly and easily setup and execute phishing engagements and security awareness training.
        // Reference: https://github.com/gophish/gophish
        $string17_gophish_offensive_tool_keyword = "X-Gophish-Contact" nocase ascii wide

    condition:
        any of them
}


rule rule_Gorsair_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Gorsair' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Gorsair"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Gorsair hacks its way into remote docker containers that expose their APIs
        // Reference: https://github.com/Ullaakut/Gorsair
        $string1_Gorsair_offensive_tool_keyword = "/bin/gorsair "
        // Description: Gorsair hacks its way into remote docker containers that expose their APIs
        // Reference: https://github.com/Ullaakut/Gorsair
        $string2_Gorsair_offensive_tool_keyword = /\/gorsair\.go/ nocase ascii wide
        // Description: Gorsair hacks its way into remote docker containers that expose their APIs
        // Reference: https://github.com/Ullaakut/Gorsair
        $string3_Gorsair_offensive_tool_keyword = "gorsair -t " nocase ascii wide
        // Description: Gorsair hacks its way into remote docker containers that expose their APIs
        // Reference: https://github.com/Ullaakut/Gorsair
        $string4_Gorsair_offensive_tool_keyword = "Ullaakut/Gorsair" nocase ascii wide

    condition:
        any of them
}


