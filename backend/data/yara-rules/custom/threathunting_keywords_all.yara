rule rule_Findsploit_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Findsploit' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Findsploit"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Finsploit is a simple bash script to quickly and easily search both local and online exploit databases. This repository also includes copysploit to copy any exploit-db exploit to the current directory and compilesploit to automatically compile and run any C exploit (ie. ./copysploit 1337.c && ./compilesploit 1337.c)
        // Reference: https://github.com/1N3/Findsploit
        $string1_Findsploit_offensive_tool_keyword = "Findsploit" nocase ascii wide

    condition:
        any of them
}


rule rule_findstr_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'findstr' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "findstr"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: findstr used to find credentials
        // Reference: N/A
        $string1_findstr_offensive_tool_keyword = /findstr\s.{0,1000}BEGIN\sCERTIFICATE/ nocase ascii wide
        // Description: findstr used to find credentials
        // Reference: N/A
        $string2_findstr_offensive_tool_keyword = /findstr\s.{0,1000}confidential/ nocase ascii wide
        // Description: findstr used to find credentials
        // Reference: N/A
        $string3_findstr_offensive_tool_keyword = /findstr\s.{0,1000}net\suse/ nocase ascii wide
        // Description: findstr used to find credentials
        // Reference: N/A
        $string4_findstr_offensive_tool_keyword = /findstr\s.{0,1000}password/ nocase ascii wide
        // Description: findstr used to find credentials
        // Reference: N/A
        $string5_findstr_offensive_tool_keyword = /findstr\s\/S\s\/I\scpassword\s.{0,1000}\\policies\\.{0,1000}\.xml/ nocase ascii wide
        // Description: findstr used to find lsass pid in order to dump lsass process
        // Reference: https://github.com/gabriellandau/PPLFault
        $string6_findstr_offensive_tool_keyword = "findstr lsass" nocase ascii wide

    condition:
        any of them
}


rule rule_findsubdomains_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'findsubdomains' taken from the ThreatHunting-Keywords github project"
