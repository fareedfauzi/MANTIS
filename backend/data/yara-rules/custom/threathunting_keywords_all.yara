        // Description: Enumerate information from NTLM authentication enabled web endpoints
        // Reference: https://github.com/puzzlepeaches/NTLMRecon
        $string6_NTMLRecon_offensive_tool_keyword = /\/ntlmutil\.py/ nocase ascii wide
        // Description: Enumerate information from NTLM authentication enabled web endpoints
        // Reference: https://github.com/puzzlepeaches/NTLMRecon
        $string7_NTMLRecon_offensive_tool_keyword = /\\ntlmutil\.py/ nocase ascii wide
        // Description: A fast and flexible NTLM reconnaissance tool without external dependencies. Useful to find out information about NTLM endpoints when working with a large set of potential IP addresses and domains
        // Reference: https://github.com/pwnfoo/NTLMRecon
        $string8_NTMLRecon_offensive_tool_keyword = "ntlmrecon " nocase ascii wide
        // Description: A fast and flexible NTLM reconnaissance tool without external dependencies. Useful to find out information about NTLM endpoints when working with a large set of potential IP addresses and domains
        // Reference: https://github.com/pwnfoo/NTLMRecon
        $string9_NTMLRecon_offensive_tool_keyword = /ntlmrecon\.csv/ nocase ascii wide
        // Description: Enumerate information from NTLM authentication enabled web endpoints
        // Reference: https://github.com/puzzlepeaches/NTLMRecon
        $string10_NTMLRecon_offensive_tool_keyword = "ntlmrecon:main" nocase ascii wide
        // Description: A fast and flexible NTLM reconnaissance tool without external dependencies. Useful to find out information about NTLM endpoints when working with a large set of potential IP addresses and domains
        // Reference: https://github.com/pwnfoo/NTLMRecon
        $string11_NTMLRecon_offensive_tool_keyword = /ntlmrecon\-fromfile\.csv/ nocase ascii wide
        // Description: Enumerate information from NTLM authentication enabled web endpoints
        // Reference: https://github.com/puzzlepeaches/NTLMRecon
        $string12_NTMLRecon_offensive_tool_keyword = "NTLMRecon-master" nocase ascii wide
        // Description: A fast and flexible NTLM reconnaissance tool without external dependencies. Useful to find out information about NTLM endpoints when working with a large set of potential IP addresses and domains
        // Reference: https://github.com/pwnfoo/NTLMRecon
        $string13_NTMLRecon_offensive_tool_keyword = /ntlmrecon\-ranges\.csv/ nocase ascii wide
        // Description: Enumerate information from NTLM authentication enabled web endpoints
        // Reference: https://github.com/puzzlepeaches/NTLMRecon
        $string14_NTMLRecon_offensive_tool_keyword = "puzzlepeaches/NTLMRecon" nocase ascii wide
        // Description: Enumerate information from NTLM authentication enabled web endpoints
        // Reference: https://github.com/puzzlepeaches/NTLMRecon
        $string15_NTMLRecon_offensive_tool_keyword = "TlRMTVNTUAABAAAAMpCI4gAAAAAoAAAAAAAAACgAAAAGAbEdAAAADw==" nocase ascii wide

    condition:
        any of them
}


rule rule_ntpescape_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ntpescape' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ntpescape"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string1_ntpescape_offensive_tool_keyword = /\s\|\s\.\/send\s\-d\s.{0,1000}\:123\s\-tM\s0\s\-tm\s0/
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string2_ntpescape_offensive_tool_keyword = /\.\/recv\s\-d\s\:50001/
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string3_ntpescape_offensive_tool_keyword = /\.\/send\s\-d\s.{0,1000}\:123\s\-f\s/
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string4_ntpescape_offensive_tool_keyword = /\/ntpescape\.git/ nocase ascii wide
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string5_ntpescape_offensive_tool_keyword = "evallen/ntpescape" nocase ascii wide
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string6_ntpescape_offensive_tool_keyword = /ntpescape.{0,1000}recv/ nocase ascii wide
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string7_ntpescape_offensive_tool_keyword = /ntpescape.{0,1000}send/ nocase ascii wide
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string8_ntpescape_offensive_tool_keyword = /ntpescape\-master\./ nocase ascii wide
        // Description: ntpescape is a tool that can stealthily (but slowly) exfiltrate data from a computer using the Network Time Protocol (NTP).
        // Reference: https://github.com/evallen/ntpescape
        $string9_ntpescape_offensive_tool_keyword = /sudo\s\.\/recv\s\-f\s/

    condition:
        any of them
}


