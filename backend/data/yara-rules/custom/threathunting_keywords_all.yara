}


rule rule_icebreaker_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'icebreaker' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "icebreaker"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string1_icebreaker_offensive_tool_keyword = /\sicebreaker\.py/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string2_icebreaker_offensive_tool_keyword = " -oA icebreaker-scan" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string3_icebreaker_offensive_tool_keyword = " --password-list " nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string4_icebreaker_offensive_tool_keyword = /\s\-\-script\ssmb\-security\-mode.{0,1000}smb\-enum\-shares\s/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string5_icebreaker_offensive_tool_keyword = /\ssmb\-cmds\.txt/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string6_icebreaker_offensive_tool_keyword = /\.py.{0,1000}found\-users\.txt/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string7_icebreaker_offensive_tool_keyword = "/DanMcInerney/ridenum"
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string8_icebreaker_offensive_tool_keyword = /\/DeathStar\/DeathStar\.py/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string9_icebreaker_offensive_tool_keyword = /\/icebreaker\.git/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string10_icebreaker_offensive_tool_keyword = /\/icebreaker\.py/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string11_icebreaker_offensive_tool_keyword = "/lgandx/Responder"
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string12_icebreaker_offensive_tool_keyword = "/opt/icebreaker"
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string13_icebreaker_offensive_tool_keyword = /\/Responder\/Responder\.conf/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string14_icebreaker_offensive_tool_keyword = /\/ridenum\/ridenum\.py/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string15_icebreaker_offensive_tool_keyword = /\/shares\-with\-SCF\.txt/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string16_icebreaker_offensive_tool_keyword = /\/smb\-cmds\.txt/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string17_icebreaker_offensive_tool_keyword = /\/smb\-signing\-disabled\-hosts\.txt/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string18_icebreaker_offensive_tool_keyword = /\/theHarvester\.py/
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string19_icebreaker_offensive_tool_keyword = "/virtualenvs/icebreaker"
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string20_icebreaker_offensive_tool_keyword = /\\icebreaker\.py/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string21_icebreaker_offensive_tool_keyword = /1mil\-AD\-passwords\.txt/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string22_icebreaker_offensive_tool_keyword = "byt3bl33d3r/DeathStar" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string23_icebreaker_offensive_tool_keyword = "CoreSecurity/impacket/" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string24_icebreaker_offensive_tool_keyword = "DanMcInerney/Empire" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string25_icebreaker_offensive_tool_keyword = "DanMcInerney/icebreaker" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string26_icebreaker_offensive_tool_keyword = "DanMcInerney/theHarvester" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string27_icebreaker_offensive_tool_keyword = /found\-passwords\.txt/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string28_icebreaker_offensive_tool_keyword = /https\:\/\/0\.0\.0\.0\:1337/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string29_icebreaker_offensive_tool_keyword = "icebreaker:P@ssword123456" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string30_icebreaker_offensive_tool_keyword = /icebreaker\-master\.zip/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string31_icebreaker_offensive_tool_keyword = /icebreaker\-scan\.xml/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string32_icebreaker_offensive_tool_keyword = "Invoke-Cats -pwds" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string33_icebreaker_offensive_tool_keyword = /Invoke\-Cats\.ps1/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string34_icebreaker_offensive_tool_keyword = /Invoke\-Pwds\.ps1/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string35_icebreaker_offensive_tool_keyword = /logs\/Responder\-Session\.log/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string36_icebreaker_offensive_tool_keyword = /logs\/ridenum\.log/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string37_icebreaker_offensive_tool_keyword = /logs\/shares\-with\-SCF\.txt/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string38_icebreaker_offensive_tool_keyword = /logs\/theHarvester\.py\.log/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string39_icebreaker_offensive_tool_keyword = "net localgroup administrators icebreaker" nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string40_icebreaker_offensive_tool_keyword = "net user /add icebreaker " nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string41_icebreaker_offensive_tool_keyword = /ntlmrelayx\.py\.log/ nocase ascii wide
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string42_icebreaker_offensive_tool_keyword = "sudo tmux new -s icebreaker"
        // Description: Gets plaintext Active Directory credentials if you're on the internal network but outside the AD environment
        // Reference: https://github.com/DanMcInerney/icebreaker
        $string43_icebreaker_offensive_tool_keyword = /\-\-wordlist\=.{0,1000}\-passwords\.txt/ nocase ascii wide

    condition:
        any of them
}


rule rule_ICMP_TransferTools_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ICMP-TransferTools' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ICMP-TransferTools"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Transfer files to and from a Windows host via ICMP in restricted network environments.
        // Reference: https://github.com/icyguider/ICMP-TransferTools
        $string1_ICMP_TransferTools_offensive_tool_keyword = /ICMP\-ReceiveFile\.py/ nocase ascii wide
        // Description: Transfer files to and from a Windows host via ICMP in restricted network environments.
        // Reference: https://github.com/icyguider/ICMP-TransferTools
        $string2_ICMP_TransferTools_offensive_tool_keyword = /ICMP\-SendFile\.py/ nocase ascii wide
        // Description: Transfer files to and from a Windows host via ICMP in restricted network environments.
        // Reference: https://github.com/icyguider/ICMP-TransferTools
        $string3_ICMP_TransferTools_offensive_tool_keyword = "Invoke-IcmpDownload" nocase ascii wide
        // Description: Transfer files to and from a Windows host via ICMP in restricted network environments.
        // Reference: https://github.com/icyguider/ICMP-TransferTools
        $string4_ICMP_TransferTools_offensive_tool_keyword = /Invoke\-IcmpDownload\.ps1/ nocase ascii wide
        // Description: Transfer files to and from a Windows host via ICMP in restricted network environments.
        // Reference: https://github.com/icyguider/ICMP-TransferTools
        $string5_ICMP_TransferTools_offensive_tool_keyword = /Invoke\-IcmpUpload\.ps1/ nocase ascii wide

    condition:
        any of them
}


rule rule_icmpsh_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'icmpsh' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "icmpsh"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: venom - C2 shellcode generator/compiler/handler
        // Reference: https://github.com/r00t-3xp10it/venom
        $string1_icmpsh_offensive_tool_keyword = "bdamele/icmpsh" nocase ascii wide
        // Description: venom - C2 shellcode generator/compiler/handler
        // Reference: https://github.com/r00t-3xp10it/venom
        $string2_icmpsh_offensive_tool_keyword = /icmpsh\.exe/ nocase ascii wide
        // Description: Simple reverse ICMP shell
        // Reference: https://github.com/bdamele/icmpsh
        $string3_icmpsh_offensive_tool_keyword = /icmpsh\.git/ nocase ascii wide
        // Description: venom - C2 shellcode generator/compiler/handler
        // Reference: https://github.com/r00t-3xp10it/venom
        $string4_icmpsh_offensive_tool_keyword = /icmpsh_m\.py/ nocase ascii wide
        // Description: venom - C2 shellcode generator/compiler/handler
        // Reference: https://github.com/r00t-3xp10it/venom
        $string5_icmpsh_offensive_tool_keyword = /icmpsh\-m\./ nocase ascii wide
        // Description: Simple reverse ICMP shell
        // Reference: https://github.com/bdamele/icmpsh
        $string6_icmpsh_offensive_tool_keyword = "icmpsh-master" nocase ascii wide
        // Description: venom - C2 shellcode generator/compiler/handler
        // Reference: https://github.com/r00t-3xp10it/venom
        $string7_icmpsh_offensive_tool_keyword = /icmpsh\-s\./ nocase ascii wide

    condition:
        any of them
}


rule rule_icmptunnel_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'icmptunnel' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "icmptunnel"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: icmptunnel works by encapsulating your IP traffic in ICMP echo packets and sending them to your own proxy server. The proxy server decapsulates the packet and forwards the IP traffic. The incoming IP packets which are destined for the client are again encapsulated in ICMP reply packets and sent back to the client. The IP traffic is sent in the 'data' field of ICMP packets.
        // Reference: https://github.com/s-h-3-l-l/katoolin3
        $string1_icmptunnel_offensive_tool_keyword = "icmptunnel" nocase ascii wide

    condition:
        any of them
}


rule rule_IDiagnosticProfileUAC_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'IDiagnosticProfileUAC' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "IDiagnosticProfileUAC"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: UAC bypass using auto-elevated COM object Virtual Factory for DiagCpl
        // Reference: https://github.com/Wh04m1001/IDiagnosticProfileUAC
        $string1_IDiagnosticProfileUAC_offensive_tool_keyword = "/IDiagnosticProfileUAC" nocase ascii wide
        // Description: UAC bypass using auto-elevated COM object Virtual Factory for DiagCpl
        // Reference: https://github.com/Wh04m1001/IDiagnosticProfileUAC
        $string2_IDiagnosticProfileUAC_offensive_tool_keyword = /\\IDiagnosticProfileUAC/ nocase ascii wide
        // Description: UAC bypass using auto-elevated COM object Virtual Factory for DiagCpl
        // Reference: https://github.com/Wh04m1001/IDiagnosticProfileUAC
        $string3_IDiagnosticProfileUAC_offensive_tool_keyword = /C\:\\Uac\\results\.cab/ nocase ascii wide
        // Description: UAC bypass using auto-elevated COM object Virtual Factory for DiagCpl
        // Reference: https://github.com/Wh04m1001/IDiagnosticProfileUAC
        $string4_IDiagnosticProfileUAC_offensive_tool_keyword = /IDiagnosticProfileUAC\.git/ nocase ascii wide
        // Description: UAC bypass using auto-elevated COM object Virtual Factory for DiagCpl
        // Reference: https://github.com/Wh04m1001/IDiagnosticProfileUAC
        $string5_IDiagnosticProfileUAC_offensive_tool_keyword = "IDiagnosticProfileUAC-main" nocase ascii wide

    condition:
        any of them
}


rule rule_IEPassView_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'IEPassView' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
