rule rule_catphish_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'catphish' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "catphish"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Generate similar-looking domains for phishing attacks. Check expired domains and their categorized domain status to evade proxy categorization. Whitelisted domains are perfect for your C2 servers. Perfect for Red Team engagements.
        // Reference: https://github.com/ring0lab/catphish
        $string1_catphish_offensive_tool_keyword = /catphish\.rb/ nocase ascii wide

    condition:
        any of them
}


rule rule_catspin_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'catspin' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "catspin"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string1_catspin_offensive_tool_keyword = /\scatspin\.sh\s/
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string2_catspin_offensive_tool_keyword = /\sfile\:\/\/catspin\.yaml\s/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string3_catspin_offensive_tool_keyword = " --stack-name catspin " nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string4_catspin_offensive_tool_keyword = /\/catspin\.git/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string5_catspin_offensive_tool_keyword = "/catspin-main/" nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string6_catspin_offensive_tool_keyword = /\/execute\-api\.eu\-central\-1\.amazonaws\.com\/catspin_deployed/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string7_catspin_offensive_tool_keyword = /\[\+\]\sUse\s\-info\sto\sget\sstack\sstatus\sand\sthe\senpoint\surl\sof\scatspin/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string8_catspin_offensive_tool_keyword = /\[\+\]\sYou\sspin\smy\sgato\sround\sright\sround\s\?/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string9_catspin_offensive_tool_keyword = /\\catspin\-main\\/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string10_catspin_offensive_tool_keyword = /catspin\.sh\shttp/
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string11_catspin_offensive_tool_keyword = /catspin\.sh\s\-info/
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string12_catspin_offensive_tool_keyword = /catspin\.sh\s\-kill/
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string13_catspin_offensive_tool_keyword = /catspin\.sh\s\-run\s/
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string14_catspin_offensive_tool_keyword = /catspin_for_readme\.mp4/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string15_catspin_offensive_tool_keyword = /catspin_poc\.mp4/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string16_catspin_offensive_tool_keyword = /catspin_poc_final\.mp4/ nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string17_catspin_offensive_tool_keyword = "rootcathacking/catspin" nocase ascii wide
        // Description: Catspin rotates the IP address of HTTP requests making IP based blocks or slowdown measures ineffective. It is based on AWS API Gateway and deployed via AWS Cloudformation.
        // Reference: https://github.com/rootcathacking/catspin
        $string18_catspin_offensive_tool_keyword = "Spins up catspin using Api Gateway proxy" nocase ascii wide

    condition:
        any of them
}


rule rule_ccmpwn_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ccmpwn' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ccmpwn"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string1_ccmpwn_offensive_tool_keyword = /\sccmpwn\.py/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string2_ccmpwn_offensive_tool_keyword = /\sexec\s\-dll\s.{0,1000}\.dll\s\-config\s.{0,1000}\.config/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string3_ccmpwn_offensive_tool_keyword = /\.py\s.{0,1000}\scoerce\s\-computer\s/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string4_ccmpwn_offensive_tool_keyword = /\/ccmpwn\.git/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string5_ccmpwn_offensive_tool_keyword = /\/ccmpwn\.py/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string6_ccmpwn_offensive_tool_keyword = /\\ccmpwn\.py/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string7_ccmpwn_offensive_tool_keyword = /\\ccmpwn\\/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string8_ccmpwn_offensive_tool_keyword = /\\http_SCNotification\.exe/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string9_ccmpwn_offensive_tool_keyword = /\\smb_SCNotification\.exe/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string10_ccmpwn_offensive_tool_keyword = "5c611fb030683dba08662997836b3b308c0278130bf2eee6ac6af6a4332285fe" nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string11_ccmpwn_offensive_tool_keyword = "CcmExec might not be installed on target" nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string12_ccmpwn_offensive_tool_keyword = /CcmExec\sservice\snot\saccessible\son\sremote\ssystem\!\s\:\(/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string13_ccmpwn_offensive_tool_keyword = /Downloading\soriginal\sSCNotification\.exe\.config\svia\sSMB/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string14_ccmpwn_offensive_tool_keyword = /impacket\.dcerpc/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string15_ccmpwn_offensive_tool_keyword = "mandiant/ccmpwn" nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string16_ccmpwn_offensive_tool_keyword = /SCNotification\.exe\.config\.malicious/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string17_ccmpwn_offensive_tool_keyword = /smbclient\.getFile\(\'C\$\'\,\s\'Windows\/CCM\/SCNotification\.exe\.config/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string18_ccmpwn_offensive_tool_keyword = /Starting\sCcmExec\sservice\.\sWait\saround\s30\sseconds\sfor\sSCNotification\.exe\sto\srun\sconfig\sfile/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string19_ccmpwn_offensive_tool_keyword = /templates\/http_SCNotification\.exe/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string20_ccmpwn_offensive_tool_keyword = /templates\/smb_SCNotification\.exe/ nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string21_ccmpwn_offensive_tool_keyword = "Uploading malicious DLL via SMB" nocase ascii wide
        // Description: Lateral Movement script that leverages the CcmExec service to remotely hijack user sessions
        // Reference: https://github.com/mandiant/ccmpwn
        $string22_ccmpwn_offensive_tool_keyword = /Uploading\smalicious\sSCNotification\.exe\.config\svia\sSMB/ nocase ascii wide

    condition:
        any of them
}


