        tool = "pentest-machine"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Automates some pentesting work via an nmap XML file. As soon as each command finishes it writes its output to the terminal and the files in output-by-service/ and output-by-host/. Runs fast-returning commands first. Please send me protocols/commands/options that you would like to see included.
        // Reference: https://github.com/DanMcInerney/pentest-machine
        $string1_pentest_machine_offensive_tool_keyword = "pentest-machine" nocase ascii wide

    condition:
        any of them
}


