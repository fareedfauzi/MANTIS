}


rule rule_echo_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'echo' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "echo"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: Detects the use of getsystem Meterpreter/Cobalt Strike command. Getsystem is used to elevate privilege to SYSTEM account.
        // Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/win_meterpreter_or_cobaltstrike_getsystem_service_start.yml
        $string1_echo_greyware_tool_keyword = /\%COMSPEC\%.{0,1000}echo.{0,1000}\\pipe\\/ nocase ascii wide
        // Description: Detects the use of getsystem Meterpreter/Cobalt Strike command. Getsystem is used to elevate privilege to SYSTEM account
        // Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/win_meterpreter_or_cobaltstrike_getsystem_service_start.yml
        $string2_echo_greyware_tool_keyword = /cmd.{0,1000}echo.{0,1000}\\pipe\\/ nocase ascii wide
        // Description: Adversaries may attempt to test echo command after exploitation
        // Reference: N/A
        $string3_echo_greyware_tool_keyword = /cmd\.exe\s\s\/S\s\/D\s\/c.{0,1000}\secho\s123/ nocase ascii wide
        // Description: alternative to whoami
        // Reference: N/A
        $string4_echo_greyware_tool_keyword = /cmd\.exe\s\/c\secho\s\%username\%/ nocase ascii wide
        // Description: potential malleable Cobalt Strike profiles behavior
        // Reference: https://github.com/IcebreakerSecurity/DelegationBOF
        $string5_echo_greyware_tool_keyword = /cmd\.exe\s\/c\secho\s.{0,1000}\s\>\s\\\\\.\\pipe\\/ nocase ascii wide
        // Description: Named pipe impersonation
        // Reference: https://thedfirreport.com/2023/04/03/malicious-iso-file-leads-to-domain-wide-ransomware/
        $string6_echo_greyware_tool_keyword = /cmd\.exe\s\/c\secho\s.{0,1000}\s\>\s\\\\\.\\pipe\\/ nocase ascii wide
        // Description: covering history tracks on linux system
        // Reference: https://rosesecurity.gitbook.io/red-teaming-ttps/linux
        $string7_echo_greyware_tool_keyword = /echo\s\'\'\'\'\s\-\/\.bash\shistory/
        // Description: delete bash history
        // Reference: N/A
        $string8_echo_greyware_tool_keyword = /echo\s\'\'\s\>\s\~\/\.bash_history/
        // Description: covering history tracks on linux system
        // Reference: https://rosesecurity.gitbook.io/red-teaming-ttps/linux
        $string9_echo_greyware_tool_keyword = /echo\s\\"\\"\s\>\s\/var\/log\/auth\.log\s/
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string10_echo_greyware_tool_keyword = "echo \"\" > /var/log/cron"
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string11_echo_greyware_tool_keyword = "echo \"\" > /var/log/secure"
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string12_echo_greyware_tool_keyword = "echo \"\" > /var/log/wtmp"
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string13_echo_greyware_tool_keyword = "echo \"\" > /var/spool/mail/root"
        // Description: writing an ASPX file to C:\inetpub\wwwroot\ (potential Web shell deployment)
        // Reference: N/A
        $string14_echo_greyware_tool_keyword = /echo\s\>\sC\:\\inetpub\\wwwroot\\.{0,1000}\\.{0,1000}\.aspx/ nocase ascii wide
        // Description: This command disables kprobes by writing '0' to the enabled file. Kprobes are dynamic breakpoints in the Linux kernel that can be used to intercept functions and gather information for debugging or monitoring.
        // Reference: N/A
        $string15_echo_greyware_tool_keyword = "echo 0 > /sys/kernel/debug/kprobes/enabled"
        // Description: This command turns off tracing for a specific instance
        // Reference: N/A
        $string16_echo_greyware_tool_keyword = /echo\s0\s\>\s\/sys\/kernel\/debug\/tracing\/instances\/\$.{0,1000}\/tracing_on/
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string17_echo_greyware_tool_keyword = "echo 0 > /var/log/cron"
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string18_echo_greyware_tool_keyword = "echo 0 > /var/log/secure"
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string19_echo_greyware_tool_keyword = "echo 0 > /var/log/wtmp"
        // Description: clearing logs to cover traces
        // Reference: N/A
        $string20_echo_greyware_tool_keyword = "echo 0 > /var/spool/mail/root"
        // Description: linux command abused by attacker
        // Reference: N/A
        $string21_echo_greyware_tool_keyword = /echo\s\'set\s\+o\shistory\'\s\>\>\s\/etc\/profile/

    condition:
        any of them
}


rule rule_EHORUS_RMM_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'EHORUS RMM' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "EHORUS RMM"
        rule_category = "greyware_tool_keyword"

    strings:
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string1_EHORUS_RMM_greyware_tool_keyword = "\"appName\":\"eHorus Agent\"" nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string2_EHORUS_RMM_greyware_tool_keyword = /\$EHORUS_HOME\/\.vnc\/passwd/
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string3_EHORUS_RMM_greyware_tool_keyword = "/ehorus_agent_installer-" nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string4_EHORUS_RMM_greyware_tool_keyword = "/etc/ehorus/ehorus_agent"
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string5_EHORUS_RMM_greyware_tool_keyword = /\/etc\/init\.d\/ehorus_agent_daemon/
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string6_EHORUS_RMM_greyware_tool_keyword = "/usr/bin/ehorus_agent"
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string7_EHORUS_RMM_greyware_tool_keyword = "/usr/sbin/userdel -r ehorus"
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string8_EHORUS_RMM_greyware_tool_keyword = "/usr/share/ehorus"
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string9_EHORUS_RMM_greyware_tool_keyword = /\/var\/log\/ehorus_agent\.log/
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string10_EHORUS_RMM_greyware_tool_keyword = /\\eHorus\sAgent\sMenu\.lnk/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string11_EHORUS_RMM_greyware_tool_keyword = /\\eHorus\sAgent\.lnk/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string12_EHORUS_RMM_greyware_tool_keyword = /\\ehorus\sstandalone\.exe/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string13_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_agent\.conf/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string14_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_agent\.exe/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string15_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_agent\.log/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string16_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_agent_disconn\.log/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string17_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_cmd\.exe/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string18_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_display\.exe/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string19_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_installer_windows\-/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string20_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_launcher\.exe/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string21_EHORUS_RMM_greyware_tool_keyword = /\\ehorus_uit\.exe/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string22_EHORUS_RMM_greyware_tool_keyword = /\\eHorusMsiCustomActions\.dll/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string23_EHORUS_RMM_greyware_tool_keyword = /\\Microsoft\\Windows\\Start\sMenu\\Programs\\eHorus\sAgent\\/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string24_EHORUS_RMM_greyware_tool_keyword = /\\Program\sFiles\\ehorus_agent\\/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string25_EHORUS_RMM_greyware_tool_keyword = /\\SOFTWARE\\eHorusDispl\\/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string26_EHORUS_RMM_greyware_tool_keyword = /\\System\\CurrentControlSet\\Services\\ehorus/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string27_EHORUS_RMM_greyware_tool_keyword = /\\System\\CurrentControlSet\\Services\\EHORUSAGENT/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string28_EHORUS_RMM_greyware_tool_keyword = ">eHorus Agent Setup<" nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string29_EHORUS_RMM_greyware_tool_keyword = ">EHORUSAGENT<" nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string30_EHORUS_RMM_greyware_tool_keyword = "chsh -s /bin/false ehorus"
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string31_EHORUS_RMM_greyware_tool_keyword = "ehorus_agent -f /etc/ehorus/"
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string32_EHORUS_RMM_greyware_tool_keyword = /https\:\/\/portal\.ehorus\.com\/\#\/agents\// nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string33_EHORUS_RMM_greyware_tool_keyword = /hub\.ehorus\.com/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string34_EHORUS_RMM_greyware_tool_keyword = "sc delete ehorus" nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string35_EHORUS_RMM_greyware_tool_keyword = "sc stop ehorus" nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string36_EHORUS_RMM_greyware_tool_keyword = "su ehorus -s /bin/bash -c \"kill -9 -1\""
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string37_EHORUS_RMM_greyware_tool_keyword = /switch\.ehorus\.com/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string38_EHORUS_RMM_greyware_tool_keyword = /taskkill\s\/F\s\/IM\s\\"ehorus_agent\.exe\\"/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string39_EHORUS_RMM_greyware_tool_keyword = /taskkill\s\/F\s\/IM\s\\"ehorus_cmd\.exe\\"/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string40_EHORUS_RMM_greyware_tool_keyword = /taskkill\s\/F\s\/IM\s\\"ehorus_display\.exe\\"/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string41_EHORUS_RMM_greyware_tool_keyword = /umount\s\/usr\/share\/ehorus\/\.gvfs\s\-r\s\>\/dev\/null\s2\>\&1/ nocase ascii wide
        // Description: Pandora RC (formerly called eHorus) is a computer management system for MS Windows - Linux and MacOS that allows access to registered computers wherever they are from a browser without direct connectivity to their devices from the outside. (server based on VNC)
        // Reference: https://pandorafms.com/en/remote-control/
        $string42_EHORUS_RMM_greyware_tool_keyword = /useradd\s\-d\s\/usr\/share\/ehorus\s\-p\s.{0,1000}\sehorus/ nocase ascii wide

    condition:
        any of them
}


