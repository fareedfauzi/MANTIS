        // Reference: https://github.com/alex-sector/dns2tcp
        $string2_dns2tcp_offensive_tool_keyword = /\/\.dns2tcprc/
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string3_dns2tcp_offensive_tool_keyword = "/debian/dns2tcp"
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string4_dns2tcp_offensive_tool_keyword = /\/dns2tcp\.git/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string5_dns2tcp_offensive_tool_keyword = "/dns2tcp/client/"
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string6_dns2tcp_offensive_tool_keyword = "/dns2tcp/common/"
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string7_dns2tcp_offensive_tool_keyword = "/dns2tcp/server"
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string8_dns2tcp_offensive_tool_keyword = "/root/dns2tcp"
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string9_dns2tcp_offensive_tool_keyword = /\\\\\.\\pipe\\win\-sux\-no\-async\-anon\-pipe\-.{0,1000}\-/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string10_dns2tcp_offensive_tool_keyword = /\\dns2tcp\\/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string11_dns2tcp_offensive_tool_keyword = /\\dns2tcp\\server/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string12_dns2tcp_offensive_tool_keyword = /\\dns2tcp\-0\./ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string13_dns2tcp_offensive_tool_keyword = "alex-sector/dns2tcp" nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string14_dns2tcp_offensive_tool_keyword = "apt install dns2tcp" nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string15_dns2tcp_offensive_tool_keyword = /dns2tcp\-.{0,1000}\.zip/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string16_dns2tcp_offensive_tool_keyword = /dns2tcp\.exe/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string17_dns2tcp_offensive_tool_keyword = /dns2tcp\.hsc\.fr/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string18_dns2tcp_offensive_tool_keyword = /dns2tcp\.kali\.org/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string19_dns2tcp_offensive_tool_keyword = /dns2tcp\.pid/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string20_dns2tcp_offensive_tool_keyword = "dns2tcpc -z " nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string21_dns2tcp_offensive_tool_keyword = /dns2tcpc\.exe/ nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string22_dns2tcp_offensive_tool_keyword = "dns2tcpd --" nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string23_dns2tcp_offensive_tool_keyword = "dns2tcpd -f " nocase ascii wide
        // Description: Dns2tcp is a tool for relaying TCP connections over DNS
        // Reference: https://github.com/alex-sector/dns2tcp
        $string24_dns2tcp_offensive_tool_keyword = "dns2tcp-master" nocase ascii wide

    condition:
        any of them
}


rule rule_dnscan_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnscan' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnscan"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string1_dnscan_offensive_tool_keyword = /\sdnscan\.py/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string2_dnscan_offensive_tool_keyword = /\/dnscan\.git/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string3_dnscan_offensive_tool_keyword = /\/dnscan\.py/
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string4_dnscan_offensive_tool_keyword = /\/subdomains\.txt/
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string5_dnscan_offensive_tool_keyword = /\\dnscan\.py/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string6_dnscan_offensive_tool_keyword = "dnscan-master" nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string7_dnscan_offensive_tool_keyword = "rbsec/dnscan" nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string8_dnscan_offensive_tool_keyword = /subdomains\-100\.txt/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string9_dnscan_offensive_tool_keyword = /subdomains\-1000\.txt/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string10_dnscan_offensive_tool_keyword = /subdomains\-10000\.txt/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string11_dnscan_offensive_tool_keyword = /subdomains\-500\.txt/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string12_dnscan_offensive_tool_keyword = /subdomains\-uk\-1000\.txt/ nocase ascii wide
        // Description: dnscan is a python wordlist-based DNS subdomain scanner.
        // Reference: https://github.com/rbsec/dnscan
        $string13_dnscan_offensive_tool_keyword = /subdomains\-uk\-500\.txt/ nocase ascii wide

    condition:
        any of them
}


rule rule_dnscat_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnscat' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnscat"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string1_dnscat_offensive_tool_keyword = /\s\-\-dns\sdomain\=skullseclabs\.org/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string2_dnscat_offensive_tool_keyword = /\.\/dnscat/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string3_dnscat_offensive_tool_keyword = /\/dnscat\.c/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string4_dnscat_offensive_tool_keyword = /\/dnscat2\.git/ nocase ascii wide
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string5_dnscat_offensive_tool_keyword = /0\.0\.0\.0\:53531/ nocase ascii wide
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string6_dnscat_offensive_tool_keyword = /127\.0\.0\.1\:53531/ nocase ascii wide
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string7_dnscat_offensive_tool_keyword = /data\/wordlist_256\.txt/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string8_dnscat_offensive_tool_keyword = "dnscat -"
        // Description: Welcome to dnscat2. a DNS tunnel that WON'T make you sick and kill you This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol. which is an effective tunnel out of almost every network.
        // Reference: https://github.com/iagox86/dnscat2
        $string9_dnscat_offensive_tool_keyword = "dnscat --dns "
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string10_dnscat_offensive_tool_keyword = "dnscat tcpcat"
        // Description: Welcome to dnscat2. a DNS tunnel that WON'T make you sick and kill you This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol. which is an effective tunnel out of almost every network.
        // Reference: https://github.com/iagox86/dnscat2
        $string11_dnscat_offensive_tool_keyword = "dnscat"
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string12_dnscat_offensive_tool_keyword = /dnscat2.{0,1000}\.tar\.bz2/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string13_dnscat_offensive_tool_keyword = /dnscat2\-.{0,1000}\.zip/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string14_dnscat_offensive_tool_keyword = /dnscat2\./
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string15_dnscat_offensive_tool_keyword = "dnscat2/"
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string16_dnscat_offensive_tool_keyword = "dnscat2-server" nocase ascii wide
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string17_dnscat_offensive_tool_keyword = /dnscat2\-win32\.exe/ nocase ascii wide
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string18_dnscat_offensive_tool_keyword = /dnsmastermind\.rb/
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string19_dnscat_offensive_tool_keyword = "localhost:53531"
        // Description: This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol
        // Reference: https://github.com/iagox86/dnscat2
        $string20_dnscat_offensive_tool_keyword = /server\=.{0,1000}port\=53531/

    condition:
        any of them
}


rule rule_dnschef_ng_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnschef-ng' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnschef-ng"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string1_dnschef_ng_offensive_tool_keyword = /\sdnschef\.exe/ nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string2_dnschef_ng_offensive_tool_keyword = /\sdnschef\.py/ nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string3_dnschef_ng_offensive_tool_keyword = /\s\-\-fakealias\swww\.fake\.com/ nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string4_dnschef_ng_offensive_tool_keyword = " --fakedomains " nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string5_dnschef_ng_offensive_tool_keyword = " --fakeip " nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string6_dnschef_ng_offensive_tool_keyword = " --fakeipv6 " nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string7_dnschef_ng_offensive_tool_keyword = " --fakemail " nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
        $string8_dnschef_ng_offensive_tool_keyword = /\/dnschef\.exe/ nocase ascii wide
        // Description: DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka "Fake DNS") is a tool used for application network traffic analysis among other uses. For example - a DNS proxy can be used to fake requests for "badguy.com" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.
        // Reference: https://github.com/byt3bl33d3r/dnschef-ng
