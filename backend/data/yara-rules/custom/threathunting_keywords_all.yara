rule rule_HEKATOMB_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'HEKATOMB' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "HEKATOMB"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string1_HEKATOMB_offensive_tool_keyword = " install hekatomb" nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string2_HEKATOMB_offensive_tool_keyword = /\.py\s.{0,1000}\s\-debug\s\-dnstcp/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string3_HEKATOMB_offensive_tool_keyword = /\/exported_credentials\.csv/
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string4_HEKATOMB_offensive_tool_keyword = /\[\+\]\sConnnecting\sto\sall\scomputers\sand\stry\sto\sget\sdpapi\sblobs\sand\smaster\skey\sfiles/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string5_HEKATOMB_offensive_tool_keyword = /\[\+\]\sScanning\scomputers\slist\son\sSMB\sport\s/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string6_HEKATOMB_offensive_tool_keyword = /\\exported_credentials\.csv/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string7_HEKATOMB_offensive_tool_keyword = "ed9d3ee993fe0a36bb7a7fce3940112ea29eccca58165738a758c58a3fe0ae54" nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string8_HEKATOMB_offensive_tool_keyword = "hekatomb -hashes " nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string9_HEKATOMB_offensive_tool_keyword = /hekatomb\-.{0,1000}\.tar\.gz/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string10_HEKATOMB_offensive_tool_keyword = /hekatomb.{0,1000}\-hashes\s/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string11_HEKATOMB_offensive_tool_keyword = /hekatomb\-.{0,1000}\-py3\-none\-any\.whl/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string12_HEKATOMB_offensive_tool_keyword = /hekatomb\.ad_ldap/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string13_HEKATOMB_offensive_tool_keyword = /hekatomb\@thiefin\.fr/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string14_HEKATOMB_offensive_tool_keyword = "it will extract domain controller private key through RPC uses it to decrypt all credentials" nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string15_HEKATOMB_offensive_tool_keyword = /New\scredentials\sfound\sfor\suser\s.{0,1000}\son\s/ nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string16_HEKATOMB_offensive_tool_keyword = "pacman -S hekatomb" nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/ProcessusT/HEKATOMB
        $string17_HEKATOMB_offensive_tool_keyword = "poetry run hekatomb" nocase ascii wide
        // Description: Hekatomb is a python script that connects to LDAP directory to retrieve all computers and users informations. Then it will download all DPAPI blob of all users from all computers and uses Domain backup keys to decrypt them
        // Reference: https://github.com/Processus-Thief/HEKATOMB
        $string18_HEKATOMB_offensive_tool_keyword = "Processus-Thief/HEKATOMB" nocase ascii wide

    condition:
        any of them
}


rule rule_HellsGate_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'HellsGate' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "HellsGate"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string1_HellsGate_offensive_tool_keyword = /\/HellsGate\.git/ nocase ascii wide
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string2_HellsGate_offensive_tool_keyword = "am0nsec/HellsGate" nocase ascii wide
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string3_HellsGate_offensive_tool_keyword = "DC6187CB-D5DF-4973-84A2-F92AAE90CDA9" nocase ascii wide
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string4_HellsGate_offensive_tool_keyword = /hellsgate\.asm/ nocase ascii wide
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string5_HellsGate_offensive_tool_keyword = /HellsGate\.exe/ nocase ascii wide
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string6_HellsGate_offensive_tool_keyword = /HellsGate\.sln/ nocase ascii wide
        // Description: The Hell's Gate technique is a method employed by malware to hide its malicious behavior and avoid detection. This technique involves executing system calls directly thus bypassing the Windows API (Application Programming Interface) which is typically monitored by EDRs
        // Reference: https://github.com/am0nsec/HellsGate
        $string7_HellsGate_offensive_tool_keyword = /HellsGate\.vcxproj/ nocase ascii wide

    condition:
        any of them
}


rule rule_HellsHall_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'HellsHall' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "HellsHall"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string1_HellsHall_offensive_tool_keyword = /\/HellHall\.git/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string2_HellsHall_offensive_tool_keyword = /\/HellsHall\.exe/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string3_HellsHall_offensive_tool_keyword = /\[\#\]\s\[HELL\sHALL\]\sPress\s\<Enter\>\sTo\sQUIT\s\.\.\.\s/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string4_HellsHall_offensive_tool_keyword = /\[\+\]\s\[HELL\sHALL\]\spAddress\s\:\s/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string5_HellsHall_offensive_tool_keyword = /\[i\]\s\[HELL\sHALL\]\sPress\s\<Enter\>\sTo\sRun\s\.\.\.\s/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string6_HellsHall_offensive_tool_keyword = /\\AsmHell\.asm/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string7_HellsHall_offensive_tool_keyword = /\\HellsHall\.c/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string8_HellsHall_offensive_tool_keyword = /\\HellsHall\.exe/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string9_HellsHall_offensive_tool_keyword = /\\HellsHall\.h/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string10_HellsHall_offensive_tool_keyword = "F06EAC7B-6996-4E78-B045-0DF6ED201367" nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string11_HellsHall_offensive_tool_keyword = /HellHall\-main\.zip/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string12_HellsHall_offensive_tool_keyword = /Hell\'sHall\.vcxproj/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string13_HellsHall_offensive_tool_keyword = /Hell\'sHall\-Clang\&NoCrt\.zip/ nocase ascii wide
        // Description: Performing Indirect Clean Syscalls
        // Reference: https://github.com/Maldev-Academy/HellHall
        $string14_HellsHall_offensive_tool_keyword = "Maldev-Academy/HellHall" nocase ascii wide

    condition:
        any of them
}


