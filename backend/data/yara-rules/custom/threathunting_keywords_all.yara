        // Reference: https://bruteratel.com/
        $string6_bruteratel_offensive_tool_keyword = /\sStarting\sBadger\sNotification\sHandler\sfor\s\%s\s\=\>\s\{LHOST\}\:\{LPORT\}/ nocase ascii wide
