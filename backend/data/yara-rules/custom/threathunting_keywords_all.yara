        $string1_recon_archy_offensive_tool_keyword = /\/recon\-archy\.git/ nocase ascii wide
        // Description: Linkedin Tools to reconstruct a company hierarchy from scraping relations and jobs title
        // Reference: https://github.com/shadawck/recon-archy
        $string2_recon_archy_offensive_tool_keyword = "recon-archy analyse" nocase ascii wide
        // Description: Linkedin Tools to reconstruct a company hierarchy from scraping relations and jobs title
        // Reference: https://github.com/shadawck/recon-archy
        $string3_recon_archy_offensive_tool_keyword = "recon-archy build" nocase ascii wide
        // Description: Linkedin Tools to reconstruct a company hierarchy from scraping relations and jobs title
        // Reference: https://github.com/shadawck/recon-archy
        $string4_recon_archy_offensive_tool_keyword = "recon-archy crawl" nocase ascii wide
        // Description: Linkedin Tools to reconstruct a company hierarchy from scraping relations and jobs title
        // Reference: https://github.com/shadawck/recon-archy
        $string5_recon_archy_offensive_tool_keyword = "recon-archy-master" nocase ascii wide
        // Description: Linkedin Tools to reconstruct a company hierarchy from scraping relations and jobs title
        // Reference: https://github.com/shadawck/recon-archy
        $string6_recon_archy_offensive_tool_keyword = "remiflavien1/recon-archy" nocase ascii wide
        // Description: Linkedin Tools to reconstruct a company hierarchy from scraping relations and jobs title
        // Reference: https://github.com/shadawck/recon-archy
        $string7_recon_archy_offensive_tool_keyword = "shadawck/recon-archy" nocase ascii wide

    condition:
        any of them
}


rule rule_reconftw_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'reconftw' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "reconftw"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string1_reconftw_offensive_tool_keyword = " -mc all -fc 404 -sf -noninteractive -of json"
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string2_reconftw_offensive_tool_keyword = /\s\-\-private\-key\sterraform\-keys\sreconFTW\.yml/
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string3_reconftw_offensive_tool_keyword = " reconFTW installer/updater script "
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string4_reconftw_offensive_tool_keyword = /\sreconftw\.sh\s/
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string5_reconftw_offensive_tool_keyword = " --top-ports 200 -sV -n -Pn --open --max-retries 2 --script vulners"
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string6_reconftw_offensive_tool_keyword = /\/fuzz_wordlist\.txt/
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
        $string7_reconftw_offensive_tool_keyword = /\/n0kovo_subdomains_huge\.txt/
        // Description: reconFTW is a tool designed to perform automated recon on a target domain by running the best set of tools to perform scanning and finding out vulnerabilities
        // Reference: https://github.com/six2dez/reconftw
