        // Description: PSAttack contains over 100 commands for Privilege Escalation - Recon and Data Exfilitration
        // Reference: https://github.com/GDSSecurity/PSAttack
        $string61_PSAttack_offensive_tool_keyword = /PowerView\.ps1/ nocase ascii wide
        // Description: PS>Attack combines some of the best projects in the infosec powershell community into a self contained custom PowerShell console. Its designed to make it easy to use PowerShell offensively and to evade antivirus and Incident Response teams. It does this with in a couple of ways.
        // Reference: https://github.com/jaredhaight/PSAttack
        $string62_PSAttack_offensive_tool_keyword = "PSAttack" nocase ascii wide
        // Description: PSAttack contains over 100 commands for Privilege Escalation - Recon and Data Exfilitration
        // Reference: https://github.com/GDSSecurity/PSAttack
        $string63_PSAttack_offensive_tool_keyword = /PSAttack\.exe/ nocase ascii wide
        // Description: PSAttack contains over 100 commands for Privilege Escalation - Recon and Data Exfilitration
        // Reference: https://github.com/GDSSecurity/PSAttack
        $string64_PSAttack_offensive_tool_keyword = /PSAttack\.Resources\.BuildDate\.txt/ nocase ascii wide
        // Description: PSAttack contains over 100 commands for Privilege Escalation - Recon and Data Exfilitration
        // Reference: https://github.com/GDSSecurity/PSAttack
        $string65_PSAttack_offensive_tool_keyword = /VolumeShadowCopyTools\.ps1/ nocase ascii wide

    condition:
        any of them
}


rule rule_PSBits_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PSBits' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PSBits"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Simple tool enabling all privileges in the parent process (usually cmd.exe) token. Useful if you have SeBackup or SeRestore and need a cmd.exe ignoring all ACLs
        // Reference: https://github.com/gtworek/PSBits/tree/master/EnableAllParentPrivileges
        $string1_PSBits_offensive_tool_keyword = /EnableAllParentPrivileges\.c/ nocase ascii wide
        // Description: Simple tool enabling all privileges in the parent process (usually cmd.exe) token. Useful if you have SeBackup or SeRestore and need a cmd.exe ignoring all ACLs
        // Reference: https://github.com/gtworek/PSBits/tree/master/EnableAllParentPrivileges
        $string2_PSBits_offensive_tool_keyword = /EnableAllParentPrivileges\.exe/ nocase ascii wide

    condition:
        any of them
}


