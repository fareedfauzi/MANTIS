        $string176_evilginx2_offensive_tool_keyword = /phishDomain\s\=\sphishDomain\s\+/ nocase ascii wide
        // Description: Standalone man-in-the-middle attack framework used for phishing login credentials along with session cookies allowing for the bypass of 2-factor authentication
        // Reference: https://github.com/kgretzky/evilginx2
        $string177_evilginx2_offensive_tool_keyword = "TARGET=evilginx" nocase ascii wide
        // Description: Standalone man-in-the-middle attack framework used for phishing login credentials along with session cookies allowing for the bypass of 2-factor authentication
        // Reference: https://github.com/An0nUD4Y/evilginx2
        $string178_evilginx2_offensive_tool_keyword = /This\sis\sthe\smodified\smaintained\sversion\sof\sEvilginx2\.\sNo\sone\swill\sbe\sheld\sresponsible\sfor\syour\sactivities/ nocase ascii wide
        // Description: Standalone man-in-the-middle attack framework used for phishing login credentials along with session cookies allowing for the bypass of 2-factor authentication
        // Reference: https://github.com/kgretzky/evilginx2
        $string179_evilginx2_offensive_tool_keyword = /this\.is\.not\.a\.phishing\.site\.evilsite\.com/ nocase ascii wide
        // Description: Standalone man-in-the-middle attack framework used for phishing login credentials along with session cookies allowing for the bypass of 2-factor authentication
        // Reference: https://github.com/kgretzky/evilginx2
        $string180_evilginx2_offensive_tool_keyword = "X-Evilginx" nocase ascii wide
        // Description: Standalone man-in-the-middle attack framework used for phishing login credentials along with session cookies allowing for the bypass of 2-factor authentication
        // Reference: https://github.com/kgretzky/evilginx2
        $string181_evilginx2_offensive_tool_keyword = "you need to provide the path to directory where your phishlets are stored:" nocase ascii wide

    condition:
        any of them
}


rule rule_evilgrade_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'evilgrade' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "evilgrade"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Evilgrade is a modular framework that allows the user to take advantage of poor upgrade implementations by injecting fake updates. It comes with pre-made binaries (agents). a working default configuration for fast pentests. and has its own WebServer and DNSServer modules. Easy to set up new settings. and has an autoconfiguration when new binary agents are set
        // Reference: https://github.com/infobyte/evilgrade
        $string1_evilgrade_offensive_tool_keyword = "evilgrade" nocase ascii wide

    condition:
        any of them
}


rule rule_EvilLsassTwin_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'EvilLsassTwin' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "EvilLsassTwin"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: attempt to duplicate open handles to LSASS. If this fails it will obtain a handle to LSASS through the NtGetNextProcess function instead of OpenProcess/NtOpenProcess.
        // Reference: https://github.com/RePRGM/Nimperiments/tree/main/EvilLsassTwin
        $string1_EvilLsassTwin_offensive_tool_keyword = " EvilTwinServer " nocase ascii wide
        // Description: Dumping lsass
        // Reference: https://github.com/RePRGM/Nimperiments/tree/main/EvilLsassTwin
        $string2_EvilLsassTwin_offensive_tool_keyword = "/EvilLsassTwin" nocase ascii wide
        // Description: attempt to duplicate open handles to LSASS. If this fails it will obtain a handle to LSASS through the NtGetNextProcess function instead of OpenProcess/NtOpenProcess.
        // Reference: https://github.com/RePRGM/Nimperiments/tree/main/EvilLsassTwin
        $string3_EvilLsassTwin_offensive_tool_keyword = "/EvilLsassTwin/" nocase ascii wide
        // Description: attempt to duplicate open handles to LSASS. If this fails it will obtain a handle to LSASS through the NtGetNextProcess function instead of OpenProcess/NtOpenProcess.
        // Reference: https://github.com/RePRGM/Nimperiments/tree/main/EvilLsassTwin
