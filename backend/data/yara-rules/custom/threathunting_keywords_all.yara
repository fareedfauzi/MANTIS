        $string38_xmrig_greyware_tool_keyword = /c3pool_miner\.service/ nocase ascii wide
        // Description: Auto setup scripts and pre-compiled xmr miner for c3pool.com pool
        // Reference: https://github.com/C3Pool/xmrig_setup/
