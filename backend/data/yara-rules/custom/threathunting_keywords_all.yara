        // Description: Use Invoke-BloodHound from SharpHound.ps1 or use SharpHound.exe. Both can be run reflectively. Examples below use the PowerShell variant but arguments are identical.
        // Reference: https://github.com/BloodHoundAD/BloodHound/tree/master/Collectors
        $string301_BloodHound_offensive_tool_keyword = "fffaec6a59c6d0b368fd980414500ffeb17f3155ec3353f679dfc6caf392ce84" nocase ascii wide
        // Description: A Python based ingestor for BloodHound
        // Reference: https://github.com/fox-it/BloodHound.py
        $string302_BloodHound_offensive_tool_keyword = "fox-it/BloodHound" nocase ascii wide
        // Description: Kerberoasting With PowerView
        // Reference: https://github.com/BloodHoundAD/BloodHound/tree/master/Collectors
        $string303_BloodHound_offensive_tool_keyword = "Get-DomainSPNTicket" nocase ascii wide
        // Description: Use Invoke-BloodHound from SharpHound.ps1 or use SharpHound.exe. Both can be run reflectively. Examples below use the PowerShell variant but arguments are identical.
        // Reference: https://github.com/BloodHoundAD/BloodHound/tree/master/Collectors
        $string304_BloodHound_offensive_tool_keyword = /GMSAPasswordReader\.exe\s\-\-/ nocase ascii wide
        // Description: A Python based ingestor for BloodHound
        // Reference: https://github.com/fox-it/BloodHound.py
        $string305_BloodHound_offensive_tool_keyword = /http\:\/\/127\.0\.0\.1\:7474\/browser\// nocase ascii wide
        // Description: A Python based ingestor for BloodHound
        // Reference: https://github.com/fox-it/BloodHound.py
        $string306_BloodHound_offensive_tool_keyword = "http://localhost:7474/browser/" nocase ascii wide
        // Description: Use Invoke-BloodHound from SharpHound.ps1 or use SharpHound.exe. Both can be run reflectively. Examples below use the PowerShell variant but arguments are identical.
        // Reference: https://github.com/BloodHoundAD/BloodHound/tree/master/Collectors
        $string307_BloodHound_offensive_tool_keyword = /https\:\/\/bloodhound\.readthedocs\.io\/en\/latest\/index\.html/ nocase ascii wide
        // Description: A Python based ingestor for BloodHound
        // Reference: https://github.com/fox-it/BloodHound.py
        $string308_BloodHound_offensive_tool_keyword = "install bloodhound" nocase ascii wide
        // Description: Use Invoke-BloodHound from SharpHound.ps1 or use SharpHound.exe. Both can be run reflectively. Examples below use the PowerShell variant but arguments are identical.
        // Reference: https://github.com/BloodHoundAD/BloodHound/tree/master/Collectors
        $string309_BloodHound_offensive_tool_keyword = "Invoke-BloodHound" nocase ascii wide
        // Description: Use Invoke-BloodHound from SharpHound.ps1 or use SharpHound.exe. Both can be run reflectively. Examples below use the PowerShell variant but arguments are identical.
        // Reference: https://github.com/BloodHoundAD/BloodHound/tree/master/Collectors
        $string310_BloodHound_offensive_tool_keyword = "Invoke-SQLOSCmdAgentJob -Verbose -SubSystem " nocase ascii wide
        // Description: BloodHound is a single page Javascript web application. built on top of Linkurious. compiled with Electron. with a Neo4j database fed by a C# data collector. BloodHound uses graph theory to reveal the hidden and often unintended relationships within an Active Directory environment. Attackers can use BloodHound to easily identify highly complex attack paths that would otherwise be impossible to quickly identify. Defenders can use BloodHound to identify and eliminate those same attack paths. Both blue and red teams can use BloodHound to easily gain a deeper understanding of privilege relationships in an Active Directory environment
        // Reference: https://github.com/BloodHoundAD/BloodHound
        $string311_BloodHound_offensive_tool_keyword = /SharpHound\.exe/ nocase ascii wide
        // Description: BloodHound is a single page Javascript web application. built on top of Linkurious. compiled with Electron. with a Neo4j database fed by a C# data collector. BloodHound uses graph theory to reveal the hidden and often unintended relationships within an Active Directory environment. Attackers can use BloodHound to easily identify highly complex attack paths that would otherwise be impossible to quickly identify. Defenders can use BloodHound to identify and eliminate those same attack paths. Both blue and red teams can use BloodHound to easily gain a deeper understanding of privilege relationships in an Active Directory environment
        // Reference: https://github.com/fox-it/BloodHound.py
        $string312_BloodHound_offensive_tool_keyword = "sudo bloodhound"

    condition:
        any of them
}


rule rule_bloodyAD_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bloodyAD' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bloodyAD"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: BloodyAD is an Active Directory Privilege Escalation Framework
        // Reference: https://github.com/CravateRouge/bloodyAD
        $string1_bloodyAD_offensive_tool_keyword = /\/bloodyAD\.git/ nocase ascii wide
        // Description: BloodyAD is an Active Directory Privilege Escalation Framework
        // Reference: https://github.com/CravateRouge/bloodyAD
        $string2_bloodyAD_offensive_tool_keyword = "bloodyAD -" nocase ascii wide
        // Description: BloodyAD is an Active Directory Privilege Escalation Framework
        // Reference: https://github.com/CravateRouge/bloodyAD
        $string3_bloodyAD_offensive_tool_keyword = /bloodyAD\.py/ nocase ascii wide
        // Description: BloodyAD is an Active Directory Privilege Escalation Framework
        // Reference: https://github.com/CravateRouge/bloodyAD
        $string4_bloodyAD_offensive_tool_keyword = "bloodyAD-main" nocase ascii wide
        // Description: BloodyAD is an Active Directory Privilege Escalation Framework
        // Reference: https://github.com/CravateRouge/bloodyAD
        $string5_bloodyAD_offensive_tool_keyword = "CravateRouge/bloodyAD" nocase ascii wide

    condition:
        any of them
}


rule rule_BobTheSmuggler_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'BobTheSmuggler' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "BobTheSmuggler"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string1_BobTheSmuggler_offensive_tool_keyword = /\sSharpHound\.html/ nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string2_BobTheSmuggler_offensive_tool_keyword = /\/BobTheSmuggler\.git/ nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string3_BobTheSmuggler_offensive_tool_keyword = /\\SharpHound\.html/ nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string4_BobTheSmuggler_offensive_tool_keyword = /BobTheSmuggler\.py/ nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string5_BobTheSmuggler_offensive_tool_keyword = "BobTheSmuggler-main" nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string6_BobTheSmuggler_offensive_tool_keyword = "Getting the Obfuscated JS Code" nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string7_BobTheSmuggler_offensive_tool_keyword = "Successfully embedded EXE into GIF" nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string8_BobTheSmuggler_offensive_tool_keyword = "Successfully embedded EXE into PNG" nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string9_BobTheSmuggler_offensive_tool_keyword = "TheCyb3rAlpha/BobTheSmuggler" nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string10_BobTheSmuggler_offensive_tool_keyword = "URL must be provided for GIF embedding!" nocase ascii wide
        // Description: HTML SMUGGLING TOOL 6 allows you to create HTML files with embedded 7z/zip archives. The tool would compress your binary (EXE/DLL) into 7z/zip file format then XOR encrypt the archive and then hides inside PNG/GIF image file format (Image Polyglots)
        // Reference: https://github.com/TheCyb3rAlpha/BobTheSmuggler
        $string11_BobTheSmuggler_offensive_tool_keyword = "URL must be provided for PNG embedding!" nocase ascii wide

    condition:
        any of them
}


rule rule_bof_collection_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bof-collection' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bof-collection"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Collection of Beacon Object Files (BOF) for Cobalt Strike
        // Reference: https://github.com/crypt0p3g/bof-collection
        $string1_bof_collection_offensive_tool_keyword = "chromiumkeydump " nocase ascii wide
        // Description: Collection of Beacon Object Files (BOF) for Cobalt Strike
        // Reference: https://github.com/crypt0p3g/bof-collection
        $string2_bof_collection_offensive_tool_keyword = /ChromiumKeyDump\.cna/ nocase ascii wide
        // Description: Collection of Beacon Object Files (BOF) for Cobalt Strike
        // Reference: https://github.com/crypt0p3g/bof-collection
        $string3_bof_collection_offensive_tool_keyword = /ChromiumKeyDump\.cpp/ nocase ascii wide
        // Description: Collection of Beacon Object Files (BOF) for Cobalt Strike
        // Reference: https://github.com/crypt0p3g/bof-collection
        $string4_bof_collection_offensive_tool_keyword = /ChromiumKeyDump\.exe/ nocase ascii wide
        // Description: Collection of Beacon Object Files (BOF) for Cobalt Strike
        // Reference: https://github.com/crypt0p3g/bof-collection
        $string5_bof_collection_offensive_tool_keyword = "crypt0p3g/bof-collection" nocase ascii wide
        // Description: C# implementation of mimikatz/pypykatz minidump functionality to get credentials from LSASS dumps
        // Reference: https://github.com/cube0x0/MiniDump
        $string6_bof_collection_offensive_tool_keyword = /Minidump\.exe/ nocase ascii wide
        // Description: C# implementation of mimikatz/pypykatz minidump functionality to get credentials from LSASS dumps
        // Reference: https://github.com/cube0x0/MiniDump
        $string7_bof_collection_offensive_tool_keyword = /Minidump\.sln/ nocase ascii wide

    condition:
        any of them
}


rule rule_BOF_NET_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'BOF.NET' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "BOF.NET"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A .NET Runtime for Cobalt Strike's Beacon Object Files
        // Reference: https://github.com/CCob/BOF.NET
        $string1_BOF_NET_offensive_tool_keyword = /BOF\.NET\.git/ nocase ascii wide
        // Description: A .NET Runtime for Cobalt Strike's Beacon Object Files
        // Reference: https://github.com/CCob/BOF.NET
        $string2_BOF_NET_offensive_tool_keyword = /BOF\.NET\-main/ nocase ascii wide

    condition:
        any of them
}


rule rule_bofhound_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bofhound' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bofhound"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string1_bofhound_offensive_tool_keyword = " Brc4LdapSentinelParser" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string2_bofhound_offensive_tool_keyword = " --brute-ratel" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string3_bofhound_offensive_tool_keyword = /\/beacon_202_no_acl\.log/
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string4_bofhound_offensive_tool_keyword = /\/beacon_257\-objects\.log/
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string5_bofhound_offensive_tool_keyword = /\/bloodhound_domain\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string6_bofhound_offensive_tool_keyword = /\/bloodhound_domaintrust\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string7_bofhound_offensive_tool_keyword = /\/bloodhound_gpo\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string8_bofhound_offensive_tool_keyword = /\/bloodhound_object\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string9_bofhound_offensive_tool_keyword = /\/bloodhound_ou\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string10_bofhound_offensive_tool_keyword = /\/bloodhound_schema\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string11_bofhound_offensive_tool_keyword = /\/bofhound\.git/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string12_bofhound_offensive_tool_keyword = /\/ldap_search_bof\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string13_bofhound_offensive_tool_keyword = "/opt/cobaltstrike/logs"
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string14_bofhound_offensive_tool_keyword = /\\ldap_search_bof\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string15_bofhound_offensive_tool_keyword = /badger_no_acl_1030_objects\.log/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string16_bofhound_offensive_tool_keyword = "bofhound --" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string17_bofhound_offensive_tool_keyword = "bofhound -i " nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string18_bofhound_offensive_tool_keyword = "bofhound -o " nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string19_bofhound_offensive_tool_keyword = "bofhound-main" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string20_bofhound_offensive_tool_keyword = /brc4_ldap_sentinel\.py/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string21_bofhound_offensive_tool_keyword = "fortalice/bofhound" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string22_bofhound_offensive_tool_keyword = "from bofhound import " nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string23_bofhound_offensive_tool_keyword = /from\sbofhound\.ad\simport/ nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string24_bofhound_offensive_tool_keyword = "import LdapSearchBofParser" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string25_bofhound_offensive_tool_keyword = "pip3 install bofhound" nocase ascii wide
        // Description: Generate BloodHound compatible JSON from logs written by ldapsearch BOF - pyldapsearch and Brute Ratel's LDAP Sentinel
        // Reference: https://github.com/fortalice/bofhound
        $string26_bofhound_offensive_tool_keyword = "poetry run bofhound" nocase ascii wide

    condition:
        any of them
}


rule rule_BOFMask_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'BOFMask' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "BOFMask"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: BOFMask is a proof-of-concept for masking Cobalt Strike's Beacon payload while executing a Beacon Object File (BOF)
        // Reference: https://github.com/passthehashbrowns/BOFMask
        $string1_BOFMask_offensive_tool_keyword = /\/BOFMask\.git/ nocase ascii wide
        // Description: BOFMask is a proof-of-concept for masking Cobalt Strike's Beacon payload while executing a Beacon Object File (BOF)
        // Reference: https://github.com/passthehashbrowns/BOFMask
        $string2_BOFMask_offensive_tool_keyword = /\/bofmask\.h/ nocase ascii wide
        // Description: BOFMask is a proof-of-concept for masking Cobalt Strike's Beacon payload while executing a Beacon Object File (BOF)
        // Reference: https://github.com/passthehashbrowns/BOFMask
        $string3_BOFMask_offensive_tool_keyword = "BOFMask-main" nocase ascii wide
        // Description: BOFMask is a proof-of-concept for masking Cobalt Strike's Beacon payload while executing a Beacon Object File (BOF)
        // Reference: https://github.com/passthehashbrowns/BOFMask
        $string4_BOFMask_offensive_tool_keyword = /include.{0,1000}bofmask\.h/ nocase ascii wide
        // Description: BOFMask is a proof-of-concept for masking Cobalt Strike's Beacon payload while executing a Beacon Object File (BOF)
        // Reference: https://github.com/passthehashbrowns/BOFMask
        $string5_BOFMask_offensive_tool_keyword = "passthehashbrowns/BOFMask" nocase ascii wide

    condition:
        any of them
}


rule rule_BOINC_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'BOINC' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "BOINC"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Fake BOINC software distributed by discord - mars stealer
        // Reference: https://cyberint.com/wp-content/uploads/2022/02/Mars-Stealer-7.png.webp
        $string1_BOINC_offensive_tool_keyword = /discordapp\.com\/attachments\/.{0,1000}\/BOINCPortable_.{0,1000}\.exe/ nocase ascii wide

    condition:
        any of them
}


rule rule_boko_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'boko' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "boko"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: boko.py is an application scanner for macOS that searches for and identifies potential dylib hijacking and weak dylib vulnerabilities for application executables as well as scripts an application may use that have the potential to be backdoored
        // Reference: https://github.com/bashexplode/boko
        $string1_boko_offensive_tool_keyword = "/bashexplode/boko"
        // Description: boko.py is an application scanner for macOS that searches for and identifies potential dylib hijacking and weak dylib vulnerabilities for application executables as well as scripts an application may use that have the potential to be backdoored
        // Reference: https://github.com/bashexplode/boko
        $string2_boko_offensive_tool_keyword = /\/boko\.py/ nocase ascii wide
        // Description: boko.py is an application scanner for macOS that searches for and identifies potential dylib hijacking and weak dylib vulnerabilities for application executables as well as scripts an application may use that have the potential to be backdoored
        // Reference: https://github.com/bashexplode/boko
        $string3_boko_offensive_tool_keyword = "BackdoorableScript" nocase ascii wide
        // Description: boko.py is an application scanner for macOS that searches for and identifies potential dylib hijacking and weak dylib vulnerabilities for application executables as well as scripts an application may use that have the potential to be backdoored
        // Reference: https://github.com/bashexplode/boko
        $string4_boko_offensive_tool_keyword = /boko\.py\s/ nocase ascii wide
        // Description: boko.py is an application scanner for macOS that searches for and identifies potential dylib hijacking and weak dylib vulnerabilities for application executables as well as scripts an application may use that have the potential to be backdoored
        // Reference: https://github.com/bashexplode/boko
        $string5_boko_offensive_tool_keyword = /bokoscanner\./ nocase ascii wide
        // Description: boko.py is an application scanner for macOS that searches for and identifies potential dylib hijacking and weak dylib vulnerabilities for application executables as well as scripts an application may use that have the potential to be backdoored
        // Reference: https://github.com/bashexplode/boko
        $string6_boko_offensive_tool_keyword = "import boko" nocase ascii wide

    condition:
        any of them
}


rule rule_bootkit_rs_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bootkit-rs' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bootkit-rs"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string1_bootkit_rs_offensive_tool_keyword = "/bootkit-rs" nocase ascii wide
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string2_bootkit_rs_offensive_tool_keyword = /\\bootkit\-rs/ nocase ascii wide
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string3_bootkit_rs_offensive_tool_keyword = /bootkit\-rs\.git/ nocase ascii wide
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string4_bootkit_rs_offensive_tool_keyword = "bootkit-rs-master" nocase ascii wide
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string5_bootkit_rs_offensive_tool_keyword = "master/bootkit/src" nocase ascii wide
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string6_bootkit_rs_offensive_tool_keyword = /redlotus\.efi/ nocase ascii wide
        // Description: Rusty Bootkit - Windows UEFI Bootkit in Rust (Codename: RedLotus)
        // Reference: https://github.com/memN0ps/bootkit-rs
        $string7_bootkit_rs_offensive_tool_keyword = "x86_64-unknown-uefi" nocase ascii wide

    condition:
        any of them
}


rule rule_bpf_keylogger_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bpf-keylogger' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bpf-keylogger"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string1_bpf_keylogger_offensive_tool_keyword = /\(prog\=\\"bpf\-keylogger\\"/ nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string2_bpf_keylogger_offensive_tool_keyword = /\/bpf\-keylogger\.git/ nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string3_bpf_keylogger_offensive_tool_keyword = "/bpf-keylogger/" nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string4_bpf_keylogger_offensive_tool_keyword = /A\skeylogger\swritten\sin\seBPF\./ nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string5_bpf_keylogger_offensive_tool_keyword = "bpf_keylogger: Log key presses and mouse button events systemwide using eBPF" nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string6_bpf_keylogger_offensive_tool_keyword = /Logging\skey\spresses\.\.\.\sctrl\-c\sto\squit/ nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/SkyperTHC/bpf-keylogger
        $string7_bpf_keylogger_offensive_tool_keyword = "SkyperTHC/bpf-keylogger" nocase ascii wide
        // Description: Keylogger written in BPF
        // Reference: https://github.com/willfindlay/bpf-keylogger
        $string8_bpf_keylogger_offensive_tool_keyword = "willfindlay/bpf-keylogger" nocase ascii wide

    condition:
        any of them
}


rule rule_bropper_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bropper' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bropper"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string1_bropper_offensive_tool_keyword = /\sbropper\.py/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string2_bropper_offensive_tool_keyword = /\s\-t\s127\.0\.0\.1\s\-p\s1337\s/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string3_bropper_offensive_tool_keyword = /\.py\s.{0,1000}\s\-\-brop\s/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string4_bropper_offensive_tool_keyword = /\/Bropper\.git/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string5_bropper_offensive_tool_keyword = /\/bropper\.py/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string6_bropper_offensive_tool_keyword = /bropper\.py\s/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string7_bropper_offensive_tool_keyword = /Bropper\-main\.zip/ nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string8_bropper_offensive_tool_keyword = "--expected Bad --expected-stop Welcome" nocase ascii wide
        // Description: An automatic Blind ROP exploitation tool 
        // Reference: https://github.com/Hakumarachi/Bropper
        $string9_bropper_offensive_tool_keyword = "Hakumarachi/Bropper" nocase ascii wide

    condition:
        any of them
}


