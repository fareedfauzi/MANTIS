rule rule_ctfr_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ctfr' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ctfr"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Abusing Certificate Transparency logs for getting HTTPS websites subdomains.
        // Reference: https://github.com/UnaPibaGeek/ctfr
        $string1_ctfr_offensive_tool_keyword = /\sctfr\.py/ nocase ascii wide
        // Description: Abusing Certificate Transparency logs for getting HTTPS websites subdomains.
        // Reference: https://github.com/UnaPibaGeek/ctfr
        $string2_ctfr_offensive_tool_keyword = /\/ctfr\.py/ nocase ascii wide
        // Description: Abusing Certificate Transparency logs for getting HTTPS websites subdomains.
        // Reference: https://github.com/UnaPibaGeek/ctfr
        $string3_ctfr_offensive_tool_keyword = /\\ctfr\.py/ nocase ascii wide

    condition:
        any of them
}


rule rule_ctftool_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ctftool' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ctftool"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: This is ctftool. an interactive command line tool to experiment with CTF. a little-known protocol used on Windows to implement Text Services. This might be useful for studying Windows internals. debugging complex issues with Text Input Processors and analyzing Windows security.
        // Reference: https://github.com/taviso/ctftool
        $string1_ctftool_offensive_tool_keyword = "/ctftool" nocase ascii wide

    condition:
        any of them
}


rule rule_cuddlephish_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'cuddlephish' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "cuddlephish"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string1_cuddlephish_offensive_tool_keyword = /\/cuddlephish\.git/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string2_cuddlephish_offensive_tool_keyword = /\/cuddlephish\.html/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string3_cuddlephish_offensive_tool_keyword = /\/user_data\/.{0,1000}\/keylog\.txt/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string4_cuddlephish_offensive_tool_keyword = "57a0a978ab19598abf7185762834fef1b4dbd4db30d2fb85d411a0e22821df25" nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string5_cuddlephish_offensive_tool_keyword = "AAABAAMAEBAAAAEAIABoBAAANgAAACAgAAABACAAKBEAAJ4EAAAwMAAAAQAgAGgmAADGFQAAKAAAABAAAAAgAAAAAQAgAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAP39" nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string6_cuddlephish_offensive_tool_keyword = /browser\.keylog_file\.write/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string7_cuddlephish_offensive_tool_keyword = /cuddlephish.{0,1000}stealer\.js/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string8_cuddlephish_offensive_tool_keyword = "cuddlephish-main" nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string9_cuddlephish_offensive_tool_keyword = "fkasler/cuddlephish" nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string10_cuddlephish_offensive_tool_keyword = /http\:\/\/localhost\:58082\/broadcast\?id\=/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string11_cuddlephish_offensive_tool_keyword = /listen\(58082.{0,1000}\s\'0\.0\.0\.0\'/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string12_cuddlephish_offensive_tool_keyword = /node\sstealer\.js\s/ nocase ascii wide
        // Description: Weaponized Browser-in-the-Middle (BitM) for Penetration Testers
        // Reference: https://github.com/fkasler/cuddlephish
        $string13_cuddlephish_offensive_tool_keyword = "ws://localhost:58082" nocase ascii wide

    condition:
        any of them
}


rule rule_curlshell_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'curlshell' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "curlshell"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string1_curlshell_offensive_tool_keyword = /\scurlshell\.py/
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string2_curlshell_offensive_tool_keyword = /\.py\s.{0,1000}0\.0\.0\.0.{0,1000}\-\-serve\-forever/
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string3_curlshell_offensive_tool_keyword = /\.py\s.{0,1000}\-\-dependabot\-workaround/
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string4_curlshell_offensive_tool_keyword = /\.py\s\-\-certificate\s.{0,1000}\.pem\s\-\-private\-key\s.{0,1000}\.pem\s\-\-listen\-port\s/
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string5_curlshell_offensive_tool_keyword = /\.py\s\-\-certificate\sfullchain\.pem\s\-\-private\-key\sprivkey\.pem\s\-\-listen\-port\s/
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string6_curlshell_offensive_tool_keyword = /\/curlshell\.git/ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string7_curlshell_offensive_tool_keyword = /\/curlshell\.git/ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string8_curlshell_offensive_tool_keyword = /\/curlshell\.py/ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string9_curlshell_offensive_tool_keyword = /\/curlshell\-main\./ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string10_curlshell_offensive_tool_keyword = "/curlshell-main/" nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string11_curlshell_offensive_tool_keyword = /\\curlshell\.py/ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string12_curlshell_offensive_tool_keyword = /\\curlshell\-main/ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string13_curlshell_offensive_tool_keyword = /\\curlshell\-main\\/ nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string14_curlshell_offensive_tool_keyword = "b8285e421d702738eab45670ecae439a7228994e7068b04cb51740e47efbfb41" nocase ascii wide
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string15_curlshell_offensive_tool_keyword = "curl https://curlshell"
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string16_curlshell_offensive_tool_keyword = /curlshell\.py/
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
        $string17_curlshell_offensive_tool_keyword = "https://curlshell:"
        // Description: reverse shell using curl
        // Reference: https://github.com/irsl/curlshell
