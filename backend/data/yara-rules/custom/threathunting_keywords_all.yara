        // Description: Mimikatz implementation in pure Python
        // Reference: https://github.com/skelsec/pypykatz
        $string95_pypykatz_offensive_tool_keyword = /tasklist\s\/fi\s.{0,1000}Imagename\seq\slsass\.exe/ nocase ascii wide
        // Description: Mimikatz implementation in pure Python
        // Reference: https://github.com/skelsec/pypykatz
        $string96_pypykatz_offensive_tool_keyword = /tspkg\/decryptor\.py/ nocase ascii wide
        // Description: Mimikatz implementation in pure Python
        // Reference: https://github.com/skelsec/pypykatz
        $string97_pypykatz_offensive_tool_keyword = /wdigest\/decryptor\.py/ nocase ascii wide

    condition:
        any of them
}


