        // Description: Converts an EXE so that it can be loaded like a DLL.
        // Reference: https://github.com/hasherezade/exe_to_dll
        $string13_exe_to_dll_offensive_tool_keyword = "hasherezade/exe_to_dll" nocase ascii wide

    condition:
        any of them
}


