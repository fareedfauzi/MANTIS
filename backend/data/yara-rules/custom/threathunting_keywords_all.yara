        $string3_SamDumpCable_offensive_tool_keyword = "cgBlAGcAIABzAGEAdgBlACAAaABrAGwAbQBcAHMAYQBtACAAMQ" nocase ascii wide
        // Description: Dump users sam and system hive and exfiltrate them
