        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string1_Egress_Assess_offensive_tool_keyword = /\s\-client\sftp\s\-ip\s.{0,1000}\s\-Username\s.{0,1000}\s\-Password\s.{0,1000}\s\-Datatype\sssn\s\-Size\s.{0,1000}\s\-Verbose/ nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string2_Egress_Assess_offensive_tool_keyword = /\s\-client\shttp\s\-ip\s.{0,1000}\s\-Datatype\scc\s\-Size\s.{0,1000}\s\-Port\s.{0,1000}\s\-Loop\s.{0,1000}\s\-Fast\s\-Verbose/ nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string3_Egress_Assess_offensive_tool_keyword = /\s\-client\sicmp\s\-ip\s.{0,1000}\s\-Datatype\sssn\s\-Report\s\-Verbose/ nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string4_Egress_Assess_offensive_tool_keyword = /\s\-client\ssmb\s\-ip\s.{0,1000}\s\-Datatype\s.{0,1000}c\:\\.{0,1000}\..{0,1000}\s\-Verbose/ nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string5_Egress_Assess_offensive_tool_keyword = /\s\-Client\sSMTPOutlook\s\-IP\s.{0,1000}\s\-NoPing\s\-DataType\s.{0,1000}ssn/ nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string6_Egress_Assess_offensive_tool_keyword = " Egress-Assess's FTP server" nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
        // Reference: https://github.com/FortyNorthSecurity/Egress-Assess
        $string7_Egress_Assess_offensive_tool_keyword = /\setumbot\.py/ nocase ascii wide
        // Description: Egress-Assess is a tool used to test egress data detection capabilities
