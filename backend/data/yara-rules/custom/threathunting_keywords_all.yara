        $string6_Alcatraz_offensive_tool_keyword = "/Alcatraz-gui" nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string7_Alcatraz_offensive_tool_keyword = /\/obfuscator\/obfuscator\./ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string8_Alcatraz_offensive_tool_keyword = /\\Alcatraz\.exe/ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string9_Alcatraz_offensive_tool_keyword = /Alcatraz\.sln/ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string10_Alcatraz_offensive_tool_keyword = /Alcatraz\.vcxproj/ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string11_Alcatraz_offensive_tool_keyword = "Alcatraz/obfuscator" nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string12_Alcatraz_offensive_tool_keyword = /Alcatraz\-master\.zip/ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string13_Alcatraz_offensive_tool_keyword = /obfuscator.{0,1000}antidisassembly\./ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string14_Alcatraz_offensive_tool_keyword = /obfuscator\.cpp/ nocase ascii wide
        // Description: x64 binary obfuscator
        // Reference: https://github.com/weak1337/Alcatraz
        $string15_Alcatraz_offensive_tool_keyword = "weak1337/Alcatraz" nocase ascii wide

    condition:
        any of them
}


rule rule_Amass_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Amass' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Amass"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: In-depth subdomain enumeration tool that performs scraping. recursive brute forcing06/01/2021 crawling of web archives06/01/2021 name altering and reverse DNS sweeping
        // Reference: https://github.com/OWASP/Amass
        $string1_Amass_offensive_tool_keyword = " install amass"
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
        // Reference: https://github.com/caffix/amass
        $string2_Amass_offensive_tool_keyword = /\/amass\.log/
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
        // Reference: https://github.com/caffix/amass
        $string3_Amass_offensive_tool_keyword = /\/amass\.sqlite/
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
        // Reference: https://github.com/caffix/amass
        $string4_Amass_offensive_tool_keyword = "/amass/releases/download/"
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
        // Reference: https://github.com/caffix/amass
        $string5_Amass_offensive_tool_keyword = /\/amass_results_owasp\.txt/
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
        // Reference: https://github.com/caffix/amass
        $string6_Amass_offensive_tool_keyword = /\/deepmagic\.com_top500prefixes\.txt/
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
        // Reference: https://github.com/caffix/amass
        $string7_Amass_offensive_tool_keyword = /\/deepmagic\.com_top50kprefixes\.txt/
        // Description: The OWASP Amass Project performs network mapping of attack surfaces and external asset discovery using open source information gathering and active reconnaissance techniques.
