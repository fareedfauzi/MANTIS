        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string1_Lastenzug_offensive_tool_keyword = "! This is a sample loader for Lastenzug" nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string2_Lastenzug_offensive_tool_keyword = /\/LastenLoader\.exe/ nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string3_Lastenzug_offensive_tool_keyword = /\/Lastenzug\.git/ nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string4_Lastenzug_offensive_tool_keyword = /\\LastenLoader\.exe/ nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string5_Lastenzug_offensive_tool_keyword = /127\.0\.0\.1\:1337/ nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string6_Lastenzug_offensive_tool_keyword = "a07f5f82857dd9e0b02b4bb90783e028ff42e80fe8286dd2c8e983db138c3820" nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string7_Lastenzug_offensive_tool_keyword = /bin\/LastenPIC\.bin/ nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string8_Lastenzug_offensive_tool_keyword = "build -o LastenServer"
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string9_Lastenzug_offensive_tool_keyword = "codewhitesec/Lastenzug" nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string10_Lastenzug_offensive_tool_keyword = "d2807b9860e0e4801cd00f45421b5bcab30c1a818f193e4a3d33be8f65c99ea0" nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string11_Lastenzug_offensive_tool_keyword = "LastenPIC/SpiderPIC" nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string12_Lastenzug_offensive_tool_keyword = "LastenServer server "
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string13_Lastenzug_offensive_tool_keyword = "Lastenzug - PIC Socks4a proxy by @invist" nocase ascii wide
        // Description: Socka4a proxy based on websockets
        // Reference: https://github.com/codewhitesec/Lastenzug
        $string14_Lastenzug_offensive_tool_keyword = /ws\:\/\/127\.0\.0\.1\:1339\/yolo/ nocase ascii wide

    condition:
        any of them
}


rule rule_LatLoader_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'LatLoader' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "LatLoader"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string1_LatLoader_offensive_tool_keyword = /\sLatLoader\.py/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string2_LatLoader_offensive_tool_keyword = /\/LatLoader\.git/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string3_LatLoader_offensive_tool_keyword = /\/LatLoader\.py/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string4_LatLoader_offensive_tool_keyword = /\[\+\]\sLooking\sfor\sthe\sSSN\svia\sHalos\sGate/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string5_LatLoader_offensive_tool_keyword = /\\LatLoader\.py/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string6_LatLoader_offensive_tool_keyword = /\\LatLoader\-main/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string7_LatLoader_offensive_tool_keyword = "27f70a1d533f7a3b8703d89904ae4541d96c8c656661872a495f592f9ed80d9e" nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string8_LatLoader_offensive_tool_keyword = "45787955618ba3211b89021ddf23ecc5d2b55397a006190455c4070dad964572" nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string9_LatLoader_offensive_tool_keyword = /cmd\.exe\s\/c\sC\:\\\\Windows\\\\DiskSnapShot\.exe\s\&\&\secho\s\-\-path\sC\:\\\\Windows\\\\CCMCache\\\\cache/ nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string10_LatLoader_offensive_tool_keyword = "f0f8f8de178f91de8fe054b6450fa0d2291ad7693035f2c52df800e9168fb22d" nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string11_LatLoader_offensive_tool_keyword = "icyguider/LatLoader" nocase ascii wide
        // Description: PoC module to demonstrate automated lateral movement with the Havoc C2 framework
        // Reference: https://github.com/icyguider/LatLoader
        $string12_LatLoader_offensive_tool_keyword = "OPERATORCHANGEMEPLZZZ" nocase ascii wide

    condition:
        any of them
}


rule rule_LaZagne_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'LaZagne' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "LaZagne"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: The LaZagne project is an open source application used to retrieve lots of passwords stored on a local computer. Each software stores its passwords using different techniques (plaintext   APIs   custom algorithms   databases   etc.). This tool has been developed for the purpose of finding these passwords for the most commonly-used software.
        // Reference: https://github.com/AlessandroZ/LaZagne
        $string1_LaZagne_offensive_tool_keyword = /\slaZagne\.py/ nocase ascii wide
