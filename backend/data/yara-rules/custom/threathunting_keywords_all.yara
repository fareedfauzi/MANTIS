        // Reference: https://github.com/RedSiege/C2concealer
        $string7_C2concealer_offensive_tool_keyword = "C2concealer-master" nocase ascii wide
        // Description: C2concealer is a command line tool that generates randomized C2 malleable profiles for use in Cobalt Strike.
        // Reference: https://github.com/RedSiege/C2concealer
        $string8_C2concealer_offensive_tool_keyword = /malleable\-c2\-randomizer\.py/ nocase ascii wide

    condition:
        any of them
}


