        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Tool for extracting information from newly spawned processes
        // Reference: https://github.com/blendin/3snake
        $string1__3snake_offensive_tool_keyword = /\.\/snake/
        // Description: Tool for extracting information from newly spawned processes
