        $string49_ScreenConnect_greyware_tool_keyword = /ScreenConnectClientNetworkDeployer\.exe/ nocase ascii wide
        // Description: control remote servers - abused by threat actors
        // Reference: screenconnect.com
        $string50_ScreenConnect_greyware_tool_keyword = /server.{0,1000}\-relay\.screenconnect\.com/ nocase ascii wide
        // Description: ConnectWise Control formerly known as Screenconnect is a remote desktop software application.
