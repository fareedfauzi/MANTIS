rule rule_KeeThiefSyscalls_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'KeeThiefSyscalls' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "KeeThiefSyscalls"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Patch GhostPack/KeeThief for it to use DInvoke and syscalls
        // Reference: https://github.com/Metro-Holografix/KeeThiefSyscalls
        $string1_KeeThiefSyscalls_offensive_tool_keyword = /\sKeeTheft\.exe/ nocase ascii wide
        // Description: Patch GhostPack/KeeThief for it to use DInvoke and syscalls
        // Reference: https://github.com/Metro-Holografix/KeeThiefSyscalls
        $string2_KeeThiefSyscalls_offensive_tool_keyword = /\/KeeThief\.git/ nocase ascii wide
        // Description: Patch GhostPack/KeeThief for it to use DInvoke and syscalls
        // Reference: https://github.com/Metro-Holografix/KeeThiefSyscalls
        $string3_KeeThiefSyscalls_offensive_tool_keyword = /\\KeeTheft\.exe/ nocase ascii wide
        // Description: Patch GhostPack/KeeThief for it to use DInvoke and syscalls
        // Reference: https://github.com/Metro-Holografix/KeeThiefSyscalls
        $string4_KeeThiefSyscalls_offensive_tool_keyword = "KeeTheft/Dinvoke" nocase ascii wide
        // Description: Patch GhostPack/KeeThief for it to use DInvoke and syscalls
        // Reference: https://github.com/Metro-Holografix/KeeThiefSyscalls
        $string5_KeeThiefSyscalls_offensive_tool_keyword = "KeeThiefSyscalls" nocase ascii wide

    condition:
        any of them
}


rule rule_kekeo_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'kekeo' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "kekeo"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: access the LSA (Local Security Authority) and manipulate Kerberos tickets. potentially allowing adversaries to gain unauthorized access to Active Directory resources and CIFS file shares
        // Reference: https://github.com/gentilkiwi/kekeo
        $string1_kekeo_offensive_tool_keyword = /kirbikator\.exe/ nocase ascii wide

    condition:
        any of them
}


