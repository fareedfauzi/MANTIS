rule rule_SillyRAT_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SillyRAT' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SillyRAT"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A Cross Platform multifunctional (Windows/Linux/Mac) RAT.
        // Reference: https://github.com/hash3liZer/SillyRAT
        $string1_SillyRAT_offensive_tool_keyword = "hash3liZer/SillyRAT" nocase ascii wide
        // Description: A Cross Platform multifunctional (Windows/Linux/Mac) RAT.
        // Reference: https://github.com/hash3liZer/SillyRAT
        $string2_SillyRAT_offensive_tool_keyword = "keylogger dump" nocase ascii wide
        // Description: A Cross Platform multifunctional (Windows/Linux/Mac) RAT.
        // Reference: https://github.com/hash3liZer/SillyRAT
        $string3_SillyRAT_offensive_tool_keyword = /server\.py\sgenerate\s\-\-address\s.{0,1000}\s\-\-port\s.{0,1000}\s\-\-output\s.{0,1000}\s\-\-source/ nocase ascii wide
        // Description: A Cross Platform multifunctional (Windows/Linux/Mac) RAT.
        // Reference: https://github.com/hash3liZer/SillyRAT
        $string4_SillyRAT_offensive_tool_keyword = /SillyRAT\.git/ nocase ascii wide
        // Description: A Cross Platform multifunctional (Windows/Linux/Mac) RAT.
        // Reference: https://github.com/hash3liZer/SillyRAT
        $string5_SillyRAT_offensive_tool_keyword = /sillyrat\.py/ nocase ascii wide

    condition:
        any of them
}


rule rule_Simple_Reverse_Shell_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Simple-Reverse-Shell' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Simple-Reverse-Shell"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Simple C++ reverse shell without obfuscation to avoid Win 11 defender detection (At the time of publication
        // Reference: https://github.com/tihanyin/Simple-Reverse-Shell/
        $string1_Simple_Reverse_Shell_offensive_tool_keyword = "/Simple-Reverse-Shell" nocase ascii wide

    condition:
        any of them
}


rule rule_SimpleBackdoorAdmin_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SimpleBackdoorAdmin' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SimpleBackdoorAdmin"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string1_SimpleBackdoorAdmin_offensive_tool_keyword = "net localgroup administrators backdoor" nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string2_SimpleBackdoorAdmin_offensive_tool_keyword = "net user backdoor Password123!" nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string3_SimpleBackdoorAdmin_offensive_tool_keyword = /SimpleBackdoorAdmin\.dll/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string4_SimpleBackdoorAdmin_offensive_tool_keyword = /SimpleBackdoorAdmin\.exe/ nocase ascii wide

    condition:
        any of them
}


rule rule_SimpleNTSyscallFuzzer_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SimpleNTSyscallFuzzer' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SimpleNTSyscallFuzzer"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Fuzzer for Windows kernel syscalls.
        // Reference: https://github.com/waleedassar/SimpleNTSyscallFuzzer
        $string1_SimpleNTSyscallFuzzer_offensive_tool_keyword = /\/SimpleNTSyscallFuzzer\.git/ nocase ascii wide
        // Description: Fuzzer for Windows kernel syscalls.
        // Reference: https://github.com/waleedassar/SimpleNTSyscallFuzzer
        $string2_SimpleNTSyscallFuzzer_offensive_tool_keyword = "FB351327-0816-448B-8FB7-63B550D6C808" nocase ascii wide
        // Description: Fuzzer for Windows kernel syscalls.
        // Reference: https://github.com/waleedassar/SimpleNTSyscallFuzzer
        $string3_SimpleNTSyscallFuzzer_offensive_tool_keyword = /SimpleNtSyscallFuzzer\.v11\.suo/ nocase ascii wide
