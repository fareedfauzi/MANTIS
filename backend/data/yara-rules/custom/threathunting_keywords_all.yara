        $string1_ActiveScanPlusPlus_offensive_tool_keyword = "/ActiveScanPlusPlus" nocase ascii wide
        // Description: ActiveScan++ extends Burp Suite's active and passive scanning capabilities. Designed to add minimal network overhead. it identifies application behaviour that may be of interest to advanced testers
        // Reference: https://github.com/albinowax/ActiveScanPlusPlus
        $string2_ActiveScanPlusPlus_offensive_tool_keyword = /activeScan\+\+\.py/ nocase ascii wide
        // Description: ActiveScan++ extends Burp Suite's active and passive scanning capabilities. Designed to add minimal network overhead. it identifies application behaviour that may be of interest to advanced testers
        // Reference: https://github.com/albinowax/ActiveScanPlusPlus
        $string3_ActiveScanPlusPlus_offensive_tool_keyword = "from burp import " nocase ascii wide

    condition:
        any of them
}


rule rule_AD_exploitation_cheat_sheet_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'AD exploitation cheat sheet' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "AD exploitation cheat sheet"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Lateral Movement with Mimikatz  Overpass-the-hash a more opsec-safe version that uses the AES256 key (similar to with Rubeus above) - works for multiple Mimikatz commands
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string1_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\/user\:.{0,1000}\s\/domain\:.{0,1000}\s\/aes256\:.{0,1000}\s\/run\:powershell\.exe/ nocase ascii wide
        // Description: Lateral Movement with Mimikatz Overpass-the-hash (more risky than Rubeus writes to LSASS memory)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string2_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\/user\:.{0,1000}\s\/domain\:.{0,1000}\s\/ntlm\:.{0,1000}\s\/run\:powershell\.exe/ nocase ascii wide
        // Description: Lateral Movement with Mimikatz Golden ticket (domain admin w/ some ticket properties to avoid detection)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string3_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\/user\:.{0,1000}\s\/domain\:.{0,1000}\s\/sid\:S\-1\-5\-21\-.{0,1000}\s\/krbtgt\:.{0,1000}\s\/id\:.{0,1000}\s\/groups\:.{0,1000}\s\/startoffset\:0\s\/endin\:600\s\/renewmax\:10080\s\/ptt/ nocase ascii wide
        // Description: DCShadow is an attack that masks certain actions by temporarily imitating a Domain Controller. If you have Domain Admin or Enterprise Admin privileges in a root domain it can be used for forest-level persistence.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string4_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\-FakeDC\s.{0,1000}\s\-SamAccountName\s.{0,1000}\s\-Username\s/ nocase ascii wide
        // Description: Targeted kerberoasting by setting SPN
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string5_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\-Identity\s.{0,1000}\s\-Set\s\@\{serviceprincipalname\=\'.{0,1000}\'\}/ nocase ascii wide
        // Description: Targeted kerberoasting we need ACL write permissions to set UserAccountControl flags for the target user. Using PowerView
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string6_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\-Identity\s.{0,1000}\s\-XOR\s\@\{useraccountcontrol\=4194304/ nocase ascii wide
        // Description: Dump LSASS memory through a process snapshot (-r) avoiding interacting with it directly
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string7_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\slsass\.dmp/ nocase ascii wide
        // Description: Example command to relay the hash to authenticate as local admin (if the service account has these privileges) and run calc.exe. Omit the -c parameter to attempt a secretsdump instead.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string8_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\s\-\-no\-http\-server\s\-smb2support\s\-t\s.{0,1000}\s\-c\s/ nocase ascii wide
        // Description: Chisel proxying - On our attacking machine (Linux in this case) we start a Chisel server on port 80 in reverse SOCKS5 mode.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string9_AD_exploitation_cheat_sheet_offensive_tool_keyword = " server -p 80 --reverse --socks5"
        // Description: Chisel proxying - On our attacking machine (Linux in this case) we start a Chisel server on port 80 in reverse SOCKS5 mode.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string10_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.\/chisel\s/
        // Description: Lateral Movement with Rubeus  More stealthy variant but requires the AES256 key (see 'Dumping OS credentials with Mimikatz' section)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string11_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\sasktgt\s\/user\:.{0,1000}\s\/aes256\:.{0,1000}\s\/opsec\s\/ptt/ nocase ascii wide
        // Description: Lateral Movement with Rubeus Pass the ticket to a sacrificial hidden process. allowing you to e.g. steal the token from this process (requires elevation)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string12_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\sasktgt\s\/user\:.{0,1000}\s\/rc4\:.{0,1000}\s\/createnetonly\:.{0,1000}cmd\.exe/ nocase ascii wide
        // Description: Lateral Movement with Rubeus  Request a TGT as the target user and pass it into the current session
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string13_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\sasktgt\s\/user\:.{0,1000}\s\/rc4\:.{0,1000}\s\/ptt/ nocase ascii wide
        // Description: Chisel proxying - on our compromised target system we connect to this server and tell it to proxy all traffic over it via the reverse SOCKS5 tunnel.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string14_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\sclient\s.{0,1000}\:.{0,1000}\sR\:socks/ nocase ascii wide
        // Description: Unconstrained delegation Exploitation with Rubeus
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string15_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\sdump\s\/luid\:0x5379f2\s\/nowrap/ nocase ascii wide
        // Description: Unconstrained delegation  Exploitation with Rubeus
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string16_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\smonitor\s\/interval\:5\s\/nowrap/ nocase ascii wide
        // Description: Unconstrained delegation  Exploitation with Rubeus
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string17_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\sptt\s\/ticket\:/ nocase ascii wide
        // Description: Rubeus Use s4u2self and s4u2proxy to impersonate the DA user to the allowed SPN
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string18_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\ss4u\s\/ticket\:.{0,1000}\s\/impersonateuser\:.{0,1000}\s\/msdsspn\:.{0,1000}\s\/ptt/ nocase ascii wide
        // Description: Rubeus access the LDAP service on the DC (for dcsync)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string19_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\ss4u\s\/user\:.{0,1000}\s\/impersonateuser\:.{0,1000}\s\/msdsspn\:.{0,1000}\s\/altservice\:ldap\s\/ptt\s\/rc4/ nocase ascii wide
        // Description: Unconstrained delegation  Exploitation with Rubeus
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string20_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.exe\striage/ nocase ascii wide
        // Description: If you have low-privileged access to a MSSQL database and no links are present you could potentially force NTLM authentication by using the xp_dirtree stored procedure to access this share. If this is successful  the NetNTLM for the SQL service account can be collected and potentially cracked or relayed to compromise machines as that service account.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string21_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\.xp_dirtree\s.{0,1000}\\/ nocase ascii wide
        // Description: Crack the hash with Hashcat
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string22_AD_exploitation_cheat_sheet_offensive_tool_keyword = /\/rockyou\.txt/
        // Description: Crack with TGSRepCrack
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string23_AD_exploitation_cheat_sheet_offensive_tool_keyword = /10k\-worst\-pass\.txt/ nocase ascii wide
        // Description: Using DAMP toolkit We add the backdoor using the Add-RemoteRegBackdoor.ps1 cmdlet from DAMP.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string24_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Add-RemoteRegBackdoor" nocase ascii wide
        // Description: PowerShell AMSI Bypass
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string25_AD_exploitation_cheat_sheet_offensive_tool_keyword = /Assembly\.GetType\(\'System\.Management\.Automation\.AmsiUtils\'\)\.GetField\(\'amsiInitFailed\'.{0,1000}\'NonPublic.{0,1000}Static\'\)\.SetValue\(\$null.{0,1000}\$true\)/ nocase ascii wide
        // Description: Chisel proxying - on our compromised target system we connect to this server and tell it to proxy all traffic over it via the reverse SOCKS5 tunnel.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string26_AD_exploitation_cheat_sheet_offensive_tool_keyword = /chisel\.exe\s/ nocase ascii wide
        // Description: Dumping secrets from a Volume Shadow Copy We can also create a Volume Shadow Copy of the SAM and SYSTEM files (which are always locked on the current system) so we can still copy them over to our local system. An elevated prompt is required for this.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string27_AD_exploitation_cheat_sheet_offensive_tool_keyword = /copy\s\\.{0,1000}\\HarddiskVolumeShadowCopy1\\windows\\system32\\config\\sam\sC\:\\/ nocase ascii wide
        // Description: Dumping secrets from a Volume Shadow Copy We can also create a Volume Shadow Copy of the SAM and SYSTEM files (which are always locked on the current system) so we can still copy them over to our local system. An elevated prompt is required for this.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string28_AD_exploitation_cheat_sheet_offensive_tool_keyword = /copy\s\\.{0,1000}\\HarddiskVolumeShadowCopy1\\windows\\system32\\config\\system\sC\:\\/ nocase ascii wide
        // Description: Generate EncodedCommand
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string29_AD_exploitation_cheat_sheet_offensive_tool_keyword = /echo\s\-n\s\'cmd\s\/c\sstart\srundll32\s.{0,1000}\.dll.{0,1000}\s\|\sbase64/ nocase ascii wide
        // Description: Lateral Movement Enumeration With PowerView
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string30_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Find-InterestingDomainAcl" nocase ascii wide
        // Description: Lateral Movement Enumeration With PowerView
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string31_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Find-LocalAdminAccess" nocase ascii wide
        // Description: AS-REP roasting Get the hash for a roastable user using ASREPRoast.ps1
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string32_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Get-ASREPHash" nocase ascii wide
        // Description: msds-allowedtodelegateto*
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string33_AD_exploitation_cheat_sheet_offensive_tool_keyword = /Get\-DomainComputer\s\-TrustedToAuth\s\|\sselect\sname/ nocase ascii wide
        // Description: Abusing inter-forest trust Powersploit
        // Reference: https://powersploit.readthedocs.io/en/latest/Recon/Get-DomainForeignGroupMember/
        $string34_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Get-DomainForeignGroupMember" nocase ascii wide
        // Description: msds-allowedtodelegateto*
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string35_AD_exploitation_cheat_sheet_offensive_tool_keyword = /Get\-DomainUser\s\-TrustedToAuth\s\|\sselect\suserprincipalname/ nocase ascii wide
        // Description: TightVNC password (convert to Hex then decrypt with e.g.: https://github.com/frizb/PasswordDecrypts)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string36_AD_exploitation_cheat_sheet_offensive_tool_keyword = /Get\-ItemProperty\s\-Path\sHKLM\:\\Software\\TightVNC\\Server\s\-Name\s.{0,1000}Password.{0,1000}\s\|\sselect\s\-ExpandProperty\sPassword/ nocase ascii wide
        // Description: Sometimes LSASS is configured to run as a protected process (PPL). You can query this with PowerShell as follows.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string37_AD_exploitation_cheat_sheet_offensive_tool_keyword = /Get\-ItemProperty\s\-Path\sHKLM\:\\SYSTEM\\CurrentControlSet\\Control\\Lsa\s\-Name\s.{0,1000}RunAsPPL/ nocase ascii wide
        // Description: Get cached credentials (if any)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string38_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Get-RemoteCachedCredential" nocase ascii wide
        // Description: Get local account hashes
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string39_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Get-RemoteLocalAccountHash" nocase ascii wide
        // Description: Get machine account hash for silver ticket attack
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string40_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Get-RemoteMachineAccountHash" nocase ascii wide
        // Description: Automatically find all linked databases
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string41_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Get-SqlServerLinkCrawl" nocase ascii wide
        // Description: Command execution with WMI From Linux
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string42_AD_exploitation_cheat_sheet_offensive_tool_keyword = "impacket-wmiexec"
        // Description: Token Manipulation Tokens can be impersonated from other users with a session/running processes on the machine. Most C2 frameworks have functionality for this built-in (such as the Steal Token functionality in Cobalt Strike)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string43_AD_exploitation_cheat_sheet_offensive_tool_keyword = /incognito.{0,1000}\slist_tokens\s\-u/ nocase ascii wide
        // Description: Token Manipulation Tokens can be impersonated from other users with a session/running processes on the machine. Most C2 frameworks have functionality for this built-in (such as the Steal Token functionality in Cobalt Strike)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string44_AD_exploitation_cheat_sheet_offensive_tool_keyword = /incognito\.exe/ nocase ascii wide
        // Description: Check for vulnerable programs and configs
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string45_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Invoke-AllChecks" nocase ascii wide
        // Description: Exploit vulnerable service permissions (does not require touching disk)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string46_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Invoke-ServiceAbuse" nocase ascii wide
        // Description: Scan for MSSQL misconfigurations to escalate to System Admin
        // Reference: https://stealthbits.com/blog/compromise-powerupsql-sql-attacks/
        $string47_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Invoke-SQLAudit" nocase ascii wide
        // Description: Run command (enables XP_CMDSHELL automatically if required)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string48_AD_exploitation_cheat_sheet_offensive_tool_keyword = /Invoke\-SQLOSCmd\s\-Instance\s.{0,1000}\s\-Command\s/ nocase ascii wide
        // Description: Invoke-TokenManipulation script Tokens can be impersonated from other users with a session/running processes on the machine. Most C2 frameworks have functionality for this built-in (such as the Steal Token functionality in Cobalt Strike)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string49_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Invoke-TokenManipulation" nocase ascii wide
        // Description: Dump LSASS memory through a process snapshot (-r) avoiding interacting with it directly
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string50_AD_exploitation_cheat_sheet_offensive_tool_keyword = /lsass\.dmp/ nocase ascii wide
        // Description: Unconstrained delegation From attacking machine entice the Domain Controller to connect using the printer bug. Binary from here https://github.com/leechristensen/SpoolSample
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string51_AD_exploitation_cheat_sheet_offensive_tool_keyword = /MS\-RPRN\.exe\s/ nocase ascii wide
        // Description: Crack with TGSRepCrack
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string52_AD_exploitation_cheat_sheet_offensive_tool_keyword = /mssqlsvc\.kirbi/ nocase ascii wide
        // Description: Example command to relay the hash to authenticate as local admin (if the service account has these privileges) and run calc.exe. Omit the -c parameter to attempt a secretsdump instead.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string53_AD_exploitation_cheat_sheet_offensive_tool_keyword = "ntlmrelayx --" nocase ascii wide
        // Description: Dump LSASS memory through a process snapshot (-r) avoiding interacting with it directly
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string54_AD_exploitation_cheat_sheet_offensive_tool_keyword = /procdump\.exe.{0,1000}lsass/ nocase ascii wide
        // Description: Crack the hash with Hashcat
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string55_AD_exploitation_cheat_sheet_offensive_tool_keyword = /pwd.{0,1000}\/.{0,1000}\/rules\/best64\.rule/ nocase ascii wide
        // Description: DCShadow is an attack that masks certain actions by temporarily imitating a Domain Controller. If you have Domain Admin or Enterprise Admin privileges in a root domain it can be used for forest-level persistence.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string56_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Set-DCShadowPermissions" nocase ascii wide
        // Description: Targeted kerberoasting by setting SPN
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string57_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Set-DomainObject" nocase ascii wide
        // Description: PowerShell AMSI Bypass Obfuscation example for copy-paste purposes
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string58_AD_exploitation_cheat_sheet_offensive_tool_keyword = /sET\-ItEM\s\(\s\'V\'\+\'aR\'\s\+\s\s\'IA\'\s\+\s\'blE\:1q2\'\s\s\+\s\'uZx\'/ nocase ascii wide
        // Description: Use SharpBypassUAC e.g. from a CobaltStrike beacon
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string59_AD_exploitation_cheat_sheet_offensive_tool_keyword = "SharpBypassUAC" nocase ascii wide
        // Description: Crack with TGSRepCrack
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string60_AD_exploitation_cheat_sheet_offensive_tool_keyword = /tgsrepcrack\./ nocase ascii wide
        // Description: Start new process with token of a specific user. Tokens can be impersonated from other users with a session/running processes on the machine. Most C2 frameworks have functionality for this built-in (such as the Steal Token functionality in Cobalt Strike)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string61_AD_exploitation_cheat_sheet_offensive_tool_keyword = /token.{0,1000}\s\-CreateProcess\s.{0,1000}\s\-ProcessId\s/ nocase ascii wide
        // Description: Start new process with token of a specific user. Tokens can be impersonated from other users with a session/running processes on the machine. Most C2 frameworks have functionality for this built-in (such as the Steal Token functionality in Cobalt Strike)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string62_AD_exploitation_cheat_sheet_offensive_tool_keyword = /token.{0,1000}\s\-ImpersonateUser\s\-Username\s/ nocase ascii wide
        // Description: Token Manipulation Tokens can be impersonated from other users with a session/running processes on the machine. Most C2 frameworks have functionality for this built-in (such as the Steal Token functionality in Cobalt Strike)
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string63_AD_exploitation_cheat_sheet_offensive_tool_keyword = "use incognito" nocase ascii wide
        // Description: Dumping secrets from a Volume Shadow Copy We can also create a Volume Shadow Copy of the SAM and SYSTEM files (which are always locked on the current system) so we can still copy them over to our local system. An elevated prompt is required for this.
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string64_AD_exploitation_cheat_sheet_offensive_tool_keyword = /wmic\sshadowcopy\scall\screate\sVolume\=\'C\:\\\'/ nocase ascii wide
        // Description: Exploit an unquoted service path vulnerability to spawn a beacon
        // Reference: https://casvancooten.com/posts/2020/11/windows-active-directory-exploitation-cheat-sheet-and-command-reference
        $string65_AD_exploitation_cheat_sheet_offensive_tool_keyword = "Write-ServiceBinary" nocase ascii wide

    condition:
        any of them
}


rule rule_ad_ldap_enum_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ad-ldap-enum' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ad-ldap-enum"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: An LDAP based Active Directory user and group enumeration tool
        // Reference: https://github.com/CroweCybersecurity/ad-ldap-enum
        $string1_ad_ldap_enum_offensive_tool_keyword = " -p 'aad3b435b51404eeaad3b435b51404ee:31d6cfe0d16ae931b73c59d7e0c089c0'" nocase ascii wide
        // Description: An LDAP based Active Directory user and group enumeration tool
        // Reference: https://github.com/CroweCybersecurity/ad-ldap-enum
        $string2_ad_ldap_enum_offensive_tool_keyword = /\/ad\-ldap\-enum\.git/ nocase ascii wide
        // Description: An LDAP based Active Directory user and group enumeration tool
        // Reference: https://github.com/CroweCybersecurity/ad-ldap-enum
        $string3_ad_ldap_enum_offensive_tool_keyword = /ad\-ldap\-enum\.py/ nocase ascii wide
        // Description: An LDAP based Active Directory user and group enumeration tool
        // Reference: https://github.com/CroweCybersecurity/ad-ldap-enum
        $string4_ad_ldap_enum_offensive_tool_keyword = "ad-ldap-enum-main" nocase ascii wide
        // Description: An LDAP based Active Directory user and group enumeration tool
        // Reference: https://github.com/CroweCybersecurity/ad-ldap-enum
        $string5_ad_ldap_enum_offensive_tool_keyword = "CroweCybersecurity/ad-ldap-enum" nocase ascii wide

    condition:
        any of them
}


rule rule_ADACLScanner_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ADACLScanner' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ADACLScanner"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string1_ADACLScanner_offensive_tool_keyword = /\.ps1\s\-Base\s.{0,1000}OU\=.{0,1000}DC\=.{0,1000}\s\-Credentials\s.{0,1000}\s\-Server\s/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string2_ADACLScanner_offensive_tool_keyword = /\/ADACLScanner\.git/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string3_ADACLScanner_offensive_tool_keyword = /_adAclOutput.{0,1000}\.csv/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string4_ADACLScanner_offensive_tool_keyword = /_adAclOutput.{0,1000}\.csv/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string5_ADACLScanner_offensive_tool_keyword = /_adAclOutput.{0,1000}\.csv/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string6_ADACLScanner_offensive_tool_keyword = /_adAclOutput.{0,1000}\.csv/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string7_ADACLScanner_offensive_tool_keyword = /_adAclOutput.{0,1000}\.csv/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string8_ADACLScanner_offensive_tool_keyword = /_adAclOutput.{0,1000}\.xlsx/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string9_ADACLScanner_offensive_tool_keyword = "3ECA4B56CE358B13E1128A1E6149ED07CA0A8C55997B50A1E2C4EA46BD586B84" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string10_ADACLScanner_offensive_tool_keyword = "4E0CA74F5E074DFF389263D15E3913750EB437C1C3CD3B212C2998352023B980" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string11_ADACLScanner_offensive_tool_keyword = "555662D4CCBB940D87869E6295EC7CC74BB85D8C8FC5916EC34D1226704578C5" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string12_ADACLScanner_offensive_tool_keyword = "6973A4710FD88D32D47F4523E7EC098EF407F8ECED4B34AF6D3759CE1696EF19" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string13_ADACLScanner_offensive_tool_keyword = "6BF82CF9845C649557FC02D1E3D0B6A9FB4F827CC7815BF477DD0CB51246DA45" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string14_ADACLScanner_offensive_tool_keyword = "9AC25A8825407CCB6089BC7A2DF530D1830795B7E71A981ECEE4C5F48387B37A" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string15_ADACLScanner_offensive_tool_keyword = /ADACLScan\.ps1/ nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string16_ADACLScanner_offensive_tool_keyword = "ADACLScanner" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string17_ADACLScanner_offensive_tool_keyword = "ADACLScanner-master" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string18_ADACLScanner_offensive_tool_keyword = "B5A3FA5B3DA95F6AA7556EE2BC62E5D290F72453105EF88E170174994DDA2650" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string19_ADACLScanner_offensive_tool_keyword = "canix1/ADACLScanner" nocase ascii wide
        // Description: A tool with GUI used to create reports of access control lists (DACLs) and system access control lists (SACLs) in Active Directory .
        // Reference: https://github.com/canix1/ADACLScanner
        $string20_ADACLScanner_offensive_tool_keyword = "F8E0A09D99FF46019C0C3F2B725E9887D9AE53CB7FAD0BB233BC8612C2CA51F2" nocase ascii wide

    condition:
        any of them
}


rule rule_adalanche_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'adalanche' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "adalanche"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string1_adalanche_offensive_tool_keyword = /\s\-\-authmode\sntlm\s\-\-username\s.{0,1000}\s\-\-password\s/ nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string2_adalanche_offensive_tool_keyword = " collect activedirectory --" nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string3_adalanche_offensive_tool_keyword = "/adalanche/modules/" nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string4_adalanche_offensive_tool_keyword = /activedirectory\/pwns\.go/ nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string5_adalanche_offensive_tool_keyword = "adalanche analyze" nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string6_adalanche_offensive_tool_keyword = "adalanche collect" nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string7_adalanche_offensive_tool_keyword = /adalanche\-.{0,1000}\.exe/ nocase ascii wide
        // Description: Active Directory ACL Visualizer and Explorer - who's really Domain Admin?
        // Reference: https://github.com/lkarlslund/Adalanche
        $string8_adalanche_offensive_tool_keyword = /Adalanche\.git/ nocase ascii wide
