        // Description: VNCViewer is an RMM tool that has been exploited by attackers to gain unauthorized remote access 
        // Reference: N/A
        $string6_vncviewer_greyware_tool_keyword = /VNCViewer\.exe/ nocase ascii wide

    condition:
        any of them
}


