    strings:
        // Description: python implementation of SharpGPOAbuse
        // Reference: https://github.com/Hackndo/pyGPOAbuse
        $string1_pyGPOAbuse_offensive_tool_keyword = /\s\-hashes\slm\:nt\s\-gpo\-id\s.{0,1000}\s\-powershell\s/ nocase ascii wide
        // Description: python implementation of SharpGPOAbuse
        // Reference: https://github.com/Hackndo/pyGPOAbuse
        $string2_pyGPOAbuse_offensive_tool_keyword = /pygpoabuse\.py/ nocase ascii wide

    condition:
        any of them
}


rule rule_pyLAPS_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'pyLAPS' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
