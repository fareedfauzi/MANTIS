        $string47_powerview_offensive_tool_keyword = "Get-WMIRegCachedRDPConnection" nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string48_powerview_offensive_tool_keyword = "Get-WMIRegLastLoggedOn" nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string49_powerview_offensive_tool_keyword = "Get-WMIRegMountedDrive" nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string50_powerview_offensive_tool_keyword = "Invoke-EnumerateLocalAdmin" nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string51_powerview_offensive_tool_keyword = "Invoke-Kerberoast" nocase ascii wide
        // Description: PowerView.py is an alternative for the awesome original PowerView.ps1
        // Reference: https://github.com/aniqfakhrul/powerview.py
        $string52_powerview_offensive_tool_keyword = "Invoke-Kerberoast" nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string53_powerview_offensive_tool_keyword = "Invoke-RevertToSelf" nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string54_powerview_offensive_tool_keyword = /Invoke\-UserImpersonation\s\-Credential\s.{0,1000}\s\-Quiet/ nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string55_powerview_offensive_tool_keyword = "Invoke-UserImpersonation" nocase ascii wide
        // Description: PowerView.py is an alternative for the awesome original PowerView.ps1
        // Reference: https://github.com/aniqfakhrul/powerview.py
        $string56_powerview_offensive_tool_keyword = /kerberoast\.py/ nocase ascii wide
        // Description: PowerView.py is an alternative for the awesome original PowerView.ps1
        // Reference: https://github.com/aniqfakhrul/powerview.py
        $string57_powerview_offensive_tool_keyword = /ldap3\.git\@powerview\.py/ nocase ascii wide
        // Description: PowerView.py is an alternative for the awesome original PowerView.ps1
        // Reference: https://github.com/aniqfakhrul/powerview.py
        $string58_powerview_offensive_tool_keyword = /ldapattack\.py/ nocase ascii wide
        // Description: PowerView.py is an alternative for the awesome original PowerView.ps1
        // Reference: https://github.com/aniqfakhrul/powerview.py
        $string59_powerview_offensive_tool_keyword = /PetitPotam\.py/ nocase ascii wide
        // Description: PowerView.py is an alternative for the awesome original PowerView.ps1
        // Reference: https://github.com/aniqfakhrul/powerview.py
        $string60_powerview_offensive_tool_keyword = "pip3 install powerview " nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains. It contains a set of pure-PowerShell replacements for various windows net commands. which utilize PowerShell AD hooks and underlying Win32 API functions to perform useful Windows domain functionality It also implements various useful metafunctions. including some custom-written user-hunting functions which will identify where on the network specific users are logged into. It can also check which machines on the domain the current user has local administrator access on. Several functions for the enumeration and abuse of domain trusts also exist
        // Reference: https://github.com/PowerShellMafia/PowerSploit/tree/master/Recon
        $string61_powerview_offensive_tool_keyword = /PowerView\.ps1/ nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string62_powerview_offensive_tool_keyword = /PowerView\.ShareInfo/ nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string63_powerview_offensive_tool_keyword = /PowerView\.SPNTicket/ nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/anthonysecurity/redteam_toolkit/blob/master/References/PowerView-2.0-tricks.ps1
        $string64_powerview_offensive_tool_keyword = /PowerView\-2\.0\-tricks\.ps1/ nocase ascii wide
        // Description: PowerView is a PowerShell tool to gain network situational awareness on Windows domains
        // Reference: https://github.com/PowerShellMafia/PowerSploit/blob/master/Recon/PowerView.ps1
        $string65_powerview_offensive_tool_keyword = /System\.IdentityModel\.Tokens\.KerberosRequestorSecurityToken\s\-ArgumentList\s\$UserSPN/ nocase ascii wide

    condition:
        any of them
}


rule rule_PPLBlade_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PPLBlade' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PPLBlade"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string1_PPLBlade_offensive_tool_keyword = /\s\-\-dumpmode\snetwork\s\-\-network\sraw\s\-\-ip\s.{0,1000}\s\-\-port\s/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string2_PPLBlade_offensive_tool_keyword = " --dumpmode network --network smb " nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string3_PPLBlade_offensive_tool_keyword = /\s\-\-dumpname\slsass\.dmp/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string4_PPLBlade_offensive_tool_keyword = " --key PPLBlade" nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string5_PPLBlade_offensive_tool_keyword = /\s\-\-mode\sdecrypt\s\-\-dumpname\s.{0,1000}\.dmp\s\-\-key\s/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string6_PPLBlade_offensive_tool_keyword = /\s\-\-mode\sdump\s\-\-name\s.{0,1000}\.exe\s\-\-handle\sprocexp\s\-\-obfuscate/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string7_PPLBlade_offensive_tool_keyword = /\s\-\-mode\sdump\s\-\-name\slsass\.exe/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string8_PPLBlade_offensive_tool_keyword = /\/decrypted\.dmp/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string9_PPLBlade_offensive_tool_keyword = /\/PPLBlade\.git/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string10_PPLBlade_offensive_tool_keyword = /\[\+\]\sDeobfuscated\sdump\ssaved\sin\sfile\sdecrypted\.dmp/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string11_PPLBlade_offensive_tool_keyword = /\\decrypted\.dmp/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string12_PPLBlade_offensive_tool_keyword = /\\PPLBlade\-main/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string13_PPLBlade_offensive_tool_keyword = "dothatlsassthing" nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string14_PPLBlade_offensive_tool_keyword = /PPLBlade\.dmp/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string15_PPLBlade_offensive_tool_keyword = /PPLBlade\.exe/ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string16_PPLBlade_offensive_tool_keyword = /PPLBlade\-main\./ nocase ascii wide
        // Description: Protected Process Dumper Tool that support obfuscating memory dump and transferring it on remote workstations without dropping it onto the disk.
        // Reference: https://github.com/tastypepperoni/PPLBlade
        $string17_PPLBlade_offensive_tool_keyword = "tastypepperoni/PPLBlade" nocase ascii wide

    condition:
        any of them
}


rule rule_ppldump_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ppldump' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ppldump"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string1_ppldump_offensive_tool_keyword = "6E8D2C12-255B-403C-9EF3-8A097D374DB2" nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string2_ppldump_offensive_tool_keyword = /dllexploit\./ nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string3_ppldump_offensive_tool_keyword = "FCE81BDA-ACAC-4892-969E-0414E765593B" nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string4_ppldump_offensive_tool_keyword = /lsass\.exe.{0,1000}\.dmp/ nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string5_ppldump_offensive_tool_keyword = "PPLdump" nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string6_ppldump_offensive_tool_keyword = /PPLdump\.exe/ nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string7_ppldump_offensive_tool_keyword = /PPLdump64\.exe/ nocase ascii wide
        // Description: Dump the memory of a PPL with a userland exploit
        // Reference: https://github.com/itm4n/PPLdump
        $string8_ppldump_offensive_tool_keyword = "PPLdumpDll" nocase ascii wide

    condition:
        any of them
}


rule rule_PPLFault_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PPLFault' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PPLFault"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Exploits a TOCTOU in Windows Code Integrity to achieve arbitrary code execution as WinTcb-Light then dump a specified process.
        // Reference: https://github.com/gabriellandau/PPLFault
        $string1_PPLFault_offensive_tool_keyword = "/DumpShellcode/" nocase ascii wide
        // Description: Exploits a TOCTOU in Windows Code Integrity to achieve arbitrary code execution as WinTcb-Light then dump a specified process.
        // Reference: https://github.com/gabriellandau/PPLFault
        $string2_PPLFault_offensive_tool_keyword = /\/Nofault\.exe/ nocase ascii wide
        // Description: Exploits a TOCTOU in Windows Code Integrity to achieve arbitrary code execution as WinTcb-Light then dump a specified process.
        // Reference: https://github.com/gabriellandau/PPLFault
        $string3_PPLFault_offensive_tool_keyword = "/PPLFault/" nocase ascii wide
