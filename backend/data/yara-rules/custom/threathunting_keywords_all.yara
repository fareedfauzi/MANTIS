rule rule_privexchange_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'privexchange' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "privexchange"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Exchange your privileges for Domain Admin privs by abusing Exchange
        // Reference: https://github.com/dirkjanm/PrivExchange
        $string1_privexchange_offensive_tool_keyword = /\/PrivExchange\.git/ nocase ascii wide
        // Description: Exchange your privileges for Domain Admin privs by abusing Exchange
        // Reference: https://github.com/dirkjanm/PrivExchange
        $string2_privexchange_offensive_tool_keyword = "dirkjanm/PrivExchange" nocase ascii wide
        // Description: Exchange your privileges for Domain Admin privs by abusing Exchange
        // Reference: https://github.com/dirkjanm/PrivExchange
        $string3_privexchange_offensive_tool_keyword = /httpattack\.py/ nocase ascii wide
        // Description: Exchange your privileges for Domain Admin privs by abusing Exchange
        // Reference: https://github.com/dirkjanm/PrivExchange
        $string4_privexchange_offensive_tool_keyword = /privexchange\.py/ nocase ascii wide
        // Description: Exchange your privileges for Domain Admin privs by abusing Exchange
        // Reference: https://github.com/dirkjanm/PrivExchange
        $string5_privexchange_offensive_tool_keyword = /PrivExchange\-master\.zip/ nocase ascii wide

    condition:
        any of them
}


rule rule_PrivFu_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PrivFu' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PrivFu"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: ArtsOfGetSystem privesc tools
        // Reference: https://github.com/daem0nc0re/PrivFu/
        $string1_PrivFu_offensive_tool_keyword = /\.exe\s\-i\s\-c\spowershell\s\-e\snetlogon/ nocase ascii wide
        // Description: execute process as NT SERVICE\TrustedInstaller group account
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string2_PrivFu_offensive_tool_keyword = /\.exe\s\-m\sexec\s\-c\s\\"whoami\s\/priv/ nocase ascii wide
        // Description: execute process as NT SERVICE\TrustedInstaller group account
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string3_PrivFu_offensive_tool_keyword = /\.exe\s\-m\sexec\s\-s\s\-e\sS\-1\-5\-20/ nocase ascii wide
        // Description: manage user right without secpol.msc
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string4_PrivFu_offensive_tool_keyword = /\.exe\s\-m\sfind\s\-r\stcb/ nocase ascii wide
        // Description: execute process as NT SERVICE\TrustedInstaller group account
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string5_PrivFu_offensive_tool_keyword = /\.exe\s\-m\ssid\s\-l\s\-s\sS\-1\-5\-18/ nocase ascii wide
        // Description: SeTcbPrivilege exploitation
        // Reference: https://github.com/daem0nc0re/PrivFu/
        $string6_PrivFu_offensive_tool_keyword = /\/BackgroundShell\.exe/ nocase ascii wide
        // Description: SeTcbPrivilege exploitation
        // Reference: https://github.com/daem0nc0re/PrivFu/
        $string7_PrivFu_offensive_tool_keyword = /\/DesktopShell\.exe/ nocase ascii wide
        // Description: ArtsOfGetSystem privesc tools
        // Reference: https://github.com/daem0nc0re/PrivFu/
        $string8_PrivFu_offensive_tool_keyword = /\/PrintSpoofer\.exe/ nocase ascii wide
        // Description: Kernel Mode WinDbg extension for token privilege edit
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string9_PrivFu_offensive_tool_keyword = /\/PrivEditor\.dll/ nocase ascii wide
        // Description: Kernel mode WinDbg extension and PoCs for token privilege investigation.
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string10_PrivFu_offensive_tool_keyword = /\/PrivFu\.git/ nocase ascii wide
        // Description: PoCs for sensitive token privileges such SeDebugPrivilege
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string11_PrivFu_offensive_tool_keyword = /\/SeAuditPrivilegePoC\.exe/ nocase ascii wide
        // Description: PoCs for sensitive token privileges such SeDebugPrivilege
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string12_PrivFu_offensive_tool_keyword = /\/SeBackupPrivilegePoC\.exe/ nocase ascii wide
        // Description: get SYSTEM integrity level by abusing arbitrary kernel write vulnerability and token privileges
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string13_PrivFu_offensive_tool_keyword = /\/SecondaryLogonVariant\.exe/ nocase ascii wide
        // Description: enable or disable specific token privileges for a process
        // Reference: https://github.com/daem0nc0re/PrivFu
        $string14_PrivFu_offensive_tool_keyword = /\/SwitchPriv\.exe/ nocase ascii wide
