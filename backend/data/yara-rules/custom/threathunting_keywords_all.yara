rule rule_spoolsploit_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'spoolsploit' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "spoolsploit"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string1_spoolsploit_offensive_tool_keyword = " -a nightmare" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string2_spoolsploit_offensive_tool_keyword = " -a spoolsample" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string3_spoolsploit_offensive_tool_keyword = /\sevil\.corp\s/ nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string4_spoolsploit_offensive_tool_keyword = " spoolsploit " nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string5_spoolsploit_offensive_tool_keyword = /\/smbserver\/smb_server\.py/ nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string6_spoolsploit_offensive_tool_keyword = "/ssploit/" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string7_spoolsploit_offensive_tool_keyword = "--attack nightmare" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string8_spoolsploit_offensive_tool_keyword = "--attack spoolsample" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string9_spoolsploit_offensive_tool_keyword = "BeetleChunks/SpoolSploit" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string10_spoolsploit_offensive_tool_keyword = /impacket\./ nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string11_spoolsploit_offensive_tool_keyword = /malicious\.dll/ nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string12_spoolsploit_offensive_tool_keyword = /PrintNightmare\./ nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string13_spoolsploit_offensive_tool_keyword = /spool_sploit\.py/ nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string14_spoolsploit_offensive_tool_keyword = "SpoolSploit/" nocase ascii wide
        // Description: A collection of Windows print spooler exploits containerized with other utilities for practical exploitation.
        // Reference: https://github.com/BeetleChunks/SpoolSploit
        $string15_spoolsploit_offensive_tool_keyword = "spoolsploit:latest" nocase ascii wide

    condition:
        any of them
}


rule rule_Spray365_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Spray365' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Spray365"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string1_Spray365_offensive_tool_keyword = " --custom_user_agent" nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string2_Spray365_offensive_tool_keyword = /\sgenerate\saudit\s\-ep\s.{0,1000}\-\-passwords_in_userfile/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string3_Spray365_offensive_tool_keyword = /\sgenerate\snormal\s\-ep\s.{0,1000}\s\-d\s.{0,1000}\s\-u\s.{0,1000}\s\-pf\s/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string4_Spray365_offensive_tool_keyword = /\sgenerate\snormal\s\-ep\sex\-plan\.s365\s/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string5_Spray365_offensive_tool_keyword = " --random_user_agent" nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string6_Spray365_offensive_tool_keyword = " --show_invalid_creds" nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string7_Spray365_offensive_tool_keyword = /\sspray\s\-ep\sex\-plan\.s365/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string8_Spray365_offensive_tool_keyword = /\.py\sspray\s\-ep\s/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string9_Spray365_offensive_tool_keyword = /\/spray\/spray\.py/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string10_Spray365_offensive_tool_keyword = "/Spray365" nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string11_Spray365_offensive_tool_keyword = /Spray365\.git/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string12_Spray365_offensive_tool_keyword = /spray365\.py/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string13_Spray365_offensive_tool_keyword = /spray365_results_.{0,1000}\.json/ nocase ascii wide
        // Description: Spray365 is a password spraying tool that identifies valid credentials for Microsoft accounts (Office 365 / Azure AD).
        // Reference: https://github.com/MarkoH17/Spray365
        $string14_Spray365_offensive_tool_keyword = /\-\-user_file.{0,1000}\-\-password_file/ nocase ascii wide

    condition:
        any of them
}


