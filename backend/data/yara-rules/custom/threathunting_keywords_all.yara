}


rule rule_chntpw_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'chntpw' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "chntpw"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string1_chntpw_offensive_tool_keyword = " install chntpw" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string2_chntpw_offensive_tool_keyword = /\ssam_reset_all_pw\(/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string3_chntpw_offensive_tool_keyword = "/chntpw -"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string4_chntpw_offensive_tool_keyword = "/chntpw-140201" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string5_chntpw_offensive_tool_keyword = "/sampasswd"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string6_chntpw_offensive_tool_keyword = /\/samusrgrp\./
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string7_chntpw_offensive_tool_keyword = "/sbin/chntpw"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string8_chntpw_offensive_tool_keyword = "/sbin/sampasswd"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string9_chntpw_offensive_tool_keyword = "/sbin/samunlock"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string10_chntpw_offensive_tool_keyword = "/sbin/samusrgrp"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string11_chntpw_offensive_tool_keyword = /\/usb140201\.zip/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string12_chntpw_offensive_tool_keyword = "/usr/share/doc/chntpw"
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string13_chntpw_offensive_tool_keyword = /\\chntpw\.c/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string14_chntpw_offensive_tool_keyword = /\\chntpw\-140201/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string15_chntpw_offensive_tool_keyword = /\\sampasswd\./ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string16_chntpw_offensive_tool_keyword = "> chntpw Main Interactive Menu <" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string17_chntpw_offensive_tool_keyword = "---------------------> SYSKEY CHECK <-----------------------" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string18_chntpw_offensive_tool_keyword = "0bb60287c127bcef5b7018b3b692eb7a91dab1a034fa65780b5e14333a63f62b" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string19_chntpw_offensive_tool_keyword = "1083596da1857862551870eb6fd06c26bdd2cac7698b27034f6cc8d773a3664b" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string20_chntpw_offensive_tool_keyword = "2acfc293585568970aa8ea676822e0c905d4eec4c0f8c743f58ce1b099dbe29d" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string21_chntpw_offensive_tool_keyword = "555009ba8f9b57011fef7ca143c78e15d11bce2e471f6b742cbddda5c2d12e60" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string22_chntpw_offensive_tool_keyword = "c88d86aee55b31827ab4782d05bd44922276955909c43c69f0fb15377cc64374" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string23_chntpw_offensive_tool_keyword = "c9598fe89c9f4ca470ce47b556fea6289b05b1850c629c2c2f51f2efc995247c" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string24_chntpw_offensive_tool_keyword = "chntpw Edit User Info & Passwords" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string25_chntpw_offensive_tool_keyword = /chntpw\.com\/download/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string26_chntpw_offensive_tool_keyword = /chntpw\.static/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string27_chntpw_offensive_tool_keyword = /Failed\slogins\sbefore\slockout\sis\:\s.{0,1000}max_sam_lock/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string28_chntpw_offensive_tool_keyword = /LANMAN\spassword\sIS\showever\sset\.\sWill\snow\sinstall\snew\spassword\sas\sNT\spass\sinstead/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string29_chntpw_offensive_tool_keyword = /pkgs\.org\/download\/chntpw/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string30_chntpw_offensive_tool_keyword = /pogostick\.net\/\~pnh\/ntpasswd\// nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string31_chntpw_offensive_tool_keyword = "sampasswd -" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string32_chntpw_offensive_tool_keyword = "samunlock -" nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string33_chntpw_offensive_tool_keyword = "samusrgrp -a " nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string34_chntpw_offensive_tool_keyword = "samusrgrp -r " nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string35_chntpw_offensive_tool_keyword = /SYSKEY\sRESET\!\\nNow\splease\sset\snew\sadministrator\spassword\!/ nocase ascii wide
        // Description: reset a password on your system
        // Reference: https://pogostick.net/~pnh/ntpasswd/chntpw-source-140201.zip
        $string36_chntpw_offensive_tool_keyword = /Will\sadd\sthe\suser\sto\sthe\sadministrator\sgroup\s\(0x220\)/ nocase ascii wide

    condition:
        any of them
}


rule rule_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Chrome-App-Bound-Encryption-Decryption' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Chrome-App-Bound-Encryption-Decryption"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string1_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = " App-Bound Encryption Decryption process" nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string2_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\schrome_decrypt\.cpp\s/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string3_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\schrome_decrypt\.cpp/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string4_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\schrome_decrypt\.exe/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string5_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\/chrome_decrypt\.exe/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string6_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\/Chrome\-App\-Bound\-Encryption\-Decryption\.git/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string7_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\[\+\]\sProxy\sblanket\sset\ssuccessfully/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string8_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\\chrome_decrypt\.cpp/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string9_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /\\chrome_decrypt\.exe/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string10_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = "350cfd6e53c72d9c3d2fa109cc73e69171d8f1bed85ced979483592908925aff" nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string11_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /Alexander\sHagenah\s\(\@xaitax\)/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string12_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = "'app_bound_encrypted_key' not found in Local State file" nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string13_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = "b41498d3c4883fb374dce5c9923c60b5ac901775909ae74d13a05851b80cc221" nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string14_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = "Chrome App-Bound Encryption - Decryption" nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string15_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /ChromeAppBound\:\:BytesToHexString\(en\scrypted_key\.data/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string16_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = /MIDL_INTERFACE\(\\"A949CB4E\-C4F9\-44C4\-B213\-6BF8AA9AC69C\\"\)/ nocase ascii wide
        // Description: Tool to decrypt App-Bound encrypted keys in Chrome using the IElevator COM interface with path validation and encryption protections
        // Reference: https://github.com/xaitax/Chrome-App-Bound-Encryption-Decryption
        $string17_Chrome_App_Bound_Encryption_Decryption_offensive_tool_keyword = "xaitax/Chrome-App-Bound-Encryption-Decryption" nocase ascii wide

    condition:
        any of them
}


rule rule_chromedump_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'chromedump' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "chromedump"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: ChromeDump is a small tool to dump all JavaScript and other ressources going through the browser
        // Reference: https://github.com/g4l4drim/ChromeDump
        $string1_chromedump_offensive_tool_keyword = "/ChromeDump/" nocase ascii wide
        // Description: ChromeDump is a small tool to dump all JavaScript and other ressources going through the browser
        // Reference: https://github.com/g4l4drim/ChromeDump
        $string2_chromedump_offensive_tool_keyword = /\/dumpweb\.log/
        // Description: ChromeDump is a small tool to dump all JavaScript and other ressources going through the browser
        // Reference: https://github.com/g4l4drim/ChromeDump
        $string3_chromedump_offensive_tool_keyword = /ChromeDump\.git/ nocase ascii wide
        // Description: ChromeDump is a small tool to dump all JavaScript and other ressources going through the browser
        // Reference: https://github.com/g4l4drim/ChromeDump
        $string4_chromedump_offensive_tool_keyword = /chromedump\.py/ nocase ascii wide
        // Description: ChromeDump is a small tool to dump all JavaScript and other ressources going through the browser
        // Reference: https://github.com/g4l4drim/ChromeDump
        $string5_chromedump_offensive_tool_keyword = /ChromeDump\-main\.zip/ nocase ascii wide

    condition:
        any of them
}


rule rule_ChromeKatz_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ChromeKatz' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ChromeKatz"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string1_ChromeKatz_offensive_tool_keyword = /\.exe\s\.\\chrome\.DMP/ nocase ascii wide
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string2_ChromeKatz_offensive_tool_keyword = /\.exe\s\.\\msedge\.DMP/ nocase ascii wide
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string3_ChromeKatz_offensive_tool_keyword = /\/ChromeKatz\.git/ nocase ascii wide
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string4_ChromeKatz_offensive_tool_keyword = /\\BOF\-Template\\x64\\/ nocase ascii wide
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string5_ChromeKatz_offensive_tool_keyword = /\\ChromeKatz\.sln/ nocase ascii wide
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string6_ChromeKatz_offensive_tool_keyword = /\\CookieKatz\.vcxproj/ nocase ascii wide
        // Description: Dump cookies directly from Chrome process memory
        // Reference: https://github.com/Meckazin/ChromeKatz
        $string7_ChromeKatz_offensive_tool_keyword = /\\CookieKatz\-BOF\\/ nocase ascii wide
