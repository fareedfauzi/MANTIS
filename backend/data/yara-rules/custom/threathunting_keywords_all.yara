        tool = "processhacker"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: dump lsass process with processhacker
        // Reference: https://learn.microsoft.com/en-us/sysinternals/downloads/procdump
        $string1_processhacker_offensive_tool_keyword = /\<Data\sName\=\'PipeName\'\>\\lsass\<\/Data\>\<Data\sName\=\'Image\'\>.{0,1000}ProcessHacker.{0,1000}\<\/Data\>/ nocase ascii wide

    condition:
        any of them
}


