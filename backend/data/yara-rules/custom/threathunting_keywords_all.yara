rule rule_dnsrecon_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnsrecon' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnsrecon"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: DNSRecon is a Python port of a Ruby script that I wrote to learn the language and about DNS in early 2007. This time I wanted to learn about Python and extend the functionality of the original tool and in the process re-learn how DNS works and how could it be used in the process of a security assessment and network troubleshooting.
        // Reference: https://github.com/darkoperator/dnsrecon
        $string1_dnsrecon_offensive_tool_keyword = /\s\-d\s.{0,1000}\s\-t\szonewalk/
        // Description: DNSRecon is a Python port of a Ruby script that I wrote to learn the language and about DNS in early 2007. This time I wanted to learn about Python and extend the functionality of the original tool and in the process re-learn how DNS works and how could it be used in the process of a security assessment and network troubleshooting.
        // Reference: https://github.com/darkoperator/dnsrecon
        $string2_dnsrecon_offensive_tool_keyword = "dnsrecon"

    condition:
        any of them
}


rule rule_DNSStager_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'DNSStager' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "DNSStager"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string1_DNSStager_offensive_tool_keyword = /\sdnsstager\.py/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string2_DNSStager_offensive_tool_keyword = " IPV6 addresses xored " nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string3_DNSStager_offensive_tool_keyword = /\s\-\-payload\s.{0,1000}\s\-\-shellcode_path\s.{0,1000}\s\-\-xorkey\s/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string4_DNSStager_offensive_tool_keyword = " --payload x64/c/ipv6 " nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string5_DNSStager_offensive_tool_keyword = /\/DNSStager\.git/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string6_DNSStager_offensive_tool_keyword = /\/dnsstager\.py/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string7_DNSStager_offensive_tool_keyword = /\\dnsstager\.py/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string8_DNSStager_offensive_tool_keyword = /build_c_xor_ipv6\(/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string9_DNSStager_offensive_tool_keyword = /build_c_xor_ipv6_dll\(/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string10_DNSStager_offensive_tool_keyword = /build_golang_xor_ipv6\(/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string11_DNSStager_offensive_tool_keyword = "DNSStager payloads Available" nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string12_DNSStager_offensive_tool_keyword = "DNSStager will " nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string13_DNSStager_offensive_tool_keyword = /encode_xor_shellcode\(/ nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string14_DNSStager_offensive_tool_keyword = "f15f6182ca98bb702c2578efc0aef6e35d8237b89a00a588364bb7e068b132fa" nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string15_DNSStager_offensive_tool_keyword = "mhaskar/DNSStager" nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string16_DNSStager_offensive_tool_keyword = "run DNSStager as root" nocase ascii wide
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string17_DNSStager_offensive_tool_keyword = /sudo\s\.\/dnsstager/
        // Description: DNSStager is an open-source project based on Python used to hide and transfer your payload using DNS.
        // Reference: https://github.com/mhaskar/DNSStager
        $string18_DNSStager_offensive_tool_keyword = "We recommend to XOR your shellcode before you transfer it" nocase ascii wide

    condition:
        any of them
}


rule rule_dnsteal_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnsteal' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnsteal"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: This is a fake DNS server that allows you to stealthily extract files from a victim machine through DNS requests.
        // Reference: https://github.com/m57/dnsteal
        $string1_dnsteal_offensive_tool_keyword = "/dnsteal" nocase ascii wide
        // Description: This is a fake DNS server that allows you to stealthily extract files from a victim machine through DNS requests.
        // Reference: https://github.com/m57/dnsteal
        $string2_dnsteal_offensive_tool_keyword = /dnsteal\.git/ nocase ascii wide
        // Description: This is a fake DNS server that allows you to stealthily extract files from a victim machine through DNS requests.
        // Reference: https://github.com/m57/dnsteal
        $string3_dnsteal_offensive_tool_keyword = /dnsteal\.py/ nocase ascii wide
        // Description: This is a fake DNS server that allows you to stealthily extract files from a victim machine through DNS requests.
        // Reference: https://github.com/m57/dnsteal
        $string4_dnsteal_offensive_tool_keyword = "dnsteal-master" nocase ascii wide

    condition:
        any of them
}


rule rule_DNSTracer_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'DNSTracer' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "DNSTracer"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: This is a python application that traces how a DNS query is performed from a client machine to the server.
        // Reference: https://github.com/pcoder/DNSTracer
        $string1_DNSTracer_offensive_tool_keyword = "dnstracer" nocase ascii wide

    condition:
        any of them
}


rule rule_dnstwist_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'dnstwist' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "dnstwist"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string1_dnstwist_offensive_tool_keyword = " --fuzzers addition" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string2_dnstwist_offensive_tool_keyword = " --fuzzers bitsquatting" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string3_dnstwist_offensive_tool_keyword = " --fuzzers cyrillic" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string4_dnstwist_offensive_tool_keyword = " --fuzzers dictionary" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string5_dnstwist_offensive_tool_keyword = " --fuzzers homoglyph" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string6_dnstwist_offensive_tool_keyword = " --fuzzers hyphenation" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string7_dnstwist_offensive_tool_keyword = " --fuzzers insertion" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string8_dnstwist_offensive_tool_keyword = " --fuzzers omission" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string9_dnstwist_offensive_tool_keyword = " --fuzzers repetition" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string10_dnstwist_offensive_tool_keyword = " --fuzzers replacement" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string11_dnstwist_offensive_tool_keyword = " --fuzzers subdomain" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string12_dnstwist_offensive_tool_keyword = " --fuzzers transposition" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string13_dnstwist_offensive_tool_keyword = " --fuzzers vowel-swap" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string14_dnstwist_offensive_tool_keyword = "dnstwist" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string15_dnstwist_offensive_tool_keyword = /Mozilla\/5\.0\s\(.{0,1000}\-bit\)\sdnstwist/ nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string16_dnstwist_offensive_tool_keyword = "randomalice1986@" nocase ascii wide
        // Description: See what sort of trouble users can get in trying to type your domain name. Find lookalike domains that adversaries can use to attack you. Can detect typosquatters. phishing attacks. fraud. and brand impersonation. Useful as an additional source of targeted threat intelligence.
        // Reference: https://github.com/elceef/dnstwist
        $string17_dnstwist_offensive_tool_keyword = "randombob1986@" nocase ascii wide

    condition:
        any of them
}


