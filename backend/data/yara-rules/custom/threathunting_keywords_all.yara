rule rule_ProxyShell_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ProxyShell' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ProxyShell"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Microsoft Exchange Servers exploits - ProxyLogon and ProxyShell  CVE-2021-27065 CVE-2021-34473 CVE-2021-34523 CVE-2021-31207
        // Reference: https://www.cert.ssi.gouv.fr/uploads/ANSSI_TLPWHITE_ProxyShell_ProxyLogon_Sigma_yml.txt
        $string1_ProxyShell_offensive_tool_keyword = /New\-MailBoxExportRequest\s\-Mailbox\s.{0,1000}\@.{0,1000}\s\-FilePath\s.{0,1000}\.aspx/ nocase ascii wide
        // Description: Microsoft Exchange Servers exploits - ProxyLogon and ProxyShell  CVE-2021-27065 CVE-2021-34473 CVE-2021-34523 CVE-2021-31207
        // Reference: https://www.cert.ssi.gouv.fr/uploads/ANSSI_TLPWHITE_ProxyShell_ProxyLogon_Sigma_yml.txt
        $string2_ProxyShell_offensive_tool_keyword = /Set\-OabVirtualDirectory\s\-ExternalUrl\s\'http.{0,1000}\:\/\/.{0,1000}function\sPage_Load\(\)\{.{0,1000}\}\<\/script\>/ nocase ascii wide

    condition:
        any of them
}


rule rule_PRT_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PRT' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PRT"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: PRET is a new tool for printer security testing developed in the scope of a Masters Thesis at Ruhr University Bochum. It connects to a device via network or USB and exploits the features of a given printer language. Currently PostScript. PJL and PCL are supported which are spoken by most laser printers. This allows cool stuff like capturing or manipulating print jobs. accessing the printers file system and memory or even causing physical damage to the device. All attacks are documented in detail in the Hacking Printers Wiki. The main idea of PRET is to facilitate the communication between the end-user and the printer. Thus. after entering a UNIX-like command. PRET translates it to PostScript. PJL or PCL. sends it to the printer. evaluates the result and translates it back to a user-friendly format. PRET offers a whole bunch of commands useful for printer attacks and fuzzing
        // Reference: https://github.com/RUB-NDS/PRT
        $string1_PRT_offensive_tool_keyword = "Exploitation Toolkit"

    condition:
        any of them
}


rule rule_PS2EXE_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PS2EXE' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PS2EXE"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string1_PS2EXE_offensive_tool_keyword = /\sPS2EXE\.ps1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string2_PS2EXE_offensive_tool_keyword = /\/PS2EXE\.git/ nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string3_PS2EXE_offensive_tool_keyword = /\/PS2EXE\.ps1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string4_PS2EXE_offensive_tool_keyword = "/PS2EXE/" nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string5_PS2EXE_offensive_tool_keyword = /\\PS2EXE\.ps1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string6_PS2EXE_offensive_tool_keyword = /\\Win\-PS2EXE/ nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string7_PS2EXE_offensive_tool_keyword = "760c4649c5acd734d931ee64ebfc62eb19fa5c45137f4712b84aba7a356cda91" nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string8_PS2EXE_offensive_tool_keyword = "Install-Module ps2exe" nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string9_PS2EXE_offensive_tool_keyword = "Invoke-ps2exe" nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string10_PS2EXE_offensive_tool_keyword = "Leo4j/PS2EXE" nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string11_PS2EXE_offensive_tool_keyword = "MScholtes/PS2EXE" nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string12_PS2EXE_offensive_tool_keyword = /ps\.AddScript\(Encoding\.UTF8\.GetString\(Convert\.FromBase64String\(script\)/ nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string13_PS2EXE_offensive_tool_keyword = /PS1ToEXE.{0,1000}PS2EXE\.ps1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string14_PS2EXE_offensive_tool_keyword = "ps2exe -" nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string15_PS2EXE_offensive_tool_keyword = /ps2exe\s.{0,1000}\.ps1.{0,1000}\.exe/ nocase ascii wide
        // Description: Convert Powershell scripts to EXEs
        // Reference: https://github.com/Leo4j/PS2EXE
        $string16_PS2EXE_offensive_tool_keyword = /PS2EXE\s\-content\s\$.{0,1000}\s\-outputFile\s/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string17_PS2EXE_offensive_tool_keyword = /ps2exe\.ps1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string18_PS2EXE_offensive_tool_keyword = /ps2exe\.psd1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string19_PS2EXE_offensive_tool_keyword = /ps2exe\.psm1/ nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string20_PS2EXE_offensive_tool_keyword = "PS2EXE-master" nocase ascii wide
        // Description: Module to compile powershell scripts to executables
        // Reference: https://github.com/MScholtes/PS2EXE
        $string21_PS2EXE_offensive_tool_keyword = /Win\-PS2EXE\.exe/ nocase ascii wide

    condition:
        any of them
}


