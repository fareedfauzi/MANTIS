        // Reference: https://gist.github.com/adamsvoboda/8e248c6b7fb812af5d04daba141c867e
        $string4_SentinelAgent_greyware_tool_keyword = /\\temp\\__SentinelAgentKernel\.dmp/ nocase ascii wide
