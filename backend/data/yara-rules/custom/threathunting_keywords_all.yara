        // Reference: https://github.com/trustedsec/CS-Situational-Awareness-BOF
        $string2245_cobaltstrike_offensive_tool_keyword = /vssenum\.x64\./ nocase ascii wide
        // Description: Situational Awareness commands implemented using Beacon Object Files
        // Reference: https://github.com/trustedsec/CS-Situational-Awareness-BOF
        $string2246_cobaltstrike_offensive_tool_keyword = /vssenum\.x86\./ nocase ascii wide
