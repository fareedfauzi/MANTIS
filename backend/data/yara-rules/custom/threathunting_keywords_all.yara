rule rule_Weevely3_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Weevely3' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Weevely3"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string1_Weevely3_offensive_tool_keyword = /\/reversetcp\.py/ nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string2_Weevely3_offensive_tool_keyword = /\/weevely\.py/ nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string3_Weevely3_offensive_tool_keyword = "epinna/weevely3" nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string4_Weevely3_offensive_tool_keyword = /perl\s\-e\s\'use\sSocket\;\$i\=\\"\$\{lhost\}\\"\;\$p\=\$\{port\}/ nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string5_Weevely3_offensive_tool_keyword = /rm\s\-rf\s\/tmp\/backpipe\;mknod\s\/tmp\/backpipe\sp\;telnet\s.{0,1000}\s0\<\/tmp\/backpipe/ nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string6_Weevely3_offensive_tool_keyword = /ruby\s\-rsocket\s\-e\'f\=TCPSocket\.open\(\\"\$\{lhost\}\\"\,\$\{port\}\)\.to_i/ nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string7_Weevely3_offensive_tool_keyword = /sleep\s1\;\s\/bin\/bash\s\-c\s\\\'\$\{shell\}\s0\<\/dev\/tcp\/\$\{lhost\}\/\$\{port\}\s1\>\&0\s2\>\&0/
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string8_Weevely3_offensive_tool_keyword = /sleep\s1\;\srm\s\-rf\s\/tmp\/f\;mkfifo\s\/tmp\/f\;cat\s\/tmp\/f\|\$\{shell\}\s\-i\s2\>\&1\|nc\s\$\{lhost\}\s\$\{port\}\s\>\/tmp\/f/ nocase ascii wide
        // Description: Weevely is a web shell designed for post-exploitation purposes that can be extended over the network at runtime
        // Reference: https://github.com/epinna/weevely3
        $string9_Weevely3_offensive_tool_keyword = "weevely generate " nocase ascii wide

    condition:
        any of them
}


rule rule_wePWNise_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'wePWNise' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "wePWNise"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: wePWNise is proof-of-concept Python script which generates VBA code that can be used in Office macros or templates. It was designed with automation and integration in mind. targeting locked down environment scenarios. The tool enumerates Software Restriction Policies (SRPs) and EMET mitigations and dynamically identifies safe binaries to inject payloads into. wePWNise integrates with existing exploitation frameworks (e.g. Metasploit. Cobalt Strike) and it also accepts any custom payload in raw format.
        // Reference: https://github.com/FSecureLABS/wePWNise
        $string1_wePWNise_offensive_tool_keyword = "wePWNise" nocase ascii wide

    condition:
        any of them
}


rule rule_WerTrigger_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'WerTrigger' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "WerTrigger"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Weaponizing for privileged file writes bugs with windows problem reporting
        // Reference: https://github.com/sailay1996/WerTrigger
        $string1_WerTrigger_offensive_tool_keyword = /\/WerTrigger\.git/ nocase ascii wide
        // Description: Weaponizing for privileged file writes bugs with windows problem reporting
        // Reference: https://github.com/sailay1996/WerTrigger
        $string2_WerTrigger_offensive_tool_keyword = /WerTrigger\.exe/ nocase ascii wide
        // Description: Weaponizing for privileged file writes bugs with windows problem reporting
        // Reference: https://github.com/sailay1996/WerTrigger
        $string3_WerTrigger_offensive_tool_keyword = "WerTrigger-master" nocase ascii wide

    condition:
        any of them
}


rule rule_wfuzz_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'wfuzz' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "wfuzz"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string1_wfuzz_offensive_tool_keyword = /\sadmin\-panels\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string2_wfuzz_offensive_tool_keyword = /\sAll_attack\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string3_wfuzz_offensive_tool_keyword = /\s\-c\s\-w\smethods\.txt\s\-p\s127\.0\.0\.1/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string4_wfuzz_offensive_tool_keyword = /\s\-c\s\-z\srange.{0,1000}1\-10\s\-\-hc\=BBB\shttp/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string5_wfuzz_offensive_tool_keyword = /\scommon_pass\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string6_wfuzz_offensive_tool_keyword = " FUZZ:FUZZ "
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string7_wfuzz_offensive_tool_keyword = " install wfuzz"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string8_wfuzz_offensive_tool_keyword = " -u FUZZ "
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string9_wfuzz_offensive_tool_keyword = /\s\-w\swordlist\/.{0,1000}\.txt.{0,1000}http/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string10_wfuzz_offensive_tool_keyword = /\sws\-dirs\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string11_wfuzz_offensive_tool_keyword = /\sws\-files\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string12_wfuzz_offensive_tool_keyword = " -X FUZZ http"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string13_wfuzz_offensive_tool_keyword = " -z burplog"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string14_wfuzz_offensive_tool_keyword = /\.\.\/\.\.\/\.\.\/\.\.\/\.\.\/\.\.\/etc\/passwd/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string15_wfuzz_offensive_tool_keyword = /\.\.\/\.\.\/\.\.\/\.\.\/\.\.\/\.\.\/etc\/shadow/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string16_wfuzz_offensive_tool_keyword = /\/\.\.\/\.\.\/\.\.\/\.\.\/\.\.\/boot\.ini/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string17_wfuzz_offensive_tool_keyword = /\/admin\-panels\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string18_wfuzz_offensive_tool_keyword = /\/All_attack\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string19_wfuzz_offensive_tool_keyword = /\/Injections\/SQL\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string20_wfuzz_offensive_tool_keyword = /\/sql_inj\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string21_wfuzz_offensive_tool_keyword = "/wfuzz "
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string22_wfuzz_offensive_tool_keyword = /\/ws\-dirs\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string23_wfuzz_offensive_tool_keyword = /\/ws\-files\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string24_wfuzz_offensive_tool_keyword = /\\admin\-panels\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string25_wfuzz_offensive_tool_keyword = /\\All_attack\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string26_wfuzz_offensive_tool_keyword = /\\common_pass\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string27_wfuzz_offensive_tool_keyword = /\\ws\-dirs\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string28_wfuzz_offensive_tool_keyword = /\\ws\-files\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string29_wfuzz_offensive_tool_keyword = /buffer_overflow\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string30_wfuzz_offensive_tool_keyword = /burp_log_.{0,1000}\.log/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string31_wfuzz_offensive_tool_keyword = /burpitem\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string32_wfuzz_offensive_tool_keyword = /burplog\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string33_wfuzz_offensive_tool_keyword = /burpstate\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string34_wfuzz_offensive_tool_keyword = /dirTraversal\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string35_wfuzz_offensive_tool_keyword = /dirTraversal\-nix\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string36_wfuzz_offensive_tool_keyword = /dirTraversal\-win\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string37_wfuzz_offensive_tool_keyword = /dirwalk\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string38_wfuzz_offensive_tool_keyword = /from\s\.core\simport\sFuzzer/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string39_wfuzz_offensive_tool_keyword = /from\s\.wfuzz\simport\s/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string40_wfuzz_offensive_tool_keyword = /fuzzfactory\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string41_wfuzz_offensive_tool_keyword = /fuzzrequest\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string42_wfuzz_offensive_tool_keyword = /http\:\/\/127\.0\.0\.1\/FUZZ/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string43_wfuzz_offensive_tool_keyword = /http\:\/\/wfuzz\.org/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string44_wfuzz_offensive_tool_keyword = /https\:\/\/wfuzz\.readthedocs\.io/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string45_wfuzz_offensive_tool_keyword = "import wfuzz"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string46_wfuzz_offensive_tool_keyword = /Injections\/Traversal\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string47_wfuzz_offensive_tool_keyword = /Injections\/XSS\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string48_wfuzz_offensive_tool_keyword = /shodanp\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string49_wfuzz_offensive_tool_keyword = "site-packages/wfuzz"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string50_wfuzz_offensive_tool_keyword = /subdomains\-top1million\-20000\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string51_wfuzz_offensive_tool_keyword = "uname=FUZZ&pass=FUZZ"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string52_wfuzz_offensive_tool_keyword = /vulns\/apache\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string53_wfuzz_offensive_tool_keyword = /vulns\/iis\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string54_wfuzz_offensive_tool_keyword = /vulns\/jrun\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string55_wfuzz_offensive_tool_keyword = /vulns\/tomcat\.txt/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string56_wfuzz_offensive_tool_keyword = /vulnweb\.com\/FUZZ/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string57_wfuzz_offensive_tool_keyword = "wfencode -"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string58_wfuzz_offensive_tool_keyword = "wfencode -e "
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string59_wfuzz_offensive_tool_keyword = /wfencode\.bat/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string60_wfuzz_offensive_tool_keyword = /wfencode\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string61_wfuzz_offensive_tool_keyword = "wfpayload -"
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string62_wfuzz_offensive_tool_keyword = /wfpayload\.bat/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string63_wfuzz_offensive_tool_keyword = /wfpayload\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string64_wfuzz_offensive_tool_keyword = /wfuzz\.bat/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string65_wfuzz_offensive_tool_keyword = /wfuzz\.get_payload/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string66_wfuzz_offensive_tool_keyword = /wfuzz\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string67_wfuzz_offensive_tool_keyword = /wfuzz\.wfuzz/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string68_wfuzz_offensive_tool_keyword = /wfuzz\-cli\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string69_wfuzz_offensive_tool_keyword = /wfuzzp\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string70_wfuzz_offensive_tool_keyword = /www\.wfuzz\.org/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string71_wfuzz_offensive_tool_keyword = /wxfuzz\.bat/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string72_wfuzz_offensive_tool_keyword = /wxfuzz\.py/
        // Description: Web application fuzzer.
        // Reference: https://github.com/xmendez/wfuzz
        $string73_wfuzz_offensive_tool_keyword = "xmendez/wfuzz"

    condition:
        any of them
}


rule rule_WhatBreach_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'WhatBreach' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "WhatBreach"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: WhatBreach is an OSINT tool that simplifies the task of discovering what breaches an email address has been discovered in. WhatBreach provides a simple and effective way to search either multiple. or a single email address and discover all known breaches that this email has been seen in. From there WhatBreach is capable of downloading the database if it is publicly available. downloading the pastes the email was seen in. or searching the domain of the email for further investigation. To perform this task successfully WhatBreach takes advantage of the following websites and/or APIs:
        // Reference: https://github.com/Ekultek/WhatBreach
        $string1_WhatBreach_offensive_tool_keyword = "WhatBreach" nocase ascii wide

    condition:
        any of them
}


rule rule_whatlicense_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'whatlicense' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "whatlicense"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string1_whatlicense_offensive_tool_keyword = /\.exe\s\-t\swl\-extract\.dll\s\-d\s.{0,1000}\.dat\s\-r\s.{0,1000}\.rsa\s\-.{0,1000}\.exe/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string2_whatlicense_offensive_tool_keyword = /\/whatlicense\.git/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string3_whatlicense_offensive_tool_keyword = /\\whatlicense\-main\\/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string4_whatlicense_offensive_tool_keyword = /\\wl_log\.txt/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string5_whatlicense_offensive_tool_keyword = /\\wl\-lic\.exe/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string6_whatlicense_offensive_tool_keyword = /\\wl\-lic\.pdb/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string7_whatlicense_offensive_tool_keyword = "639EF517-FCFC-408E-9500-71F0DC0458DB" nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string8_whatlicense_offensive_tool_keyword = "CC127443-2519-4E04-8865-A6887658CDE5" nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string9_whatlicense_offensive_tool_keyword = "charlesnathansmith/whatlicense" nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string10_whatlicense_offensive_tool_keyword = /whatlicense\-main\.zip/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string11_whatlicense_offensive_tool_keyword = /wl\-lic\s\-d\s.{0,1000}\.dat\s\-r\s.{0,1000}\.rsa/ nocase ascii wide
        // Description: WinLicense key extraction via Intel PIN
        // Reference: https://github.com/charlesnathansmith/whatlicense
        $string12_whatlicense_offensive_tool_keyword = /wl\-lic\s\-h\sHWID\s\-m\smain_hash\s\-d\sregkey2\.dat\s\-r\sregkey2\.rsa/ nocase ascii wide

    condition:
        any of them
}


rule rule_WheresMyImplant_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'WheresMyImplant' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "WheresMyImplant"
        rule_category = "offensive_tool_keyword"

