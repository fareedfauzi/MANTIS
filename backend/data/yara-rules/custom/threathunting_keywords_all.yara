rule rule_disctopia_c2_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'disctopia-c2' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "disctopia-c2"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string1_disctopia_c2_offensive_tool_keyword = /\/disctopia\.py/ nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string2_disctopia_c2_offensive_tool_keyword = "/disctopia-c2" nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string3_disctopia_c2_offensive_tool_keyword = "/distopia-test" nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string4_disctopia_c2_offensive_tool_keyword = "Disctopia Backdoor" nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string5_disctopia_c2_offensive_tool_keyword = /disctopia\-c2\.git/ nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string6_disctopia_c2_offensive_tool_keyword = /disctopia\-c2\-main\.zip/ nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string7_disctopia_c2_offensive_tool_keyword = /keylogger\.py/ nocase ascii wide
        // Description: Windows Remote Administration Tool that uses Discord Telegram and GitHub as C2s
        // Reference: https://github.com/3ct0s/disctopia-c2
        $string8_disctopia_c2_offensive_tool_keyword = /sandboxevasion\.py/ nocase ascii wide

    condition:
        any of them
}


rule rule_DiskCryptor_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'DiskCryptor' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "DiskCryptor"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: DiskCryptor is an open source encryption solution that offers encryption of all disk partitions including system partitions
        // Reference: https://github.com/DavidXanatos/DiskCryptor
        $string1_DiskCryptor_offensive_tool_keyword = /\/dcrypt\.exe/ nocase ascii wide
        // Description: DiskCryptor is an open source encryption solution that offers encryption of all disk partitions including system partitions
        // Reference: https://github.com/DavidXanatos/DiskCryptor
        $string2_DiskCryptor_offensive_tool_keyword = /\/dcrypt_setup\.exe/ nocase ascii wide
        // Description: DiskCryptor is an open source encryption solution that offers encryption of all disk partitions including system partitions
        // Reference: https://github.com/DavidXanatos/DiskCryptor
        $string3_DiskCryptor_offensive_tool_keyword = /\/DiskCryptor\.git/ nocase ascii wide
        // Description: DiskCryptor is an open source encryption solution that offers encryption of all disk partitions including system partitions
        // Reference: https://github.com/DavidXanatos/DiskCryptor
        $string4_DiskCryptor_offensive_tool_keyword = /\\dcrypt\.exe/ nocase ascii wide
