        $string1_getExploit_offensive_tool_keyword = /\.\/getExploit/
        // Description: Python script to explore exploits from exploit-db.com. Exist a similar script in Kali Linux. but in difference this python script will have provide more flexibility at search and download time.
        // Reference: https://github.com/Gioyik/getExploit
        $string2_getExploit_offensive_tool_keyword = /getExploit\.py/
