rule rule_Thread_Pool_Injection_PoC_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Thread-Pool-Injection-PoC' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Thread-Pool-Injection-PoC"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string1_Thread_Pool_Injection_PoC_offensive_tool_keyword = /\/Thread\-Pool\-Injection\-PoC\.git/ nocase ascii wide
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string2_Thread_Pool_Injection_PoC_offensive_tool_keyword = "1AFD1BA3-028A-4E0F-82A8-095F38694ECF" nocase ascii wide
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string3_Thread_Pool_Injection_PoC_offensive_tool_keyword = "Modify the TP_POOL linked list Flinks and Blinks to point to the malicious task" nocase ascii wide
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string4_Thread_Pool_Injection_PoC_offensive_tool_keyword = /MY_MESSAGE\s\\"I\sdid\sit\sfor\sthe\svine\.\\"/ nocase ascii wide
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string5_Thread_Pool_Injection_PoC_offensive_tool_keyword = /ThreadPoolInjection\.lastbuildstate/ nocase ascii wide
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string6_Thread_Pool_Injection_PoC_offensive_tool_keyword = "Thread-Pool-Injection-PoC-main" nocase ascii wide
        // Description: Proof of concept code for thread pool based process injection in Windows.
        // Reference: https://github.com/Uri3n/Thread-Pool-Injection-PoC
        $string7_Thread_Pool_Injection_PoC_offensive_tool_keyword = "Uri3n/Thread-Pool-Injection-PoC" nocase ascii wide

    condition:
        any of them
}


rule rule_ThreadlessInject_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ThreadlessInject' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ThreadlessInject"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string1_ThreadlessInject_offensive_tool_keyword = /\s\-p\s.{0,1000}\s\-d\s.{0,1000}\.dll\s\-e\sOpenProcess/ nocase ascii wide
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string2_ThreadlessInject_offensive_tool_keyword = /\/ThreadlessInject\.git/ nocase ascii wide
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string3_ThreadlessInject_offensive_tool_keyword = "CCob/ThreadlessInject" nocase ascii wide
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string4_ThreadlessInject_offensive_tool_keyword = /Needles\swithout\sthe\sThread\.pptx/ nocase ascii wide
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string5_ThreadlessInject_offensive_tool_keyword = /ThreadlessInject.{0,1000}\s\-p\s.{0,1000}\s\-d\s/ nocase ascii wide
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string6_ThreadlessInject_offensive_tool_keyword = /ThreadlessInject\.exe/ nocase ascii wide
        // Description: Threadless Process Injection using remote function hooking.
        // Reference: https://github.com/CCob/ThreadlessInject
        $string7_ThreadlessInject_offensive_tool_keyword = "ThreadlessInject-master" nocase ascii wide

    condition:
        any of them
}


rule rule_ThreatCheck_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'ThreatCheck' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "ThreatCheck"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Identifies the bytes that Microsoft Defender / AMSI Consumer flags on
        // Reference: https://github.com/rasta-mouse/ThreatCheck
        $string1_ThreatCheck_offensive_tool_keyword = /\s\-f\s.{0,1000}\.bin\s\-e\sAMSI/ nocase ascii wide
        // Description: Identifies the bytes that Microsoft Defender / AMSI Consumer flags on
        // Reference: https://github.com/rasta-mouse/ThreatCheck
        $string2_ThreatCheck_offensive_tool_keyword = /\s\-f\s.{0,1000}\.bin\s\-e\sDefender/ nocase ascii wide
        // Description: Identifies the bytes that Microsoft Defender / AMSI Consumer flags on
        // Reference: https://github.com/rasta-mouse/ThreatCheck
