rule rule_bruteratel_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'bruteratel' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "bruteratel"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: A Customized Command and Control Center for Red Team and Adversary Simulation
        // Reference: https://bruteratel.com/
        $string1_bruteratel_offensive_tool_keyword = /\sadaptiveC2\.py/ nocase ascii wide
        // Description: A Customized Command and Control Center for Red Team and Adversary Simulation
        // Reference: https://bruteratel.com/
        $string2_bruteratel_offensive_tool_keyword = /\sgetprivs\.c\s/ nocase ascii wide
        // Description: A Customized Command and Control Center for Red Team and Adversary Simulation
        // Reference: https://bruteratel.com/
        $string3_bruteratel_offensive_tool_keyword = /\sgetprivs\.o\s/ nocase ascii wide
        // Description: A Customized Command and Control Center for Red Team and Adversary Simulation
        // Reference: https://bruteratel.com/
        $string4_bruteratel_offensive_tool_keyword = " -ratel " nocase ascii wide
        // Description: A Customized Command and Control Center for Red Team and Adversary Simulation
        // Reference: https://bruteratel.com/
        $string5_bruteratel_offensive_tool_keyword = " Starting Adaptive C2 Server on " nocase ascii wide
