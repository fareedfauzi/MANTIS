        // Description: Parallelized login cracker which supports numerous protocols to attack.
        // Reference: https://github.com/vanhauser-thc/thc-hydra
        $string7_thc_hydra_offensive_tool_keyword = /common_passwords\.txt/
        // Description: Parallelized login cracker which supports numerous protocols to attack.
