        // Reference: https://github.com/Frissi0n/GTFONow
        $string33_GTFONow_offensive_tool_keyword = "ssh-keygen not found in PATH, cannot escalate using SSH key" nocase ascii wide
        // Description: Automatic privilege escalation for misconfigured capabilities - sudo and suid binaries using GTFOBins.
        // Reference: https://github.com/Frissi0n/GTFONow
        $string34_GTFONow_offensive_tool_keyword = "Thanks for using GTFONow!" nocase ascii wide

    condition:
        any of them
}


rule rule_gTunnel_offensive_tool_keyword
{
    meta:
