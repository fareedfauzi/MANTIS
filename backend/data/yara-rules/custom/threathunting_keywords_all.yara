        // Reference: https://github.com/tokyoneon/Chimera/
        $string23_chimera_offensive_tool_keyword = /powershell_reverse_shell\.ps1/ nocase ascii wide
        // Description: Chimera is a PowerShell obfuscation script designed to bypass AMSI and commercial antivirus solutions.
        // Reference: https://github.com/tokyoneon/Chimera/
        $string24_chimera_offensive_tool_keyword = "tokyoneon/Chimera" nocase ascii wide

    condition:
        any of them
}


