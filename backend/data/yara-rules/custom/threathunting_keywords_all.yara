        $string1_Net_GPPPassword_offensive_tool_keyword = /\/Net\-GPPPassword\.git/ nocase ascii wide
        // Description: .NET implementation of Get-GPPPassword. Retrieves the plaintext password and other information for accounts pushed through Group Policy Preferences.
        // Reference: https://github.com/outflanknl/Net-GPPPassword
        $string2_Net_GPPPassword_offensive_tool_keyword = /Net\-GPPPassword\.cs/ nocase ascii wide
        // Description: .NET implementation of Get-GPPPassword. Retrieves the plaintext password and other information for accounts pushed through Group Policy Preferences.
        // Reference: https://github.com/outflanknl/Net-GPPPassword
        $string3_Net_GPPPassword_offensive_tool_keyword = /Net\-GPPPassword\.exe/ nocase ascii wide
        // Description: .NET implementation of Get-GPPPassword. Retrieves the plaintext password and other information for accounts pushed through Group Policy Preferences.
        // Reference: https://github.com/outflanknl/Net-GPPPassword
        $string4_Net_GPPPassword_offensive_tool_keyword = "Net-GPPPassword_dotNET" nocase ascii wide
        // Description: .NET implementation of Get-GPPPassword. Retrieves the plaintext password and other information for accounts pushed through Group Policy Preferences.
        // Reference: https://github.com/outflanknl/Net-GPPPassword
        $string5_Net_GPPPassword_offensive_tool_keyword = "Net-GPPPassword-master" nocase ascii wide
        // Description: .NET implementation of Get-GPPPassword. Retrieves the plaintext password and other information for accounts pushed through Group Policy Preferences.
        // Reference: https://github.com/outflanknl/Net-GPPPassword
        $string6_Net_GPPPassword_offensive_tool_keyword = "outflanknl/Net-GPPPassword" nocase ascii wide

    condition:
        any of them
}


rule rule_net_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'net' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "net"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Conti Ransomware Proxyshell PowerShell command #9
        // Reference: https://news.sophos.com/en-us/2021/09/03/conti-affiliates-use-proxyshell-exchange-exploit-in-ransomware-attacks/
        $string1_net_offensive_tool_keyword = /net\sgroup\s.{0,1000}domain\sadmins.{0,1000}\s\/domain/ nocase ascii wide

    condition:
        any of them
}


rule rule_Netexec_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Netexec' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Netexec"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: NetExec (a.k.a nxc) is a post-exploitation tool that helps automate assessing the security of large Active Directory networks.
        // Reference: https://github.com/Pennyw0rth/NetExec
        $string1_Netexec_offensive_tool_keyword = /C\:\\Windows\\Temp\\[a-zA-Z0-9]{8}.tmp/ nocase ascii wide

    condition:
        any of them
}


rule rule_netkit_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'netkit' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "netkit"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string1_netkit_offensive_tool_keyword = /\/netkit\.git/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string2_netkit_offensive_tool_keyword = /\/netkit\/client\/shell\.py/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string3_netkit_offensive_tool_keyword = /\/netkit\/src\/netkit\./ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string4_netkit_offensive_tool_keyword = /\[\+\]\ssuccessfully\sself\sdestructed\sserver/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string5_netkit_offensive_tool_keyword = /\\netkit\\client\\shell\.py/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string6_netkit_offensive_tool_keyword = /\\netkit\\src\\netkit\./ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string7_netkit_offensive_tool_keyword = "8dece0ec5b60725419e384b317c5be3c15d3cc12c1c7da28a53ec344118f9cd9" nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string8_netkit_offensive_tool_keyword = "CONFIG_NETKIT_DEBUG" nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string9_netkit_offensive_tool_keyword = /ls\s\-la\snetkit\.ko/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string10_netkit_offensive_tool_keyword = /NETKIT_LOG\(\\"/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string11_netkit_offensive_tool_keyword = /NETKIT_XOR\\x00/ nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string12_netkit_offensive_tool_keyword = "Notselwyn/netkit" nocase ascii wide
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string13_netkit_offensive_tool_keyword = /run_kmod\.sh\snetkit\.ko\snetkit/
        // Description: Netkit is a purposefully small rootkit which can be used by clients over network to maintain a sneaky foothold into a device.
        // Reference: https://github.com/Notselwyn/netkit
        $string14_netkit_offensive_tool_keyword = /run_python\.sh\sclient\/shell\.py/

    condition:
        any of them
}


rule rule_NetLoader_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'NetLoader' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "NetLoader"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string1_NetLoader_offensive_tool_keyword = /\.exe\s\s\-\-b64\s\-\-path\s.{0,1000}\s\-\-args\s/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string2_NetLoader_offensive_tool_keyword = /\/NetLoader\.git/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string3_NetLoader_offensive_tool_keyword = /\\NetLoader\.exe/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string4_NetLoader_offensive_tool_keyword = /csc\.exe\s\/t\:exe\s\/out\:RandomName\.exe\sProgram\.cs/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string5_NetLoader_offensive_tool_keyword = "d2hvYW1p" nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string6_NetLoader_offensive_tool_keyword = "Flangvik/NetLoader" nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string7_NetLoader_offensive_tool_keyword = /LOLBins\/NetLoader\.xml/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string8_NetLoader_offensive_tool_keyword = /MSBuild\.exe\sNetLoader\.xml/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string9_NetLoader_offensive_tool_keyword = /NetLoader\.exe\s\-\-path\s.{0,1000}\.exe\s/ nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string10_NetLoader_offensive_tool_keyword = "NetLoader-master" nocase ascii wide
        // Description: Loads any C# binary in memory - patching AMSI + ETW
        // Reference: https://github.com/Flangvik/NetLoader
        $string11_NetLoader_offensive_tool_keyword = "U2VhdGJlbHQuZXhl" nocase ascii wide

    condition:
        any of them
}


