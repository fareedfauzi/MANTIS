        $string15_CLR_Injection_offensive_tool_keyword = /REG\.EXE\sADD\s.{0,1000}\s\/VE\s\/T\sREG_SZ\s\/D\s.{0,1000}\\msg\.dll/ nocase ascii wide
        // Description: Use CLR to inject all the .NET apps
