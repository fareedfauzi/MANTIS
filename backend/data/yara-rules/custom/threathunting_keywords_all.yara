rule rule_susinternals_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'susinternals' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "susinternals"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string1_susinternals_offensive_tool_keyword = /\spsexecsvc\.py/ nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string2_susinternals_offensive_tool_keyword = /PSEXECSVC19\=b64decode\(/ nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string3_susinternals_offensive_tool_keyword = /\/psexecsvc\.py/ nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string4_susinternals_offensive_tool_keyword = /\\psexecsvc\.py/ nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string5_susinternals_offensive_tool_keyword = "fcb2f607771f185531790722ac8e3a924146186bbd3d9e03a7a793545772bdf2" nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string6_susinternals_offensive_tool_keyword = "PSExecSVC remote orchestrator" nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string7_susinternals_offensive_tool_keyword = "Received version from PSEXECSVC: " nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string8_susinternals_offensive_tool_keyword = "Sending init packet to PSEXECSVC" nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string9_susinternals_offensive_tool_keyword = "Sending PSExecSVC version 190 " nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string10_susinternals_offensive_tool_keyword = "sensepost/susinternals" nocase ascii wide
        // Description: python implementation of PSExec native service implementation
        // Reference: https://github.com/sensepost/susinternals
        $string11_susinternals_offensive_tool_keyword = "" nocase ascii wide

    condition:
        any of them
}


rule rule_SwampThing_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SwampThing' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SwampThing"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string1_SwampThing_offensive_tool_keyword = " -FakeCmdLine " nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string2_SwampThing_offensive_tool_keyword = " -RealCmdLine " nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string3_SwampThing_offensive_tool_keyword = /\\SpoofCmdLine\\TheThing/ nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string4_SwampThing_offensive_tool_keyword = /\\SwampThing\.csproj/ nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string5_SwampThing_offensive_tool_keyword = /\\TheThing\.exe/ nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string6_SwampThing_offensive_tool_keyword = "master/SwampThing" nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string7_SwampThing_offensive_tool_keyword = /SwampThing\.exe/ nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string8_SwampThing_offensive_tool_keyword = /SwampThing\.pdb/ nocase ascii wide
        // Description: SwampThing lets you to spoof process command line args (x32/64). Essentially you create a process in a suspended state - rewrite the PEB - resume and finally revert the PEB. The end result is that logging infrastructure will record the fake command line args instead of the real ones
        // Reference: https://github.com/FuzzySecurity/Sharp-Suite/tree/master/SwampThing
        $string9_SwampThing_offensive_tool_keyword = /SwampThing\.sln/ nocase ascii wide

    condition:
        any of them
}


rule rule_SweetPotato_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'SweetPotato' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "SweetPotato"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string1_SweetPotato_offensive_tool_keyword = " --exploit=DCOM" nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string2_SweetPotato_offensive_tool_keyword = " --exploit=DCOM" nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string3_SweetPotato_offensive_tool_keyword = " --exploit=EfsRpc" nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string4_SweetPotato_offensive_tool_keyword = " --exploit=PrintSpoofer" nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string5_SweetPotato_offensive_tool_keyword = " --exploit=WinRM" nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string6_SweetPotato_offensive_tool_keyword = /\sSweetpotato\.exe/ nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string7_SweetPotato_offensive_tool_keyword = /\/Sweetpotato\.exe/ nocase ascii wide
        // Description: Local Service to SYSTEM privilege escalation from Windows 7 to Windows 10 / Server 2019
        // Reference: https://github.com/CCob/SweetPotato
        $string8_SweetPotato_offensive_tool_keyword = /\/SweetPotato\.git/ nocase ascii wide
