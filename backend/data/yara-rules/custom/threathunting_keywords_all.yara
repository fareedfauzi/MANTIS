rule rule_unlink_greyware_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'unlink' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
