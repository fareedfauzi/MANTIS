rule rule_metagoofil_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'metagoofil' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "metagoofil"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Metagoofil is a tool for extracting metadata of public documents (pdf.doc.xls.ppt..etc) availables in the target websites.This information could be useful because you can get valid usernames. people names. for using later in bruteforce password attacks (vpn. ftp. webapps). the tool will also extracts interesting paths of the documents. where we can get shared resources names. server names... etc.
        // Reference: https://github.com/laramies/metagoofi
        $string1_metagoofil_offensive_tool_keyword = "metagoofil" nocase ascii wide

    condition:
        any of them
}


rule rule_metame_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'metame' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "metame"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: metame is a metamorphic code engine for arbitrary executables
        // Reference: https://github.com/a0rtega/metame
        $string1_metame_offensive_tool_keyword = "a0rtega/metame" nocase ascii wide
        // Description: metame is a metamorphic code engine for arbitrary executables
        // Reference: https://github.com/a0rtega/metame
        $string2_metame_offensive_tool_keyword = "import metame" nocase ascii wide
        // Description: metame is a metamorphic code engine for arbitrary executables
        // Reference: https://github.com/a0rtega/metame
        $string3_metame_offensive_tool_keyword = /metame\s\-i\s.{0,1000}\.exe/ nocase ascii wide

    condition:
        any of them
}


