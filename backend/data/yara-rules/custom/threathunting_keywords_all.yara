        // Description: A tiny Reverse Sock5 Proxy
        // Reference: https://github.com/Coldzer0/ReverseSock5Proxy
        $string9_ReverseSock5Proxy_offensive_tool_keyword = "Application::C2Sock" nocase ascii wide
