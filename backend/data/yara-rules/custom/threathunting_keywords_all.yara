        $string14_CLR_Injection_offensive_tool_keyword = /REG\.EXE\sADD\s.{0,1000}\s\/V\sThreadingModel\s\/T\sREG_SZ\s\/D\sApartment\s\/F/ nocase ascii wide
        // Description: Use CLR to inject all the .NET apps
