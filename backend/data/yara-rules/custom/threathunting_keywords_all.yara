        $string10_SharpSQL_offensive_tool_keyword = /\.exe\sInvoke\-OSCmd\s\-Instance\s.{0,1000}\s\-Command\s/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
