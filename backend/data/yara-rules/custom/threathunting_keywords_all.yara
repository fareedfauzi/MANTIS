rule rule_Psnmap_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Psnmap' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Psnmap"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string1_Psnmap_offensive_tool_keyword = /\sPSnmap\.ps1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string2_Psnmap_offensive_tool_keyword = /\/PSnmap\.git/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string3_Psnmap_offensive_tool_keyword = /\/PSnmap\.ps1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string4_Psnmap_offensive_tool_keyword = /\/PSnmap\.psd1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string5_Psnmap_offensive_tool_keyword = /\/PSnmap\.psm1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string6_Psnmap_offensive_tool_keyword = /\\PSnmap\.ps1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string7_Psnmap_offensive_tool_keyword = /\\PSnmap\.psd1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string8_Psnmap_offensive_tool_keyword = /\\PSnmap\.psm1/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string9_Psnmap_offensive_tool_keyword = "5e60bc27d24e7a5b641fa59ee55002dae44ce9dde494df9783a9aa002455c6d2" nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string10_Psnmap_offensive_tool_keyword = /Add\-Member\s\-MemberType\sNoteProperty\s\-Name\sPing\s\-Value\s\(Test\-Connection\s\-ComputerName\s.{0,1000}\s\-Quiet\s\-Count\s1\)\s\-Force/ nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string11_Psnmap_offensive_tool_keyword = "ba20280d3b1e1ba3539232ee1b32c6071958811da1cb6716aeb33480977da408" nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string12_Psnmap_offensive_tool_keyword = "be09f42e9225e82fe619a700b93d33e3bf0603266b7865d45a786630d4303aa7" nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string13_Psnmap_offensive_tool_keyword = "EliteLoser/PSnmap" nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string14_Psnmap_offensive_tool_keyword = "Install-Module -Name PSnmap -Scope " nocase ascii wide
        // Description: Powershell scanner (nmap like)
        // Reference: https://github.com/KurtDeGreeff/PlayPowershell/blob/master/PSnmap.ps1
        $string15_Psnmap_offensive_tool_keyword = "Invoke-Psnmap" nocase ascii wide

    condition:
        any of them
}


rule rule_psobf_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'psobf' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "psobf"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: PowerShell Obfuscator
        // Reference: https://github.com/TaurusOmar/psobf
        $string1_psobf_offensive_tool_keyword = /\.\/obfuscator\s\-i\s.{0,1000}\.ps1/
        // Description: PowerShell Obfuscator
        // Reference: https://github.com/TaurusOmar/psobf
        $string2_psobf_offensive_tool_keyword = /\/psobf\.git/ nocase ascii wide
        // Description: PowerShell Obfuscator
        // Reference: https://github.com/TaurusOmar/psobf
        $string3_psobf_offensive_tool_keyword = "f3b1f6c6ca346acab1afd2dc61c43588f4c0914c1a6d1247db3a46bbd3421b38" nocase ascii wide
        // Description: PowerShell Obfuscator
        // Reference: https://github.com/TaurusOmar/psobf
        $string4_psobf_offensive_tool_keyword = /Invoke\-Expression\s\$obfuscated/ nocase ascii wide
        // Description: PowerShell Obfuscator
        // Reference: https://github.com/TaurusOmar/psobf
        $string5_psobf_offensive_tool_keyword = "TaurusOmar/psobf" nocase ascii wide

    condition:
        any of them
}


rule rule_Pspersist_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'Pspersist' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "Pspersist"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string1_Pspersist_offensive_tool_keyword = /\/PSpersist\.git/ nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string2_Pspersist_offensive_tool_keyword = /\\PSprofile\.exe/ nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string3_Pspersist_offensive_tool_keyword = "436b7f540f534a0ec1337cf82a76cb7727acda423132195f0c81560cdf75c438" nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string4_Pspersist_offensive_tool_keyword = "58482e19d6376bbe0120289b6d39a35de15b68d00713f821ab0c7f28f85a31ee" nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string5_Pspersist_offensive_tool_keyword = "5A403F3C-9136-4B67-A94E-02D3BCD3162D" nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string6_Pspersist_offensive_tool_keyword = "Pspersist-main" nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string7_Pspersist_offensive_tool_keyword = /PSprofile\.cpp/ nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string8_Pspersist_offensive_tool_keyword = /Start\sMenu\\Programs\\Startup\\Loader\.exe/ nocase ascii wide
        // Description: Dropping a powershell script at %HOMEPATH%\Documents\windowspowershell\ that contains the implant's path and whenever powershell process is created the implant will executed too.
        // Reference: https://github.com/TheD1rkMtr/Pspersist
        $string9_Pspersist_offensive_tool_keyword = "TheD1rkMtr/Pspersist" nocase ascii wide

    condition:
        any of them
}


rule rule_pspy_offensive_tool_keyword
