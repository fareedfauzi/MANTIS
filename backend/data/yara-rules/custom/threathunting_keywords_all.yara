        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string8_precompiled_binaries_offensive_tool_keyword = /\sPowerUpSQL\.ps1/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string9_precompiled_binaries_offensive_tool_keyword = " to retrieve secrets from machines that were previously SCCM clients" nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string10_precompiled_binaries_offensive_tool_keyword = /\.exe\s\-\-Action\sGetGPLink\s\-\-/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string11_precompiled_binaries_offensive_tool_keyword = /\.exe\s\-\-Action\sGetGPO\s\-\-/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string12_precompiled_binaries_offensive_tool_keyword = /\.exe\s\-\-Action\sMoveObject\s\-\-/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
        $string13_precompiled_binaries_offensive_tool_keyword = /\.exe\s\-\-Action\sNewGPLink\s\-\-DN\s/ nocase ascii wide
        // Description: executables for penetration testing Windows Active Directory environments
        // Reference: https://github.com/jakobfriedl/precompiled-binaries
