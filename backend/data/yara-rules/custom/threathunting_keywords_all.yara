{
    meta:
        description = "Detection patterns for the tool 'phuip-fpizdam' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "phuip-fpizdam"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: This is an exploit for a bug in php-fpm (CVE-2019-11043). In certain nginx + php-fpm configurations. the bug is possible to trigger from the outside. This means that a web user may get code execution if you have vulnerable config (see below).
        // Reference: https://github.com/neex/phuip-fpizdam
        $string1_phuip_fpizdam_offensive_tool_keyword = "phuip-fpizdam" nocase ascii wide

    condition:
        any of them
}


rule rule_physmem2profit_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'physmem2profit' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "physmem2profit"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string1_physmem2profit_offensive_tool_keyword = /\sphysmem2minidump\.py/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string2_physmem2profit_offensive_tool_keyword = /\/label\-date\-lsass\.dmp/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string3_physmem2profit_offensive_tool_keyword = /\/physmem2minidump\.py/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string4_physmem2profit_offensive_tool_keyword = /\/physmem2profit\.git/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string5_physmem2profit_offensive_tool_keyword = /\\physmem2minidump\.py/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string6_physmem2profit_offensive_tool_keyword = /\\physmem2profit\-master/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string7_physmem2profit_offensive_tool_keyword = ">physmem2profit<" nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string8_physmem2profit_offensive_tool_keyword = "23ecca2af6db4c425ab534b9a738f7ec152c7fcf3c250f3ce9d7f57e6259eac9" nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string9_physmem2profit_offensive_tool_keyword = "814708C9-2320-42D2-A45F-31E42DA06A94" nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string10_physmem2profit_offensive_tool_keyword = "cc24850f03dccbd8ee3a372b06b2a77a95e5314bb68d2483b1814935978b7003" nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string11_physmem2profit_offensive_tool_keyword = "MimikatzStream should be at offset " nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string12_physmem2profit_offensive_tool_keyword = /output.{0,1000}\-lsass\.dmp/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string13_physmem2profit_offensive_tool_keyword = /physmem2profit\.exe/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string14_physmem2profit_offensive_tool_keyword = /Physmem2profit\.sln/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string15_physmem2profit_offensive_tool_keyword = /physmem2profit\-public\.zip/ nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string16_physmem2profit_offensive_tool_keyword = "source physmem2profit" nocase ascii wide
        // Description: Physmem2profit can be used to create a minidump of a target hosts' LSASS process by analysing physical memory remotely
        // Reference: https://github.com/WithSecureLabs/physmem2profit
        $string17_physmem2profit_offensive_tool_keyword = "WithSecureLabs/physmem2profit" nocase ascii wide

    condition:
        any of them
}


rule rule_PickleC2_offensive_tool_keyword
{
    meta:
        description = "Detection patterns for the tool 'PickleC2' taken from the ThreatHunting-Keywords github project"
        author = "@mthcht"
        reference = "https://github.com/mthcht/ThreatHunting-Keywords"
        tool = "PickleC2"
        rule_category = "offensive_tool_keyword"

    strings:
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string1_PickleC2_offensive_tool_keyword = /\/PickleC2\.git/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string2_PickleC2_offensive_tool_keyword = /\\Implants\\powershell\.ps1/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string3_PickleC2_offensive_tool_keyword = /\\PickleC2\\Core\\.{0,1000}\.py/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string4_PickleC2_offensive_tool_keyword = /\\PowerUp\.ps1/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string5_PickleC2_offensive_tool_keyword = /data\/implant\/.{0,1000}\/host\.ps1/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string6_PickleC2_offensive_tool_keyword = "Find-PathDLLHijack" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string7_PickleC2_offensive_tool_keyword = "Find-ProcessDLLHijack" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string8_PickleC2_offensive_tool_keyword = /http\:\/\/.{0,1000}\:.{0,1000}\/down\/.{0,1000}\/host\.ps1/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string9_PickleC2_offensive_tool_keyword = "" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string10_PickleC2_offensive_tool_keyword = /Implants\/powershell\.ps1/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string11_PickleC2_offensive_tool_keyword = "Invoke-EventVwrBypass" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string12_PickleC2_offensive_tool_keyword = "Invoke-PrivescAudit " nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string13_PickleC2_offensive_tool_keyword = "Invoke-ServiceAbuse" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string14_PickleC2_offensive_tool_keyword = "module powerup" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string15_PickleC2_offensive_tool_keyword = "PickleC2-main" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string16_PickleC2_offensive_tool_keyword = /UACBypassTest\.txt/ nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string17_PickleC2_offensive_tool_keyword = "Write-HijackDll" nocase ascii wide
        // Description: PickleC2 is a post-exploitation and Lateral Movements framework
        // Reference: https://github.com/xRET2pwn/PickleC2
        $string18_PickleC2_offensive_tool_keyword = "xRET2pwn/PickleC2" nocase ascii wide

    condition:
        any of them
}


